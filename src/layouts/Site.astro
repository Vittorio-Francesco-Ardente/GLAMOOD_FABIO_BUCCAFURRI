---
// Shared page shell: intro (once per session), header + menu + phone tab bar, footer, motion engine.
import Base from './Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageTransition from '../components/PageTransition.astro';
interface Props { title?: string; description?: string; path?: string; jsonld?: boolean; top?: string; tone?: 'light' | 'dark' }
const { title, description, path = '/', jsonld = false, top, tone = 'dark' } = Astro.props;
---
<Base title={title} description={description} path={path} jsonld={jsonld}>
  <slot name="head" slot="head" />
  <a class="skip-link" href="#main">Salta al contenuto</a>
  <PageTransition />
  <Loader />
  <div class:list={["site-header", path === "/prodotti" && "site-header-products"]}><Header tone={tone} /></div>
  <main id="main" class:list={[top && 'page-top']} style={top ? `--top-bg:${top}` : undefined}>
    <slot />
  </main>
  <Footer />
</Base>
<script>
import { startMotion, ScrollTrigger } from '../scripts/motion.js';
startMotion();
// performance: CSS animations of off-screen blocks are paused, resumed as they approach the viewport
const sleepIO = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('anim-off', !e.isIntersecting)), { rootMargin: '200px 0px' });
document.querySelectorAll('main section, main .page-frame, footer, .build, .cut-wrap').forEach((el) => sleepIO.observe(el));
document.fonts.ready.then(() => ScrollTrigger.refresh());
addEventListener('load', () => ScrollTrigger.refresh());
</script>
