---
import Site from '../layouts/Site.astro';
import Hero from '../components/Hero.astro';
import Salone from '../components/Salone.astro';
import Fasce from '../components/Fasce.astro';
import Esplora from '../components/Esplora.astro';
import Social from '../components/Social.astro';
import Gioco from '../components/Gioco.astro';
---
<Site jsonld>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset="/img/v2/hero/fabio/fabio-foto-maglia-480.avif 480w, /img/v2/hero/fabio/fabio-foto-maglia-960.avif 960w, /img/v2/hero/fabio/fabio-foto-maglia-1600.avif 1600w, /img/v2/hero/fabio/fabio-foto-maglia-1800.avif 1800w" imagesizes="(min-width:1200px) 66svh, (min-width:768px) 48svh, 45svh" fetchpriority="high" />
  <Hero />
  <Salone homeMobile />
  <Fasce />
  <Esplora />
  <Social />
  <Gioco />
</Site>
