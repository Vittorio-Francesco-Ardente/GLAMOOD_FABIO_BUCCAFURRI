---
// Kit 09: VHS-shelf carousel (Vasari reference). Real textured sleeves (generated from the ASSET-GEN zips)
// stand spine-out on a petrol ledge; the active one turns in 3D to show its cover. Drag, arrows, wheel,
// keyboard; the caption slides through a mask; the cover opens into a full-screen sheet with WhatsApp booking.
import { CUTS, LAB } from '../data/haircuts';
import { wa, waText } from '../data/business';
const data = JSON.stringify({ CUTS, LAB, wa: wa('__X__') });
---
<div class="sx-tagli">
<section class="tagli" id="tagli" aria-roledescription="carosello" aria-labelledby="tagli-t">
  <div class="head"><h2 class="giant-title" id="tagli-t">Scegli il tu<span>o</span></h2><p class="hint">Trascina per sfogliare, tocca la cassetta per aprirla</p></div>
  <div class="shelf" id="shelf" tabindex="0" aria-label="Scaffale dei tagli. Trascina o usa le frecce della tastiera per scorrere, Invio per aprire"><i class="probe" id="probe"></i><div class="stage" id="tg-stage"></div><div class="ledge"></div></div>
  <div class="cap sr-only" aria-live="polite"><h3 class="m" id="cn"></h3><p class="m" id="cd"></p></div>
  <noscript><ul class="nojs">{CUTS.map((c) => <li><b>{c[0]}</b> · {c[3]} · {c[2]}</li>)}</ul></noscript>
</section>
<div class="cur" id="tg-cur" aria-hidden="true"><i></i><b></b><em>APRI</em></div>
<div class="sheet" id="tg-sheet" role="dialog" aria-modal="true" aria-labelledby="sh-t" data-lenis-prevent tabindex="-1" hidden>
  <button class="x" id="sx" aria-label="Chiudi"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  <div class="in"><div class="big" id="sbig"><img id="simg" alt="" decoding="async" /><span class="photo-note" id="photo-state" role="status" aria-live="polite" hidden>Caricamento foto…</span></div>
  <div><p class="kicker">Taglio</p><h2 id="sh-t"></h2><p class="lead" id="sdesc" style="margin-top:16px"></p>
    <div class="facts"><div><b id="spr"></b>prezzo</div><div><b>1:1</b>consulenza</div><div><b>WA</b>prenoti</div></div>
    <p><b>A chi sta bene:</b> <span id="ssuit"></span></p><p style="margin-top:8px"><b>Come mantenerlo:</b> <span id="scare"></span></p>
    <div class="sticky"><a class="btn btn-primary" id="sbook" href={wa(waText.generic)} target="_blank" rel="noopener">Prenota questo taglio</a></div></div></div>
</div>
</div>
<script type="application/json" id="tagli-data" set:html={data}></script>

<style is:global>
.sx-tagli{display:contents;
.tagli{position:relative;min-height:0;background:var(--cream);overflow:hidden;padding:clamp(60px,8vw,110px) 0 clamp(50px,6vw,90px);isolation:isolate;--ease:cubic-bezier(.2,.8,.2,1)}
.tagli::before{content:"";position:absolute;inset:0;z-index:-1;background:url("/img/pattern/ref/liquido-crema.webp") center/cover}
.head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px 40px;padding:0 var(--gutter)}
.head .giant-title{font-size:clamp(44px,10.5vw,200px);color:var(--petrol);margin-bottom:0}
@media (max-width:767px){.head .giant-title{white-space:normal;line-height:.86}}
.head .giant-title span{color:transparent;-webkit-text-stroke:.02em var(--petrol)}
.head .hint{font:800 clamp(14px,1.3vw,18px)/1.2 var(--f-display);text-transform:uppercase;letter-spacing:.06em;color:var(--petrol);transform:rotate(-3deg);margin-bottom:1.4em}
.tagli{--H:min(46vh,31vw);--ws:calc(var(--H)*.1355);--d:calc(var(--H)*.52);--ledge:clamp(20px,2.4vw,30px)}
@media (max-width:767px){.tagli{--H:min(92vw,50svh)}}
.shelf{position:relative;height:calc(70px + var(--H) + var(--ledge));margin-top:clamp(20px,4vh,50px);perspective:2200px;perspective-origin:50% 50%;touch-action:pan-y;user-select:none;-webkit-user-select:none;outline:none}
.shelf:focus-visible{outline:2px solid currentColor;outline-offset:-6px}
@media (pointer:fine){.shelf{cursor:none}}
.stage{position:absolute;left:50%;top:calc(70px + var(--H)/2);width:0;height:0;-webkit-transform-style:preserve-3d;transform-style:preserve-3d}
.tape{position:absolute;left:0;top:0;width:0;height:0;-webkit-transform-style:preserve-3d;transform-style:preserve-3d;will-change:transform}
.face{position:absolute;top:calc(var(--H)/-2);height:var(--H);backface-visibility:hidden;-webkit-backface-visibility:hidden;background:var(--tex) center/100% 100% no-repeat}
.face::before,.face::after{content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit}
.face::before{background:#000;opacity:var(--shade,0);z-index:5;will-change:opacity}
.face::after{background:linear-gradient(115deg,rgb(255 255 255 / .12),transparent 30%,transparent 70%,rgb(0 0 0 / .12))}
.sp{width:calc(var(--H)*var(--sar));left:calc(var(--H)*var(--sar)/-2);transform:translateZ(calc(var(--H)*var(--ar)/2))}
.cv{width:calc(var(--H)*var(--ar));left:calc(var(--H)*var(--ar)/-2);transform:rotateY(90deg) translateZ(calc(var(--H)*var(--sar)/2))}
.lt{width:calc(var(--H)*var(--ar));left:calc(var(--H)*var(--ar)/-2);transform:rotateY(-90deg) translateZ(calc(var(--H)*var(--sar)/2))}
.lb{position:absolute;display:grid;place-items:center;overflow:hidden;font-family:var(--f-display);font-weight:900;text-transform:uppercase;color:#0F6870;line-height:.95;white-space:pre;text-align:center;letter-spacing:.01em;z-index:1}
.lb>span{display:block;font-size:calc(var(--H)*var(--k,.03))}
.lb.s>span{writing-mode:vertical-rl;transform:rotate(180deg);letter-spacing:.03em}
.lb.n>span{font-size:calc(var(--H)*.05);letter-spacing:0}
.lb.q img{position:absolute;left:8%;top:12%;width:84%;height:76%;object-fit:contain}
.ledge{position:absolute;left:0;right:0;bottom:0;height:var(--ledge);background:linear-gradient(var(--petrol-light),var(--petrol) 30%,var(--petrol-darker));box-shadow:0 -2px 0 rgb(255 255 255 / .25) inset,0 30px 40px -20px rgb(10 74 80 / .6)}
.ledge::after{display:none;content:"";position:absolute;left:0;right:0;top:100%;height:clamp(46px,6vw,90px);background:url("/img/svg/onde-bande-striscia.svg") center/cover;transform:scaleY(-1)}
.probe{position:absolute;visibility:hidden;pointer-events:none;width:1px;height:var(--H)}
.cap{position:relative;display:grid;justify-items:center;text-align:center;padding:calc(clamp(46px,6vw,90px) + 26px) var(--gutter) clamp(40px,6vw,80px);color:var(--petrol)}
.cap .m{overflow:hidden;display:grid;justify-items:center}.cap .m>span{grid-area:1/1;display:block}
.cap h3{font-family:var(--f-display);font-weight:900;text-transform:uppercase;font-size:clamp(26px,3.4vw,48px);letter-spacing:-.02em;line-height:1;padding-bottom:.06em;width:min(92vw,760px)}
.cap p{margin-top:8px;font:600 11px/1.2 var(--f-body);letter-spacing:.09em;text-transform:uppercase;width:min(92vw,760px)}
.arr{position:absolute;top:calc(clamp(46px,6vw,90px) + 26px - 6px);left:20px;width:44px;height:44px;display:grid;place-items:center;color:var(--petrol);border-radius:50%;transition:transform .5s var(--ease)}
.arr.r{left:auto;right:20px}.arr svg{width:18px;height:10px}
.arr:hover{transform:translateX(-4px)}.arr.r:hover{transform:translateX(4px)}.arr:active{transform:scale(.9)}
@media (max-width:767px){.arr{left:6px}.arr.r{right:6px}.cap h3{font-size:24px}}
.nojs{list-style:none;padding:0 var(--gutter) 40px;color:var(--petrol)}
/* custom cursor (fine pointers only, inside the shelf) */
.cur{position:fixed;left:0;top:0;width:58px;height:58px;margin:-29px 0 0 -29px;pointer-events:none;z-index:100;visibility:hidden;will-change:transform}
.cur i{position:absolute;inset:0;border-radius:50%;border:1.5px solid var(--petrol);transition:transform .5s cubic-bezier(.2,.8,.2,1),background-color .4s,border-color .4s}
.cur b{position:absolute;left:50%;top:50%;width:6px;height:6px;margin:-3px;border-radius:50%;background:var(--petrol);transition:transform .4s cubic-bezier(.2,.8,.2,1)}
.cur em{position:absolute;inset:0;display:grid;place-items:center;text-align:center;font:800 10px/1.25 var(--f-display);font-style:normal;letter-spacing:.1em;color:#fff;transform:scale(0);transition:transform .45s cubic-bezier(.2,.8,.2,1)}
.cur.spine i{transform:scale(.72)}.cur.btn i{transform:scale(.55)}.cur.btn b{transform:scale(0)}
.cur.open i{transform:scale(1.75);background:var(--petrol);border-color:var(--petrol)}.cur.open b{transform:scale(0)}.cur.open em{transform:scale(1)}
/* The cursor must never sit above an opened detail dialog. */
.sx-tagli:has(#tg-sheet:not([hidden])) #tg-cur{visibility:hidden!important}
/* detail sheet */
.sheet{position:fixed;inset:0;z-index:var(--z-modal);background:var(--cream);height:100vh;height:100dvh;overflow-x:hidden;overflow-y:auto;overscroll-behavior-y:contain;touch-action:pan-y;-webkit-overflow-scrolling:touch}
.sheet[hidden]{display:none}
.sheet .x{position:fixed;right:max(16px,env(safe-area-inset-right));top:16px;z-index:2;width:52px;height:52px;border-radius:16px;background:var(--petrol);color:#fff;display:grid;place-items:center}
.sheet .in{position:relative;display:grid;gap:clamp(24px,4.5vw,72px);padding:clamp(76px,8vw,110px) var(--gutter) 64px;max-width:1240px;margin:auto;min-height:100%;grid-template-columns:1fr;justify-items:center;align-content:center;align-items:center}
.sheet .in>div:last-child{width:100%;max-width:560px}
.sheet::before{content:"";position:fixed;inset:0;z-index:0;background:url("/img/pattern/ref/liquido-crema.webp") center/cover;pointer-events:none}
.sheet .in{z-index:1}.sheet .x{z-index:1000;pointer-events:auto;touch-action:manipulation;top:max(16px,env(safe-area-inset-top))}
.sheet .big{box-sizing:border-box;display:grid;place-items:center;border-radius:var(--r-media);overflow:hidden;aspect-ratio:var(--pa,.8);justify-self:center;border:8px solid #fff;box-shadow:var(--shadow);height:min(72svh,700px);width:auto;max-width:100%;min-width:0}
/* On phones/tablets the original 100%-width portrait could become taller than
   the entire viewport. Constrain its HEIGHT instead: controls and title stay
   visible and the details panel retains independent native touch scrolling. */
@media (max-width:899px){
 .sheet .in{
   display:flex;flex-direction:column;justify-content:flex-start;align-items:center;
   gap:clamp(16px,2.8dvh,28px);
   min-height:0;
   padding:calc(88px + env(safe-area-inset-top)) clamp(16px,4vw,36px)
     calc(36px + env(safe-area-inset-bottom));
 }
 .sheet .big{
   flex:none;width:auto;height:min(46dvh,530px);max-width:100%;
   aspect-ratio:var(--pa,.8);
   border-width:6px;
 }
 .sheet .in>div:last-child{width:100%;max-width:560px}
 .sheet h2{font-size:clamp(36px,8vw,64px);white-space:normal;overflow-wrap:anywhere;line-height:.95}
 .sheet .facts{margin:16px 0}
 .sheet .sticky{padding-bottom:4px}
}
@media (max-width:899px) and (max-height:650px){
 .sheet .big{height:min(36dvh,300px)}
 .sheet .in{padding-top:calc(78px + env(safe-area-inset-top))}
}
.sheet .big{position:relative;background:#0F6870}
.sheet .photo-note{position:absolute;inset:0;display:grid;place-items:center;padding:16px;text-align:center;background:#0F6870;color:#fff;font:700 14px/1.3 var(--f-body)}
.sheet .photo-note[hidden]{display:none}
/* Every haircut photograph has its own natural portrait ratio. Preserve it
   on phone, tablet and desktop: cover used to cut hair/foreheads at the edges. */
.sheet .big img{display:block;width:100%;height:100%;object-fit:contain;object-position:center;max-width:100%;max-height:100%}
.mk{overflow:hidden}.mk>.mi{will-change:transform;padding-bottom:.08em}
.sheet h2{font-family:var(--f-display);font-weight:900;text-transform:uppercase;white-space:nowrap;font-size:clamp(44px,7vw,110px);line-height:.88;letter-spacing:-.04em;color:var(--petrol)}
.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:22px 0}
.facts div{background:#fff;border-radius:16px;padding:14px;text-align:center}
.facts b{display:block;font-family:var(--f-display);font-weight:900;font-size:clamp(22px,2.4vw,34px);color:var(--petrol)}
.sheet .sticky{margin-top:20px}
@media (min-width:900px){.sheet .in{grid-template-columns:auto minmax(0,560px);justify-content:center;gap:clamp(40px,6vw,96px)}}
}
</style>

<script>
import { reduced, lockScroll, trapTab } from '../scripts/core.js';
const { CUTS, LAB, wa: WA } = JSON.parse(document.getElementById('tagli-data')!.textContent!) as { CUTS: [string, string, string, string][]; LAB: Record<string, any>; wa: string };
// Astro knows the project subpath on GitHub Pages. Avoid runtime /img URLs,
// which point to the wrong root when the site is published under a repository name.
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const T = `${BASE}img/tagli/`;
const urlFor = (key: string, kind: string) => (kind === 'spine' || kind === 'front' ? `${BASE}img/v2/tagli/split/${key}-${kind}.webp` : `${T}${key}-${kind}.webp`);
const brandUrl = (name: string) => `${BASE}img/brand/${name}`;
const pos_ = (r: number[]) => `left:${r[0] * 100}%;top:${r[1] * 100}%;width:${r[2] * 100}%;height:${r[3] * 100}%`;
const RM = reduced, EASE = 'cubic-bezier(.2,.8,.2,1)';
const $ = (id: string) => document.getElementById(id)!;
const shelf = $('shelf'), stage = $('tg-stage'), probe = $('probe'), cur = $('tg-cur'), tagliEl = $('tagli');
const NC = CUTS.length;
const AR = CUTS.reduce((a, c) => a + LAB[c[1]].ar, 0) / NC, SAR = CUTS.reduce((a, c) => a + LAB[c[1]].sar, 0) / NC;
let H = 0, ws = 0, d = 0, gap = 0, W = 0;
const measure = () => { H = probe.offsetHeight; ws = H * SAR; d = H * AR; gap = H * 0.055; W = shelf.clientWidth; };
measure();
// Keep eight unique designs on touch layouts; fill the desktop shelf with sixteen
// physical sleeves (a second cycle of the same eight approved haircuts).
const desktopShelf = matchMedia('(min-width:1024px)').matches;
const N = desktopShelf ? NC * 2 : NC;
type Tape = { el: HTMLElement; sp: HTMLElement; cv: HTMLElement; lt: HTMLElement; lift: number; hid: boolean };
const tapes: Tape[] = [];
const frag = document.createDocumentFragment();
for (let v = 0; v < N; v++) {
  const c = CUTS[v % NC], L = LAB[c[1]]; const el = document.createElement('div'); el.className = 'tape'; el.dataset.v = String(v);
  el.style.setProperty('--ar', L.ar); el.style.setProperty('--sar', L.sar);
  el.innerHTML = `<div class="face sp" style="--tex:url(${urlFor(c[1], 'spine')})"><div class="lb n" style="${pos_(L.sq)}"><span>${String(v % NC + 1).padStart(2, '0')}</span></div><div class="lb s" data-t="${c[0]}" data-r="spine" style="${pos_(L.spine)}"><span>${c[0]}</span></div><div class="lb q" style="${pos_(L.face)}"><img src="${brandUrl('faccia-petrolio-trasparente-480.webp')}" alt="" draggable="false"></div></div><div class="face cv" style="--tex:url(${urlFor(c[1], 'front')})"><div class="lb t" data-t="${c[0]}" data-r="top" style="${pos_(L.top)}"><span>${c[0]}</span></div><div class="lb b" data-t="${c[2]}" data-r="bot" style="${pos_(L.bot)}"><span>${c[2]}</span></div></div><div class="face lt" style="--tex:url(${urlFor(c[1], 'lato')})"></div>`;
  frag.append(el); tapes.push({ el, sp: el.children[0] as HTMLElement, cv: el.children[1] as HTMLElement, lt: el.children[2] as HTMLElement, lift: 0, hid: false });
}
stage.append(frag);
/* fit every text to its label once (size stored as a fraction of H, so it scales with the shelf) */
function fitLabels() {
  const probeS = document.createElement('span'); probeS.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;font:900 100px/.95 var(--f-display);text-transform:uppercase;letter-spacing:.01em'; tagliEl.append(probeS);
  const tw = (t: string) => { probeS.textContent = t; return probeS.getBoundingClientRect().width / 100; }; const done: Record<string, any> = {};
  tapes.forEach((t, v) => { const c = CUTS[v % NC], L = LAB[c[1]]; t.el.querySelectorAll<HTMLElement>('.lb[data-t]').forEach((el) => {
    const r = el.dataset.r!, txt = el.dataset.t!.toUpperCase(), key = c[1] + r;
    if (!done[key]) { const rect = r === 'spine' ? L.spine : r === 'top' ? L.top : L.bot; let k;
      if (r === 'spine') { const lw = rect[2] * H * L.sar, lh = rect[3] * H; probeS.style.letterSpacing = '.03em'; k = Math.min((0.88 * lh) / tw(txt), 0.62 * lw) / H; }
      else { const lw = rect[2] * H * L.ar, lh = rect[3] * H; probeS.style.letterSpacing = '.01em'; let best = Math.min((0.9 * lw) / tw(txt), 0.62 * lh), text = txt;
        const words = txt.split(' '); if (words.length > 1) { for (let i = 1; i < words.length; i++) { const a = words.slice(0, i).join(' '), b = words.slice(i).join(' '); const f = Math.min((0.9 * lw) / Math.max(tw(a), tw(b)), 0.4 * lh); if (f > best * 1.15) { best = f; text = a + '\n' + b; } } }
        k = best / H; done[key + 't'] = text; }
      done[key] = k; }
    el.style.setProperty('--k', done[key]); if (done[key + 't']) el.firstElementChild!.textContent = done[key + 't']; }); });
  probeS.remove();
}
Promise.all([document.fonts.load('900 100px Archivo'), document.fonts.ready]).then(fitLabels, fitLabels);
const sm = (x: number) => x * x * (3 - 2 * x);
const Bf = (r: number) => (Math.abs(r) < 1 ? (r + Math.sin(Math.PI * r) / Math.PI) / 2 : Math.sign(r) * 0.5);
const F = (r: number) => r * (ws + gap) + (d - ws + 2.4 * gap + d * 0.22) * Bf(r);
// Finite shelf positions prevent teleporting. On phone and desktop, the middle cassette is selected first.
const relr = (v: number, s: number) => v - s;
const bound = (n: number) => Math.max(0, Math.min(N - 1, n));
/* ---- state ---- */
let s = Math.floor(N / 2), Tg = s, sv = 0, sig = '', hover = -1, active = -1, mx = -1e4, my = -1e4, cx = -1e4, cy = -1e4, tiltX = 0, tiltY = 0, onCover = false, isOpen = false, drag: any = null, vis = false, last = performance.now(), inSec = false;
const fine = matchMedia('(pointer:fine)').matches;
const idx = () => bound(Math.round(s));
/* ---- caption: each change slides through a mask ---- */
const cn = $('cn'), cd = $('cd');
function swap(el: HTMLElement, text: string, dir: number) {
  const old = [...el.children] as any[]; const n = document.createElement('span'); n.textContent = text; el.append(n);
  if (!old.length) return; const dur = RM ? 1 : 650;
  n.animate([{ transform: `translateY(${dir * 105}%)` }, { transform: 'translateY(0)' }], { duration: dur, easing: EASE, fill: 'both' });
  old.forEach((o) => { if (o._l) return; o._l = 1; const cs = getComputedStyle(o).transform; o.animate([{ transform: cs === 'none' ? 'translateY(0)' : cs }, { transform: `translateY(${-dir * 105}%)` }], { duration: dur, easing: EASE, fill: 'both' }).onfinish = () => o.remove(); });
}
function setActive(i: number, dir: number) { active = i; const c = CUTS[i % NC]; swap(cn, c[0], dir); swap(cd, `${c[3]}  ·  ${c[2]}`, dir); }
/* ---- render one frame of the responsive, stationary-index VHS geometry ---- */
function render(dt: number) {
  const sr = shelf.getBoundingClientRect(), scy = sr.top + 70 + H / 2;
  onCover = !isOpen && fine && Math.abs(mx - (sr.left + W / 2)) < 0.55 * d && Math.abs(my - scy) < 0.55 * H && Math.abs(Tg - s) < 0.3;
  const ky = 1 - Math.exp(-7 * dt);
  const tyT = onCover ? ((mx - (sr.left + W / 2)) / (0.55 * d)) * 9 : ((mx - (sr.left + W / 2)) / W) * 5, txT = onCover ? (-(my - scy) / (H / 2)) * 6 : 0;
  tiltY += ((fine && inSec ? tyT : 0) - tiltY) * ky; tiltX += ((fine && inSec ? txT : 0) - tiltX) * ky;
  const kl = 1 - Math.exp(-12 * dt), lim = W / 2 + 1.5 * d;
  const nsig = s.toFixed(5) + '|' + tiltX.toFixed(3) + '|' + tiltY.toFixed(3) + '|' + hover + '|' + W + '|' + H;
  const moving = nsig !== sig || tapes.some((t) => Math.abs(t.lift - (hover >= 0 && tapes[hover] === t ? 1 : 0)) > 0.001); sig = nsig;
  if (moving) for (let v = 0; v < N; v++) {
    const t = tapes[v], r = relr(v, s), x = F(r);
    if (Math.abs(x) > lim) { if (!t.hid) { t.el.style.visibility = 'hidden'; t.hid = true; } continue; }
    if (t.hid) { t.el.style.visibility = ''; t.hid = false; }
    const tgt = hover === v && Math.abs(r) > 0.5 ? 1 : 0; t.lift += (tgt - t.lift) * (RM ? 1 : kl);
    const o = sm(Math.max(0, 1 - Math.abs(r)));
    t.el.style.transform = `translate3d(${x.toFixed(2)}px,${(-o * 0.025 * H - t.lift * 0.045 * H).toFixed(2)}px,${(o * 0.2 * H).toFixed(2)}px) rotateZ(${(-4.5 * o).toFixed(3)}deg) rotateX(${(tiltX * o).toFixed(3)}deg) rotateY(${(-90 * o + tiltY * o).toFixed(3)}deg)`;
    t.el.style.zIndex = String(Math.round(100 - Math.abs(r) * 4));
    t.sp.style.setProperty('--shade', (o * 0.55).toFixed(3)); t.lt.style.setProperty('--shade', (0.2 + o * 0.4).toFixed(3)); t.cv.style.setProperty('--shade', ((1 - o) * 0.5).toFixed(3));
  }
  if (fine) {
    cx += (mx - cx) * (1 - Math.exp(-16 * dt)); cy += (my - cy) * (1 - Math.exp(-16 * dt));
    cur.style.transform = `translate3d(${cx.toFixed(1)}px,${cy.toFixed(1)}px,0)`;
