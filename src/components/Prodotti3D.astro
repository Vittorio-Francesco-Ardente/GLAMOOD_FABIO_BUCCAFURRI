    const w = cw, h = chh; c.setTransform(SDPR, 0, 0, SDPR, 0, 0); c.clearRect(0, 0, w, h);
    const tall = coarse || h > w * 1.05;
    const jarYv = `${Math.round(tall ? tBottom + 14 + (cTop - tBottom - 64) / 2 : h * .55)}px`; if (pin.style.getPropertyValue('--jar-y') !== jarYv) pin.style.setProperty('--jar-y', jarYv);
    // portrait: the jar fits exactly in the free band between the giant name and the card, never over either
    const avail = cTop - tBottom - 64;   /* room for the page dots between jar and card */
    const jw = tall ? Math.max(120, Math.min(w < 768 ? w * .6 : w * .62, 620, avail * 1.21)) : Math.min(w * .4, h * .6 * 1.21), jh = jw / 1.21, base = tall ? tBottom + 14 + (avail + jh) / 2 : h * .9;
    jarBox = [w / 2 - jw * .55, w / 2 + jw * .55, base - jh * 1.05, base + 6];
    const rotOf = (_tt: number) => hover + drag;   // front → side panel → front
    const jarAlpha = 1 - lineK;
    if (jarAlpha > .01) {
      c.globalAlpha = jarAlpha;
      const lift = Math.sin(Math.PI * Math.min(1, t / .6)) * jh * .04;
      if (i < N - 1 && sw > 0) {
        const travel = tall ? w / 2 + jw * .6 : w * .62;   // on phones the outgoing jar leaves before the next one arrives: no overlap
        drawJar(c, arts[i], w / 2 - sw * travel, base, jw, jh, rotOf(t), lift);
        drawJar(c, arts[nx], w / 2 + (1 - sw) * travel, base, jw, jh, rotOf(0), 0);
      } else drawJar(c, arts[i], w / 2, base, jw, jh, rotOf(Math.min(1, t / .6)), lift);
      c.globalAlpha = 1;
    }
  }
}

// ---------- phone cards ----------
function startCards() {
  const cards = [...sec.querySelectorAll<HTMLCanvasElement>('.p3c-cv')];
  const st = cards.map(() => ({ rot: 0, v: 0, target: null as null | number, vis: false, drag: null as null | { x: number; r: number } }));
  const io = new IntersectionObserver((es) => es.forEach((e) => { const k = cards.indexOf(e.target as HTMLCanvasElement); st[k].vis = e.isIntersecting; if (e.isIntersecting) { ensureArt(k); if (!reduced) st[k].target = 0; } }), { threshold: .35 });
  cards.forEach((cv, k) => {
    io.observe(cv);
    cv.addEventListener('pointerdown', (e) => { st[k].drag = { x: e.clientX, r: st[k].rot }; st[k].target = null; cv.setPointerCapture(e.pointerId); });
    cv.addEventListener('pointermove', (e) => { const s = st[k]; if (!s.drag) return; const nr = s.drag.r - (e.clientX - s.drag.x) / (cv.clientWidth * 2.2); s.v = nr - s.rot; s.rot = nr; });
    const up = () => { st[k].drag = null; }; cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up); cv.addEventListener('pointerleave', up);
  });
  sec.querySelectorAll<HTMLButtonElement>('.p3c-turn').forEach((b) => b.addEventListener('click', () => { const s = st[+b.dataset.i!]; const side = Math.abs(s.rot) < .15 ? .3 : 0; s.target = side; b.textContent = side ? 'Davanti' : 'Gira'; }));
  let last = performance.now();
  const painted = cards.map(() => ({rot: NaN, width: 0, height: 0}));
  const frame = (now: number) => {
    requestAnimationFrame(frame); const dt = Math.min(.05, (now - last) / 1000); last = now;
    cards.forEach((cv, k) => {
      const s = st[k]; if (!s.vis || !arts[k]) return;
      if (!s.drag) {
        if (s.target !== null) { s.rot += (s.target - s.rot) * Math.min(1, dt * 4); if (Math.abs(s.target - s.rot) < .002) s.target = null; }
        else if (Math.abs(s.v) > .0005) { s.rot += s.v; s.v *= .92; }
        else s.v = 0;                                 // 6°/s when idle
      }
      const { w, h } = fitCanvas(cv);
      const prev = painted[k], rotation = reduced ? 0 : s.rot;
      if (Math.abs(prev.rot - rotation) < .0001 && prev.width === cv.width && prev.height === cv.height) return;
      painted[k] = {rot: rotation, width: cv.width, height: cv.height};
      const c = cv.getContext('2d')!; c.imageSmoothingQuality = 'high'; c.setTransform(DPR, 0, 0, DPR, 0, 0); c.clearRect(0, 0, w, h);
      const jh = Math.min(h * .78, (w * .82) / 1.21);               // jar box ratio (opaque part) is ~1.21:1
      drawJar(c, arts[k], w / 2, h / 2 + jh / 2, w * .82, jh, reduced ? 0 : s.rot);
    });
  };
  requestAnimationFrame(frame);
}

// ---------- product sheet ----------
const sheet = document.getElementById('p3s')!; let back: HTMLElement | null = null;
sheet.addEventListener('keydown', (e) => trapTab(e, sheet));
const $ = (id: string) => document.getElementById(id)!;
function openSheet(i: number, from: HTMLElement) {
  const p = P[i]; back = from;
  $('p3s-k').textContent = `${p.ml} · Glamood`; $('p3s-t').textContent = p.full; $('p3s-note').textContent = p.note;
  $('p3s-use').textContent = p.use; $('p3s-ing').textContent = p.ing.join(', ') + ' (elenco completo in arrivo)'; $('p3s-ml').textContent = p.ml;
  ($('p3s-wa') as HTMLAnchorElement).href = p.wa;
  (sheet.querySelector('.p3s-illu') as HTMLImageElement).src = p.illu;
  sheet.style.backgroundColor = p.bgc; sheet.style.backgroundImage = `url(${p.liquid})`;
  ($('p3s-full') as HTMLAnchorElement).href = (document.querySelector('.mark') as HTMLAnchorElement).href.replace(/\/?$/, '/') + 'prodotti/' + p.slug;
  $('p3s-ings').innerHTML = p.ings.slice(0, p.ing.length).map((s: string, j: number) => `<span><img src="${s}" alt="" loading="lazy" /><i>${p.ing[j] ?? ''}</i></span>`).join('');
  sheet.querySelectorAll<HTMLElement>('.p3s-o').forEach((b) => (b.hidden = +b.dataset.sheet! === i));
  sheet.scrollTop = 0;
  sheet.hidden = false; document.documentElement.classList.add("product-sheet-open"); sec.setAttribute("inert", ""); document.querySelector(".site-header")?.setAttribute("inert", ""); lockScroll(true); sheet.focus();
  if (arts[i]) requestAnimationFrame(() => still(sheet.querySelector('.p3s-cv') as HTMLCanvasElement, i));
}
function closeSheet() { if (sheet.hidden) return; sheet.hidden = true; document.documentElement.classList.remove("product-sheet-open"); sec.removeAttribute("inert"); document.querySelector(".site-header")?.removeAttribute("inert"); lockScroll(false); back?.focus({ preventScroll: true }); }
sec.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => { const i = +b.dataset.open!; Promise.all([boot(), ensureArt(i)]).then(() => openSheet(i, b)); }));
sheet.querySelector('.p3s-x')!.addEventListener('click', closeSheet);
sheet.querySelectorAll<HTMLElement>('.p3s-o').forEach((b) => b.addEventListener('click', () => { const i = +b.dataset.sheet!; Promise.all([boot(), ensureArt(i)]).then(() => { const prev = back; openSheet(i, prev || b); }); }));
addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSheet(); });
</script>
