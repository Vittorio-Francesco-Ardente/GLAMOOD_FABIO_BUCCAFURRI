---
// Aggiornamento 11: products with scroll-driven 3D jars and their real labels.
// Desktop (>=1024): a pinned stage, the scroll turns the jar and moves through the four products,
// background, giant title behind the jar, ingredients floating on three depth layers; last slide = the whole line.
// Phones: one full-screen card per product (scroll-snap), the jar turns with the finger and slowly by itself.
// Every product is also plain text in the DOM; canvases are aria-hidden. Reduced motion: static front view.
import { img } from '../data/img';
import { P3D } from '../data/products3d';
import { wa, waText } from '../data/business';
const V = 'v2/prodotti-3d';
// Liquid vector backgrounds (assets/svg/liquido-*.svg, traced from Vittorio's references): sharp at any size.
const LIQ: Record<string, { bg: string; liquid: string; slug: string; hdr: string }> = { cera: { bg: '#F1DEAE', liquid: 'miele', slug: 'cera-opaca', hdr: 'honey' }, balsamo: { bg: '#DDEAE7', liquid: 'salvia', slug: 'balsamo-barba', hdr: 'sage' }, crema: { bg: '#0F6870', liquid: 'petrolio-tono', slug: 'crema-styling', hdr: 'petrol' } };
const surfaces = P3D.map((p) => LIQ[p.k]);
const liq = (n: string) => `background-color:${n === 'abisso' || n === 'notte' ? '#0A4A50' : ''};background-image:url('/img/svg/liquido-${n}.svg')`;
const shadowFor = (ml: string) => `${V}/luci-ombre/ombra-contatto-barattolo-150ml`;
const data = P3D.map((p) => ({
  k: p.k, n: p.n, full: p.full, note: p.note, ml: p.ml, use: p.use, desc: p.desc, ing: p.ing, ink: p.ink, accent: p.accent,
  label: img(`${V}/etichette/etichetta-${p.k}-completa`).src,
  lid: img(`${V}/etichette/coperchio-${p.k}`, 960).src,
  illu: img(`${V}/illustrazioni/illustrazione-${p.k}`, 960).src,
  pattern: img(`${V}/illustrazioni/pattern-illustrato-${p.k}`, 960).src,
  shadow: img(shadowFor(p.ml), 1600).src,
  wa: wa(waText.info(p.full)),
  liquid: `/img/svg/liquido-${LIQ[p.k].liquid}.svg`, bgc: LIQ[p.k].bg, slug: LIQ[p.k].slug,
  hero: img(`${V}/confezioni/barattolo-${p.k}`, 480).src,
  ings: p.pics.slice(0, 3).map((f) => img(`${V}/ingredienti/${p.k}/${f}`, 480).src),
}));
const art = { jar: img(`${V}/barattolo/barattolo-nudo-fronte`, 1600).src, jarS: img(`${V}/barattolo/barattolo-nudo-fronte`, 960).src, light: img(`${V}/luci-ombre/passata-luce-barattolo`, 1600).src, lightS: img(`${V}/luci-ombre/passata-luce-barattolo`, 960).src };
const slots = [
  // x, y in % of the stage, size in vh, layer: 0 back (small, soft), 1 mid, 2 front (big, blurred).
  // Kept clear of the copy column (left) and of the ingredient chips (right).
  [34, 13, 10, 0], [66, 11, 9, 0], [79, 27, 12, 1], [26, 84, 10, 1], [91, 80, 16, 2], [62, 88, 11, 2],   // all above the bottom bar
];
---
<div class="sx-p3">
<section class="p3" id="prodotti" aria-labelledby="p3-t" style={`--n:${P3D.length}`}>
  <h2 class="sr-only" id="p3-t">I prodotti Glamood</h2>
  <!-- desktop pinned stage -->
  <a class="p3-skip" href="#catalogo">Salta al catalogo <span aria-hidden="true">↘</span></a>
  <div class="p3-pin">
    <div class="p3-bgs">{P3D.map((p, i) => <div class="p3-bg" data-i={i} data-hdr={surfaces[i].hdr} style={`background-color:${surfaces[i].bg};background-image:url('/img/svg/liquido-${surfaces[i].liquid}.svg')`}></div>)}
      <div class="p3-bg p3-bg-line" data-hdr="night" style={liq('notte')}></div></div>
    <div class="p3-titles">{P3D.map((p, i) => <p class="p3-title" data-i={i}>{p.n}</p>)}</div>
    <div class="p3-ings">{P3D.map((p, i) => p.pics.slice(0, 6).map((f, j) => (
      <img class="p3-ing" data-i={i} data-l={slots[j][3]} style={`left:${slots[j][0]}%;top:${slots[j][1]}%;height:${slots[j][2]}vh`} {...img(`${V}/ingredienti/${p.k}/${f}`, 480)} alt="" loading="lazy" decoding="async" />
    )))}</div>
    <canvas class="p3-cv" id="p3-cv" aria-hidden="true"></canvas>
    <div class="p3-copy">{P3D.map((p, i) => (
      <div class="p3-txt" data-i={i} style={`--ink:${p.ink};--ac:${p.accent}`}>
        <p class="p3-k">0{i + 1} / 0{P3D.length} · {p.ml}</p><a class="p3-cat" href="#catalogo" tabindex="-1">Tutta la linea <span aria-hidden="true">↓</span></a>
        <h3>{p.full}</h3><p class="p3-note">{p.note}</p>
        <p class="p3-desc">{p.desc}</p>
        <p class="p3-price">Prezzo da confermare</p>
        <div class="p3-btns"><a class="btn-pop fill" href={data[i].wa} target="_blank" rel="noopener" tabindex="-1">Chiedi in salone</a><button class="p3-more" type="button" data-open={i} tabindex="-1">Scheda</button></div>
      </div>
    ))}</div>
    <div class="p3-chips">{P3D.map((p, i) => (
      <ul class="p3-chip" data-i={i} style={`--ink:${p.ink}`}>{p.ing.map((t) => <li>{t}</li>)}<li class="ml">{p.ml}</li></ul>
    ))}</div>
    <div class="p3-line">
      <p class="p3-line-k">La linea Glamood</p>
      <div class="p3-line-row">{P3D.map((p, i) => <button type="button" class="p3-lj" data-open={i} tabindex="-1" style={`--d:${i * 110}ms`} aria-label={`${p.full}, ${p.note}: apri la scheda`}><canvas data-still={i}></canvas><span><b>{p.full}</b><i>{p.note} · {p.ml}</i></span></button>)}</div>
      <p class="p3-line-sub">Tocca un barattolo per la scheda</p>
    </div>
    <div class="p3-nav" aria-label="Sfoglia i prodotti"><div class="p3-dots">{[...P3D.map((p) => p.n), 'La linea'].map((n, i) => <button type="button" data-step={i} aria-label={`Vai a ${n}`}></button>)}</div><button type="button" class="p3-nb" data-dir="-1" aria-label="Prodotto precedente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button><button type="button" class="p3-nb" data-dir="1" aria-label="Prodotto successivo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button></div>
    <p class="p3-hint">Muovi il mouse per ruotare · scorri per il prossimo</p>
  </div>
  <!-- phones (and reduced motion): one card per product -->
  <div class="p3m">
    <article class="p3c p3c-intro" data-hdr="night">
      <picture><source media="(max-width:767px)" srcset={img(`${V}/sfondi-scroll/controluce-crema-mob`, 960).src} /><img class="p3c-bg" {...img(`${V}/sfondi-scroll/controluce-crema-desk`, 1600)} alt="" loading="lazy" decoding="async" /></picture>
      <div class="p3c-in"><p class="p3-k" style="color:#ECC46C">La linea Glamood</p><h3 class="p3c-h">I barattoli<br />di Fabio</h3><p class="p3c-p">Tre barattoli, gli stessi che usa in salone. Gira il barattolo con il dito per leggere l'etichetta.</p></div>
    </article>
    {P3D.map((p, i) => (
      <article class="p3c" data-i={i} style={`--ink:${p.ink};--ac:${p.accent}`} aria-labelledby={`p3c-${p.k}`}>
        <div class="p3c-bg" data-hdr={surfaces[i].hdr} style={`background-color:${surfaces[i].bg};background-image:url('/img/svg/liquido-${surfaces[i].liquid}.svg')`}></div>
        <div class="p3c-stage" aria-hidden="true">
          {p.pics.slice(0, 3).map((f, j) => <img class="p3c-ing" data-j={j} {...img(`${V}/ingredienti/${p.k}/${f}`, 480)} alt="" loading="lazy" decoding="async" />)}
          <canvas class="p3c-cv" data-i={i}></canvas>
        </div>
        <div class="p3c-in">
          <p class="p3-k">0{i + 1} · {p.ml}</p>
          <h3 id={`p3c-${p.k}`}>{p.full}</h3>
          <p class="p3c-p">{p.desc} <span class="p3-note">{p.note}.</span></p>
          <p class="p3-price">Prezzo da confermare</p>
          <div class="p3c-btns"><button class="p3c-turn" type="button" data-i={i} aria-label={`Gira il barattolo ${p.n} per leggere l'etichetta`}>Gira</button><button class="p3-more" type="button" data-open={i}>Scheda</button></div>
          <a class="btn-pop fill p3c-cta" href={data[i].wa} target="_blank" rel="noopener">Chiedi in salone</a>
        </div>
      </article>
    ))}
  </div>
</section>

<div class="p3s" id="p3s" role="dialog" aria-modal="true" aria-labelledby="p3s-t" data-lenis-prevent tabindex="-1" hidden>
  <div class="p3s-pat"></div>
  <button class="p3s-x" type="button" aria-label="Chiudi la scheda"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  <div class="p3s-in">
    <div class="p3s-art"><img class="p3s-illu" alt="" /><canvas class="p3s-cv" aria-hidden="true"></canvas></div>
    <div class="p3s-tx">
      <p class="p3-k" id="p3s-k"></p><h2 id="p3s-t"></h2><p class="p3s-note" id="p3s-note"></p>
      <dl>
        <div><dt>Modo d'uso</dt><dd id="p3s-use"></dd></div>
        <div><dt>Ingredienti</dt><dd id="p3s-ing"></dd></div>
        <div><dt>Formato</dt><dd id="p3s-ml"></dd></div>
        <div><dt>Prezzo</dt><dd>Da confermare in salone</dd></div>
      </dl>
      <div class="p3s-ings" id="p3s-ings" aria-hidden="true"></div>
      <div class="p3s-cta"><a class="btn-pop fill" id="p3s-wa" href={wa()} target="_blank" rel="noopener">Prenota e chiedilo a Fabio</a><a class="p3s-full" id="p3s-full" href="/prodotti">Scheda completa <span aria-hidden="true">↗</span></a></div>
    </div>
  </div>
  <div class="p3s-more"><p class="p3-k">Guarda anche</p><div class="p3s-row">{P3D.map((p, i) => <button type="button" class="p3s-o" data-sheet={i}><img src={data[i].hero} alt="" loading="lazy" decoding="async" /><span><b>{p.full}</b>{p.note}</span></button>)}</div></div>
  <img class="p3s-pg" {...img(`${V}/personaggio/posa-barattolo`, 960)} alt="" loading="lazy" decoding="async" />
</div>
</div>
<script type="application/json" id="p3-data" set:html={JSON.stringify({ P: data, art })}></script>

<style is:global>
.sx-p3{display:contents;
.p3{position:relative;background:#F4EFE8;color:var(--ink)}
.p3-k{font:800 12px/1 var(--f-display);letter-spacing:.18em;text-transform:uppercase;color:var(--ac,#B8935A)}
.p3-price{font:800 13px/1 var(--f-display);letter-spacing:.08em;text-transform:uppercase;opacity:.8}
.p3-note{font-style:italic}
.p3-more,.p3c-turn{min-height:48px;padding:0 20px;border-radius:999px;border:2px solid currentColor;background:transparent;color:inherit;font:900 14px/1 var(--f-display);text-transform:uppercase;letter-spacing:.06em;cursor:pointer}
/* ---------- desktop pinned stage ---------- */
.p3-pin{display:none}
@media (prefers-reduced-motion:no-preference){
 .p3{height:calc((var(--n) + 1.4) * 100svh)}
 .p3 .p3m{display:none}
 .p3-pin{display:block;position:sticky;top:0;height:100svh;height:100dvh;overflow:hidden;isolation:isolate}
 .p3-bgs,.p3-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
 .p3-bg{opacity:0;will-change:opacity}
 .p3-bg[data-i="0"]{opacity:1}   /* first screen is never empty, even before the script runs */
 .p3-titles{position:absolute;inset:0;z-index:1;display:grid;place-items:start center;padding-top:calc(76px + 3vh);pointer-events:none}
 .p3-title{grid-area:1/1;font:900 min(22vw,22vh)/.78 var(--f-display);text-transform:uppercase;letter-spacing:-.05em;white-space:nowrap;color:#fff;opacity:.95;clip-path:inset(0 0 100% 0);will-change:clip-path,transform}
 .p3-ing{position:absolute;z-index:2;width:auto;translate:-50% -50%;opacity:0;will-change:transform,opacity;filter:drop-shadow(0 18px 18px rgb(0 0 0 / .25))}
 .p3-ing[data-l="0"]{z-index:0;filter:blur(1.5px) saturate(.9) drop-shadow(0 10px 10px rgb(0 0 0 / .15))}
 .p3-ing[data-l="2"]{z-index:5;filter:blur(5px) drop-shadow(0 26px 24px rgb(0 0 0 / .3))}
 .p3-cv{position:absolute;inset:0;z-index:3;width:100%;height:100%;cursor:grab;touch-action:pan-y;pointer-events:auto}
 .p3-cv.drag{cursor:grabbing}
 .p3-copy,.p3-chips{position:absolute;z-index:6;top:50%;translate:0 -50%}
 .p3-cat{display:none}
 .p3-nav{display:none}
 .p3-copy{left:var(--gutter);width:min(26vw,380px)}
 .p3-txt{position:absolute;inset:auto 0 auto 0;top:50%;translate:0 -50%;color:var(--ink);opacity:0;pointer-events:none;transition:opacity .35s}
 .p3-txt.on,.p3-txt[data-i="0"]:not(.off){opacity:1;pointer-events:auto}
 .p3-txt h3{margin-top:14px;font:900 clamp(34px,3.2vw,56px)/.9 var(--f-display);text-transform:uppercase;letter-spacing:-.02em}
 .p3-txt .p3-note{margin-top:8px;font-size:18px;color:var(--ac)}
 .p3-txt .p3-desc{margin-top:16px;font-size:17px;line-height:1.5;max-width:30ch}
 .p3-txt .p3-price{margin-top:16px}
 .p3-btns{display:flex;gap:10px;margin-top:22px;flex-wrap:wrap}
 .p3-chips{right:var(--gutter);width:0}
 .p3-chip{position:absolute;right:0;top:50%;translate:0 -50%;list-style:none;margin:0;padding:0;display:flex;flex-direction:column;align-items:flex-end;gap:10px;opacity:0;transition:opacity .35s}
 .p3-chip.on,.p3-chip[data-i="0"]:not(.off){opacity:1}
 .p3-chip li{white-space:nowrap;padding:10px 16px;border-radius:999px;border:2px solid var(--ink);color:var(--ink);font:800 14px/1 var(--f-display);text-transform:uppercase;letter-spacing:.04em;background:#F4EFE8}
 .p3-chip[data-i="2"] li:not(.ml){background:#0F6870}
 .p3-chip li.ml{background:var(--ink);color:#F4EFE8;border-color:var(--ink)}
 .p3-chip[data-i="2"] li.ml{color:#0F6870}
 .p3-line{position:absolute;inset:0;z-index:7;display:grid;align-content:center;justify-items:center;gap:2vh;padding-top:6vh;opacity:0;pointer-events:none}
 .p3-line::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse 52% 40% at 50% 64%,rgb(236 196 108 / .2),transparent 70%),radial-gradient(ellipse 70% 30% at 50% 88%,rgb(3 30 33 / .45),transparent 70%);pointer-events:none}
 .p3-line-sub{font:700 13px/1 var(--f-display);letter-spacing:.14em;text-transform:uppercase;color:rgb(244 239 232 / .7);margin-top:3vh}
 .p3-line.on{pointer-events:auto}
 .p3-line-k{font:900 clamp(40px,4.6vw,80px)/.9 var(--f-display);text-transform:uppercase;color:#F4EFE8;letter-spacing:-.02em;text-shadow:0 12px 30px rgb(3 30 33 / .35)}
 .p3-line-row{display:flex;gap:0;align-items:flex-end;margin-top:1vh}
 .p3-lj{--y:0px;--s:1;--hy:0px;position:relative;display:grid;justify-items:center;gap:10px;margin:0 -1.2vw;background:none;border:0;color:#F4EFE8;cursor:pointer;opacity:0;translate:0 48px;transform:translateY(calc(var(--y) + var(--hy))) scale(var(--s));transition:opacity .7s var(--ease-out) var(--d),translate .9s cubic-bezier(.2,.9,.25,1.05) var(--d),transform .5s cubic-bezier(.2,.9,.25,1.05)}
 .p3-line.on .p3-lj{opacity:1;translate:0 0}
 .p3-lj:nth-child(odd){--y:-3vh;--s:.9}
 .p3-lj:nth-child(2){z-index:2}
 .p3-lj:hover,.p3-lj:focus-visible{--hy:-14px}
 .p3-lj:focus-visible{outline:none}.p3-lj:focus-visible canvas{outline:3px solid #ECC46C;outline-offset:6px;border-radius:24px}
 .p3-lj canvas{width:min(30vw,52vh*1.16,560px);aspect-ratio:1.16;filter:drop-shadow(0 30px 34px rgb(3 30 33 / .35))}
 .p3-lj span{display:grid;justify-items:center;gap:6px;text-align:center}
 .p3-lj b{font:900 clamp(16px,1.5vw,24px)/1 var(--f-display);text-transform:uppercase;letter-spacing:.05em}
 .p3-lj i{font:italic 400 clamp(13px,1vw,16px)/1.3 var(--f-body);color:rgb(244 239 232 / .75);opacity:0;transform:translateY(-4px);transition:opacity .3s,transform .3s}
 .p3-lj:hover i,.p3-lj:focus-visible i,.p3-lj:nth-child(2) i{opacity:1;transform:none}
 .p3-hint{position:absolute;z-index:6;left:50%;bottom:24px;translate:-50% 0;font:800 12px/1 var(--f-display);letter-spacing:.16em;text-transform:uppercase;color:var(--hint,#0F6870);opacity:.8;transition:opacity .4s}
}
/* ---------- portrait screens: same scroll stage, phone layout ---------- */
/* compact composition: phones and every touch tablet (portrait or landscape) — name on top, jar centred, card centred below */
@media (prefers-reduced-motion:no-preference) and (max-aspect-ratio:1/1), (prefers-reduced-motion:no-preference) and (pointer:coarse){
 .p3-titles{padding-top:calc(64px + 2svh)}
 .p3-title{font-size:min(23vw,14svh);white-space:normal;text-align:center;line-height:.8;max-width:96vw}
 .p3-ing{scale:.72}
 .p3{height:100svh;height:100dvh}
 .p3-pin{position:relative}
 .p3-chips,.p3-hint{display:none}
 .p3-nav{display:block;position:absolute;inset:0;z-index:7;pointer-events:none}
 .p3-nb{position:absolute;top:var(--jar-y,50%);translate:0 -50%;width:50px;height:50px;border-radius:50%;border:3px solid #fff;display:grid;place-items:center;background:#0F6870;color:#fff;box-shadow:0 12px 26px -10px rgb(6 40 44 / .7);pointer-events:auto;cursor:pointer;transition:opacity .3s,transform .2s}
 .p3-nb svg{width:24px;height:24px}
 .p3-nb[data-dir="1"]:not(.is-exit){animation:p3nudge 2.4s ease-in-out infinite}
 @keyframes p3nudge{0%,70%,100%{transform:none}80%{transform:translateX(5px)}90%{transform:translateX(-2px)}}
 .p3-dots{position:absolute;left:50%;bottom:calc(var(--card-h,212px) + max(14px,env(safe-area-inset-bottom)) + 18px);transition:bottom .4s var(--ease-out);translate:-50% 0;display:flex;gap:7px;padding:7px 10px;border-radius:999px;background:rgb(255 255 255 / .85);pointer-events:auto}
 .p3.p3-at-line .p3-dots{bottom:calc(max(28px,calc(env(safe-area-inset-bottom) + 20px)) + 66px)}
 .p3-dots button{width:9px;height:9px;padding:0;border:0;border-radius:99px;background:#0F6870;opacity:.3;transition:width .35s var(--ease-out),opacity .35s;cursor:pointer}
 .p3-dots button[aria-current="true"]{width:24px;opacity:1}
 .p3-nb:active{transform:scale(.92)}
 .p3-nb[data-dir="-1"]{left:max(10px,env(safe-area-inset-left))}
 .p3-nb[data-dir="1"]{right:max(10px,env(safe-area-inset-right))}
 .p3-nb[hidden]{display:grid;opacity:0;pointer-events:none}
 .p3-nb.is-exit{top:auto;bottom:max(28px,calc(env(safe-area-inset-bottom) + 20px));left:50%;right:auto;translate:-50% 0;min-height:52px;width:auto;padding:0 18px 0 20px;border-radius:999px;gap:8px;grid-auto-flow:column;font:800 13px/1 var(--f-display);letter-spacing:.06em;text-transform:uppercase;background:#ECC46C;color:#08393E}
 .p3-txt .p3-k{min-height:28px;display:flex;align-items:center}
 .p3-cat{position:absolute;top:16px;right:16px;display:inline-flex;align-items:center;gap:6px;min-height:28px;padding:0 11px;border-radius:999px;background:#E3ECE8;color:#0F6870;font:800 11px/1 var(--f-display);letter-spacing:.08em;text-transform:uppercase;text-decoration:none}
 .p3-copy{left:50%;right:auto;width:min(640px,calc(100% - 24px))!important;top:auto;bottom:max(14px,env(safe-area-inset-bottom));translate:-50% 0;height:212px}
 .p3-txt{top:auto;bottom:0;translate:none;padding:18px 20px!important;border-radius:24px!important}
 .p3-txt .p3-k{font-size:11px}
 .p3-txt h3{margin-top:8px;font-size:clamp(26px,8vw,34px)!important}
 .p3-txt .p3-note{margin-top:4px;font-size:15px}
 .p3-txt .p3-desc{margin-top:8px;font-size:14px;line-height:1.45;max-width:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
 .p3-txt .p3-price{display:none}
 .p3-btns{margin-top:12px;flex-wrap:nowrap}
 .p3-btns .btn-pop{flex:1;justify-content:center;min-height:48px;font-size:14px;padding-inline:14px}
 .p3-more{min-height:48px;padding:0 18px}
 .p3-line{padding-top:4svh;gap:1.5svh}
 .p3-line-k{font-size:clamp(34px,10vw,52px);text-align:center;line-height:.95;padding:0 16px}
 .p3-line-row{margin-top:1svh;flex-wrap:wrap;justify-content:center;row-gap:1svh;max-width:100vw}
 .p3-line{padding-bottom:calc(110px + env(safe-area-inset-bottom))}
 .p3-lj{margin:0 -2vw}
 .p3-lj:nth-child(2){order:-1;flex-basis:100%;--y:0px;--s:1}
 .p3-lj:nth-child(odd){--y:0px;--s:1}
