---
// Aggiornamento 11: products with scroll-driven 3D jars and their real labels.
// Desktop (>=1024): a pinned stage, the scroll turns the jar and moves through the four products,
// background, giant title behind the jar, ingredients floating on three depth layers; last slide = the whole line.
// Phones: one full-screen card per product (scroll-snap), the jar turns with the finger and slowly by itself.
// Every product is also plain text in the DOM; canvases are aria-hidden. Reduced motion: static front view.
import { img } from '../data/img';
import { P3D } from '../data/products3d';
import { wa, waText } from '../data/business';
const V = 'v2/prodotti-3d';
const surfaces = [{bg:'#E7EEE5', motif:'onde'}, {bg:'#F1DEAE',motif:'alveare'}, {bg:'#DDEAE7',motif:'agrumi'}, {bg:'#0F6870',motif:'botanico'}];
const shadowFor = (ml: string) => `${V}/luci-ombre/ombra-contatto-barattolo-150ml`;
const data = P3D.map((p) => ({
  k: p.k, n: p.n, full: p.full, note: p.note, ml: p.ml, use: p.use, desc: p.desc, ing: p.ing, ink: p.ink, accent: p.accent,
  label: img(`${V}/etichette/etichetta-${p.k}-completa`).src,
  lid: img(`${V}/etichette/coperchio-${p.k}`, 960).src,
  illu: img(`${V}/illustrazioni/illustrazione-${p.k}`, 960).src,
  pattern: img(`${V}/illustrazioni/pattern-illustrato-${p.k}`, 960).src,
  shadow: img(shadowFor(p.ml), 1600).src,
  wa: wa(waText.info(p.full)),
}));
const art = { jar: img(`${V}/barattolo/barattolo-nudo-fronte`, 1600).src, jarS: img(`${V}/barattolo/barattolo-nudo-fronte`, 960).src, light: img(`${V}/luci-ombre/passata-luce-barattolo`, 1600).src, lightS: img(`${V}/luci-ombre/passata-luce-barattolo`, 960).src };
const slots = [
  // x, y in % of the stage, size in vh, layer: 0 back (small, soft), 1 mid, 2 front (big, blurred).
  // Kept clear of the copy column (left) and of the ingredient chips (right).
  [36, 14, 10, 0], [64, 12, 9, 0], [72, 70, 13, 1], [42, 76, 9, 1], [90, 68, 17, 2], [60, 80, 12, 2],   // all above the bottom bar
];
---
<div class="sx-p3">
<section class="p3" id="prodotti" aria-labelledby="p3-t" style={`--n:${P3D.length}`}>
  <h2 class="sr-only" id="p3-t">I prodotti Glamood</h2>
  <!-- desktop pinned stage -->
  <a class="p3-skip" href="#catalogo">Salta al catalogo <span aria-hidden="true">↘</span></a>
  <div class="p3-pin">
    <div class="p3-bgs">{P3D.map((p, i) => <div class="p3-bg" data-i={i} style={`background-color:${surfaces[i].bg};background-image:url('/img/svg/product-${surfaces[i].motif}.svg')`}></div>)}
      <div class="p3-bg p3-bg-line" style="background-color:#0A4A50;background-image:url('/img/svg/product-onde.svg')"></div></div>
    <div class="p3-titles">{P3D.map((p, i) => <p class="p3-title" data-i={i} style={`color:${p.ink}`}>{p.n}</p>)}</div>
    <div class="p3-ings">{P3D.map((p, i) => p.pics.slice(0, 6).map((f, j) => (
      <img class="p3-ing" data-i={i} data-l={slots[j][3]} style={`left:${slots[j][0]}%;top:${slots[j][1]}%;height:${slots[j][2]}vh`} {...img(`${V}/ingredienti/${p.k}/${f}`, 480)} alt="" loading="lazy" decoding="async" />
    )))}</div>
    <canvas class="p3-cv" id="p3-cv" aria-hidden="true"></canvas>
    <div class="p3-copy">{P3D.map((p, i) => (
      <div class="p3-txt" data-i={i} style={`--ink:${p.ink};--ac:${p.accent}`}>
        <p class="p3-k">0{i + 1} / 0{P3D.length} · {p.ml}</p>
        <h3>{p.full}</h3><p class="p3-note">{p.note}</p>
        <p class="p3-desc">{p.desc}</p>
        <p class="p3-price">Prezzo da confermare</p>
        <div class="p3-btns"><a class="btn-pop fill" href={data[i].wa} target="_blank" rel="noopener" tabindex="-1">Chiedi in salone</a><button class="p3-more" type="button" data-open={i} tabindex="-1">Scheda</button></div>
      </div>
    ))}</div>
    <div class="p3-chips">{P3D.map((p, i) => (
      <ul class="p3-chip" data-i={i} style={`--ink:${p.ink}`}>{p.ing.map((t) => <li>{t}</li>)}<li class="ml">{p.ml}</li></ul>
    ))}</div>
    <div class="p3-line">
      <p class="p3-line-k">La linea Glamood</p>
      <div class="p3-line-row">{P3D.map((p, i) => <button type="button" class="p3-lj" data-open={i} tabindex="-1"><canvas data-still={i}></canvas><span>{p.n}</span></button>)}</div>
    </div>
    <p class="p3-hint">Muovi il mouse per ruotare · scorri per il prossimo</p>
  </div>
  <!-- phones (and reduced motion): one card per product -->
  <div class="p3m">
    <article class="p3c p3c-intro">
      <picture><source media="(max-width:767px)" srcset={img(`${V}/sfondi-scroll/controluce-pomata-mob`, 960).src} /><img class="p3c-bg" {...img(`${V}/sfondi-scroll/controluce-pomata-desk`, 1600)} alt="" loading="lazy" decoding="async" /></picture>
      <div class="p3c-in"><p class="p3-k" style="color:#ECC46C">La linea Glamood</p><h3 class="p3c-h">I barattoli<br />di Fabio</h3><p class="p3c-p">Quattro prodotti, gli stessi che usa in salone. Gira il barattolo con il dito per leggere l'etichetta.</p></div>
    </article>
    {P3D.map((p, i) => (
      <article class="p3c" data-i={i} style={`--ink:${p.ink};--ac:${p.accent}`} aria-labelledby={`p3c-${p.k}`}>
        <div class="p3c-bg" style={`background-color:${surfaces[i].bg};background-image:url('/img/svg/product-${surfaces[i].motif}.svg')`}></div>
        <div class="p3c-stage" aria-hidden="true">
          {p.pics.slice(0, 3).map((f, j) => <img class="p3c-ing" data-j={j} {...img(`${V}/ingredienti/${p.k}/${f}`, 480)} alt="" loading="lazy" decoding="async" />)}
          <canvas class="p3c-cv" data-i={i}></canvas>
        </div>
        <div class="p3c-in">
          <p class="p3-k">0{i + 1} · {p.ml}</p>
          <h3 id={`p3c-${p.k}`}>{p.full}</h3>
          <p class="p3c-p">{p.desc} <span class="p3-note">{p.note}.</span></p>
          <p class="p3-price">Prezzo da confermare</p>
          <div class="p3c-btns"><button class="p3c-turn" type="button" data-i={i} aria-label={`Gira il barattolo ${p.n} per leggere l'etichetta`}>Gira</button><button class="p3-more" type="button" data-open={i}>Scheda</button></div>
          <a class="btn-pop fill p3c-cta" href={data[i].wa} target="_blank" rel="noopener">Chiedi in salone</a>
        </div>
      </article>
    ))}
  </div>
</section>

<div class="p3s" id="p3s" role="dialog" aria-modal="true" aria-labelledby="p3s-t" data-lenis-prevent tabindex="-1" hidden>
  <div class="p3s-pat"></div>
  <button class="p3s-x" type="button" aria-label="Chiudi la scheda"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  <div class="p3s-in">
    <div class="p3s-art"><img class="p3s-illu" alt="" /><canvas class="p3s-cv" aria-hidden="true"></canvas></div>
    <div class="p3s-tx">
      <p class="p3-k" id="p3s-k"></p><h2 id="p3s-t"></h2><p class="p3s-note" id="p3s-note"></p>
      <dl>
        <div><dt>Modo d'uso</dt><dd id="p3s-use"></dd></div>
        <div><dt>Ingredienti</dt><dd id="p3s-ing"></dd></div>
        <div><dt>Formato</dt><dd id="p3s-ml"></dd></div>
        <div><dt>Prezzo</dt><dd>Da confermare in salone</dd></div>
      </dl>
      <a class="btn-pop fill" id="p3s-wa" href={wa()} target="_blank" rel="noopener">Prenota e chiedilo a Fabio</a>
    </div>
  </div>
  <img class="p3s-pg" {...img(`${V}/personaggio/posa-barattolo`, 960)} alt="" loading="lazy" decoding="async" />
</div>
</div>
<script type="application/json" id="p3-data" set:html={JSON.stringify({ P: data, art })}></script>

<style is:global>
.sx-p3{display:contents;
.p3{position:relative;background:#F4EFE8;color:var(--ink)}
.p3-k{font:800 12px/1 var(--f-display);letter-spacing:.18em;text-transform:uppercase;color:var(--ac,#B8935A)}
.p3-price{font:800 13px/1 var(--f-display);letter-spacing:.08em;text-transform:uppercase;opacity:.8}
.p3-note{font-style:italic}
.p3-more,.p3c-turn{min-height:48px;padding:0 20px;border-radius:999px;border:2px solid currentColor;background:transparent;color:inherit;font:900 14px/1 var(--f-display);text-transform:uppercase;letter-spacing:.06em;cursor:pointer}
/* ---------- desktop pinned stage ---------- */
.p3-pin{display:none}
@media (min-width:1024px) and (prefers-reduced-motion:no-preference){
 .p3{height:calc((var(--n) + 1.4) * 100svh)}
 .p3 .p3m{display:none}
 .p3-pin{display:block;position:sticky;top:0;height:100svh;overflow:hidden;isolation:isolate}
 .p3-bgs,.p3-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
 .p3-bg{opacity:0;will-change:opacity}
 .p3-bg[data-i="0"]{opacity:1}   /* first screen is never empty, even before the script runs */
 .p3-titles{position:absolute;inset:0;z-index:1;display:grid;place-items:center;pointer-events:none}
 .p3-title{grid-area:1/1;font:900 clamp(120px,19vw,330px)/.8 var(--f-display);text-transform:uppercase;letter-spacing:-.05em;white-space:nowrap;opacity:.13;margin-top:-6vh;clip-path:inset(0 0 100% 0);will-change:clip-path,transform}
 .p3-ing{position:absolute;z-index:2;width:auto;translate:-50% -50%;opacity:0;will-change:transform,opacity;filter:drop-shadow(0 18px 18px rgb(0 0 0 / .25))}
 .p3-ing[data-l="0"]{z-index:1;filter:blur(1.5px) saturate(.9) drop-shadow(0 10px 10px rgb(0 0 0 / .15))}
 .p3-ing[data-l="2"]{z-index:5;filter:blur(5px) drop-shadow(0 26px 24px rgb(0 0 0 / .3))}
 .p3-cv{position:absolute;inset:0;z-index:3;width:100%;height:100%;cursor:grab;touch-action:pan-y;pointer-events:auto}
 .p3-cv.drag{cursor:grabbing}
 .p3-copy,.p3-chips{position:absolute;z-index:6;top:50%;translate:0 -50%}
 .p3-copy{left:var(--gutter);width:min(26vw,380px)}
 .p3-txt{position:absolute;inset:auto 0 auto 0;top:50%;translate:0 -50%;color:var(--ink);opacity:0;pointer-events:none;transition:opacity .35s}
 .p3-txt.on,.p3-txt[data-i="0"]:not(.off){opacity:1;pointer-events:auto}
 .p3-txt h3{margin-top:14px;font:900 clamp(34px,3.2vw,56px)/.9 var(--f-display);text-transform:uppercase;letter-spacing:-.02em}
 .p3-txt .p3-note{margin-top:8px;font-size:18px;color:var(--ac)}
 .p3-txt .p3-desc{margin-top:16px;font-size:17px;line-height:1.5;max-width:30ch}
 .p3-txt .p3-price{margin-top:16px}
 .p3-btns{display:flex;gap:10px;margin-top:22px;flex-wrap:wrap}
 .p3-chips{right:var(--gutter);width:0}
 .p3-chip{position:absolute;right:0;top:50%;translate:0 -50%;list-style:none;margin:0;padding:0;display:flex;flex-direction:column;align-items:flex-end;gap:10px;opacity:0;transition:opacity .35s}
 .p3-chip.on,.p3-chip[data-i="0"]:not(.off){opacity:1}
 .p3-chip li{white-space:nowrap;padding:10px 16px;border-radius:999px;border:2px solid var(--ink);color:var(--ink);font:800 14px/1 var(--f-display);text-transform:uppercase;letter-spacing:.04em;background:#F4EFE8}
 .p3-chip[data-i="3"] li:not(.ml){background:#0F6870}
 .p3-chip li.ml{background:var(--ink);color:#F4EFE8;border-color:var(--ink)}
 .p3-chip[data-i="3"] li.ml{color:#0F6870}
 .p3-line{position:absolute;inset:0;z-index:7;display:grid;align-content:center;justify-items:center;gap:3vh;opacity:0;pointer-events:none}
 .p3-line.on{pointer-events:auto}
 .p3-line-k{font:900 clamp(40px,5vw,84px)/.9 var(--f-display);text-transform:uppercase;color:#F4EFE8;letter-spacing:-.02em}
 .p3-line-row{display:flex;gap:2.5vw;align-items:flex-end}
 .p3-lj{display:grid;justify-items:center;gap:12px;background:none;border:0;color:#F4EFE8;font:900 16px/1 var(--f-display);text-transform:uppercase;letter-spacing:.06em;cursor:pointer;transition:transform .4s var(--ease-out)}
 .p3-lj:hover{transform:translateY(-8px)}
 .p3-lj canvas{width:min(17vw,250px);aspect-ratio:1.16}
 .p3-hint{position:absolute;z-index:6;left:50%;bottom:24px;translate:-50% 0;font:800 12px/1 var(--f-display);letter-spacing:.16em;text-transform:uppercase;color:var(--hint,#0F6870);opacity:.8;transition:opacity .4s}
}
/* ---------- phones / tablets / reduced motion: one card per product ---------- */
.p3c{position:relative;min-height:100svh;display:grid;grid-template-rows:min(50svh,118vw) auto;align-content:start;overflow:hidden;color:var(--ink,#F4EFE8);isolation:isolate}
.p3c>picture{position:absolute;inset:0;z-index:-1}
.p3c-bg{position:absolute;inset:0;z-index:-1;width:100%;height:100%;object-fit:cover}
.p3c-intro{grid-template-rows:auto;align-content:end;color:#F4EFE8;min-height:0}
.p3c-intro .p3c-in{padding-top:calc(var(--hdr,64px) + 48px)!important;padding-bottom:40px!important}
.p3c-intro .p3c-in{padding-bottom:calc(120px + env(safe-area-inset-bottom))}
.p3c-h{margin-top:12px;font:900 clamp(48px,14vw,72px)/.88 var(--f-display);text-transform:uppercase;letter-spacing:-.03em}
.p3c-stage{position:relative;min-height:0;grid-row:1;height:100%}
.p3c>.p3c-in{grid-row:2}
.p3c-intro>.p3c-in{grid-row:1}
.p3c-cv{position:absolute;left:4%;top:calc(var(--hdr,64px) + 2%);width:92%;height:calc(96% - var(--hdr,64px));touch-action:pan-y}
.p3c-ing{position:absolute;width:auto;height:13svh;filter:drop-shadow(0 12px 12px rgb(0 0 0 / .22));will-change:transform}
.p3c-ing[data-j="0"]{left:4%;top:calc(var(--hdr,64px) + 2%)}.p3c-ing[data-j="1"]{right:5%;top:14%;height:11svh}.p3c-ing[data-j="2"]{left:6%;bottom:16%;height:10svh}
.p3c-in{position:relative;padding:10px var(--gutter) calc(104px + env(safe-area-inset-bottom));display:grid;align-content:start;gap:10px}
.p3c-in h3{font:900 clamp(34px,10vw,48px)/.9 var(--f-display);text-transform:uppercase;letter-spacing:-.02em}
.p3c-p{font-size:16px;line-height:1.5;max-width:40ch}
.p3c-btns{display:flex;gap:10px;margin-top:4px}
.p3c-cta{width:100%;justify-content:center;min-height:56px;margin-top:6px}
@media (min-width:768px){.p3c{grid-template-columns:1fr 1fr;grid-template-rows:1fr;align-content:center;align-items:center}.p3c-stage{height:80svh;grid-column:1}.p3c>.p3c-in{grid-row:1;grid-column:2}.p3c-intro>.p3c-in{grid-column:1/-1}.p3c-in{padding:40px var(--gutter)}}
@media (prefers-reduced-motion:reduce){.p3c-ing{transform:none!important}}
/* ---------- product sheet ---------- */
.p3s{position:fixed;inset:0;z-index:calc(var(--z-header) + 5);overflow:auto;background:#F4EFE8;color:var(--ink);overscroll-behavior:contain}
.p3s[hidden]{display:none}
.p3s-pat{position:absolute;inset:0;background-size:420px;opacity:.22;pointer-events:none}
.p3s-x{position:fixed;right:max(16px,env(safe-area-inset-right));top:max(16px,env(safe-area-inset-top));z-index:3;width:48px;height:48px;border-radius:50%;border:0;background:var(--petrol);color:#F4EFE8;display:grid;place-items:center;cursor:pointer}
.p3s-in{position:relative;z-index:1;max-width:1240px;margin:0 auto;padding:clamp(72px,9vh,110px) var(--gutter) 60px;display:grid;gap:clamp(24px,4vw,64px);align-items:center}
.p3s-art{position:relative;display:grid;place-items:center}
.p3s-illu{width:min(100%,560px);height:auto}
.p3s-cv{position:absolute;left:50%;bottom:-4%;translate:-50% 0;width:min(52%,300px);aspect-ratio:1.16}
.p3s-tx h2{margin-top:12px;font:900 clamp(40px,5vw,76px)/.9 var(--f-display);text-transform:uppercase;letter-spacing:-.03em;color:var(--petrol)}
.p3s-note{margin-top:8px;font-size:19px;font-style:italic;color:var(--ink-soft)}
.p3s-tx dl{margin:24px 0 28px;display:grid;gap:0;border-top:1.5px solid rgb(15 104 112 / .25)}
.p3s-tx dl div{display:grid;grid-template-columns:150px 1fr;gap:16px;padding:14px 0;border-bottom:1.5px solid rgb(15 104 112 / .25)}
.p3s-tx dt{font:800 12px/1.4 var(--f-display);letter-spacing:.16em;text-transform:uppercase;color:var(--brass)}
.p3s-tx dd{margin:0;font-size:17px;line-height:1.5}
.p3s-pg{display:none}
@media (min-width:1024px){.p3s-in{grid-template-columns:1fr 1fr}.p3s-pg{display:block;position:fixed;right:2%;bottom:0;z-index:2;width:clamp(150px,13vw,220px);height:auto;pointer-events:none}}
@media (max-width:767px){.p3s-tx dl div{grid-template-columns:1fr;gap:4px}}
}
</style>

<script>
import { drawJar, loadArt, type JarArt } from '../scripts/jar';
import { lockScroll, trapTab } from '../scripts/core.js';
const { P, art } = JSON.parse(document.getElementById('p3-data')!.textContent!) as { P: any[]; art: Record<string, string> };
const N = P.length;
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
const desk = matchMedia('(min-width:1024px)').matches && !reduced;
const DPR = Math.min(3, devicePixelRatio || 1); // Physical pixel resolution, including Retina phones/tablets.
const arts: JarArt[] = [];
const sec = document.getElementById('prodotti')!;
sec.querySelector<HTMLAnchorElement>('.p3-skip')!.addEventListener('click', (e) => {
  e.preventDefault(); e.stopPropagation();
  const catalog = document.getElementById('catalogo')!;
  const y = catalog.getBoundingClientRect().top + scrollY;
  const lenis = (window as any).lenis;
  if (lenis) lenis.scrollTo(y, { immediate: true }); else scrollTo(0, y);
  document.documentElement.classList.remove('product-immersive');
  document.querySelector('.sx-header')?.removeAttribute('inert');
  history.replaceState(null, '', '#catalogo');
  document.getElementById('ct-t')?.focus({ preventScroll: true });
});
const sm = (x: number) => { x = Math.max(0, Math.min(1, x)); return x * x * (3 - 2 * x); };
const fitCanvas = (cv: HTMLCanvasElement) => { const r = cv.getBoundingClientRect(); const w = Math.round(r.width * DPR), h = Math.round(r.height * DPR); if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; } return { w: r.width, h: r.height }; };
const pendingArt: Array<Promise<JarArt> | undefined> = [];
function ensureArt(i: number) {
  return pendingArt[i] ??= loadArt({jar: DPR > 1 ? art.jar : art.jarS, light: DPR > 1 ? art.light : art.lightS, shadow: P[i].shadow, label: P[i].label}).then(value => { arts[i] = value; return value; });
}
let bootPromise: Promise<void> | null = null;
const boot = () => bootPromise ??= loadProducts();
async function loadProducts() {
  // First product becomes usable without waiting for all four labels.
  await ensureArt(0);
  desk ? startDesk() : startCards();
  stills();
  if (desk) for (let i = 1; i < N; i++) ensureArt(i).then(stills);
}
new IntersectionObserver((es, o) => { if (es.some((e) => e.isIntersecting)) { o.disconnect(); boot(); } }, { rootMargin: '600px 0px' }).observe(sec);

// ---------- static front views (line slide, sheet) ----------
function still(cv: HTMLCanvasElement, i: number, rot = 0) {
  if (!arts[i]) return;
  const { w, h } = fitCanvas(cv); const c = cv.getContext('2d')!; c.setTransform(DPR, 0, 0, DPR, 0, 0); c.clearRect(0, 0, w, h);
  drawJar(c, arts[i], w / 2, h * .92, w * .9, h * .8, rot);
}
function stills() { document.querySelectorAll<HTMLCanvasElement>('canvas[data-still]').forEach((cv) => still(cv, +cv.dataset.still!)); }

// ---------- desktop pinned stage ----------
function startDesk() {
  const cv = document.getElementById('p3-cv') as HTMLCanvasElement, c = cv.getContext('2d')!;
  const bgs = [...sec.querySelectorAll<HTMLElement>('.p3-bg')], titles = [...sec.querySelectorAll<HTMLElement>('.p3-title')];
  const txts = [...sec.querySelectorAll<HTMLElement>('.p3-txt')], chips = [...sec.querySelectorAll<HTMLElement>('.p3-chip')];
  const ings = [...sec.querySelectorAll<HTMLElement>('.p3-ing')], line = sec.querySelector<HTMLElement>('.p3-line')!, hint = sec.querySelector<HTMLElement>('.p3-hint')!;
  const fitT = () => titles.forEach((el) => { el.style.fontSize = ''; const max = innerWidth * .92, w = el.scrollWidth; if (w > max) el.style.fontSize = (parseFloat(getComputedStyle(el).fontSize) * max / w) + 'px'; });
  document.fonts.ready.then(fitT); fitT(); addEventListener('resize', fitT);
  let hover = 0, hoverTarget = 0;
  let shown = 0, drag = 0, dragV = 0, dragging: null | { x: number; d: number } = null, on = false, raf = 0, t0 = performance.now(), lastActive = -1;
  new IntersectionObserver((es) => { on = es[0].isIntersecting; if (on && !raf) raf = requestAnimationFrame(tick); }).observe(sec);
  cv.addEventListener('pointerdown', (e) => { dragging = { x: e.clientX, d: drag }; dragV = 0; cv.setPointerCapture(e.pointerId); cv.classList.add('drag'); });
  cv.addEventListener('pointerleave', () => { hoverTarget = 0; });
  cv.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') hoverTarget = ((e.clientX / innerWidth) - .5) * .5; if (!dragging) return; const nd = dragging.d + (e.clientX - dragging.x) / 900; dragV = nd - drag; drag = nd; });
  const up = () => { dragging = null; cv.classList.remove('drag'); };
  cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up);
  cv.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) { e.preventDefault(); dragV += e.deltaX / 3000; } }, { passive: false });
  let secTop = 0, span = 1, cw = 0, chh = 0;
  const measure = () => { secTop = sec.getBoundingClientRect().top + scrollY; span = sec.offsetHeight - innerHeight; const r = cv.getBoundingClientRect(); cw = r.width; chh = r.height; cv.width = Math.round(cw * DPR); cv.height = Math.round(chh * DPR); };
  measure(); addEventListener('resize', measure); addEventListener('load', measure);
  function tick(now: number) {
    raf = on ? requestAnimationFrame(tick) : 0;
    const target = Math.max(0, Math.min(1, (scrollY - secTop) / span)) * (N + 0.4);   // 0..N products, last 0.4 = the line
    shown += (target - shown) * .14;
    hover += (hoverTarget - hover) * .09;
    if (!dragging) { drag += dragV; dragV *= .9; drag *= .92; }            // inertia, then snaps back to the front
    const p = Math.min(shown, N - 1e-3), i = Math.floor(p), t = p - i;
    const lineK = sm((shown - (N - .15)) / .4);
    // which product is on stage, and the slide between two products in the last 22% of each segment
    const sw = sm((t - .78) / .22), nx = Math.min(N - 1, i + 1);
    bgs.forEach((b, k) => { b.style.opacity = String(k === N ? lineK : k === i ? 1 - (i < N - 1 ? sw : 0) : k === nx && i < N - 1 ? sw : 0); });
    const active = sw > .5 && i < N - 1 ? nx : i;
    if (active !== lastActive) { lastActive = active; txts.forEach((x, k) => { x.classList.toggle('on', k === active); x.classList.toggle('off', k !== active); x.querySelectorAll<HTMLElement>('a,button').forEach((b) => (b.tabIndex = k === active ? 0 : -1)); }); chips.forEach((x, k) => { x.classList.toggle('on', k === active); x.classList.toggle('off', k !== active); }); sec.style.setProperty('--hint', P[active].ink); }
    // copy fades out while the jars swap, so a moving jar never passes over readable text
    const swapK = i < N - 1 ? Math.abs(sw - .5) * 2 : 1, copyK = Math.min(swapK, 1 - lineK);
    txts.forEach((x, k) => { x.style.opacity = k === active ? String(copyK) : '0'; x.inert = k !== active || lineK > .6; });
    chips.forEach((x, k) => (x.style.opacity = k === active ? String(copyK) : '0'));
    hint.style.opacity = String((1 - lineK) * (shown < .15 ? 1 : .45));
    line.style.opacity = String(lineK); line.classList.toggle('on', lineK > .6); line.querySelectorAll('button').forEach((b) => (b.tabIndex = lineK > .6 ? 0 : -1));
    // giant titles: mask wipe up for the current, down for the next
    titles.forEach((el, k) => {
      let reveal = 0, dy = 0;
      if (k === i) { reveal = 1 - (i < N - 1 ? sw : 0); dy = -sw * 20; }
      else if (k === nx && i < N - 1) { reveal = sw; dy = (1 - sw) * 20; }
      reveal *= 1 - lineK;
      el.style.clipPath = `inset(${(1 - reveal) * 100}% 0 0 0)`; el.style.transform = `translateY(${dy}px)`;
    });
    // ingredients: three depth layers, own drift; enter from below, leave upward
    const time = (now - t0) / 1000;
    ings.forEach((el, k) => {
      const pi = +el.dataset.i!, l = +el.dataset.l!; let vis = 0, enter = 0;
      if (pi === i) { vis = 1 - (i < N - 1 ? sw : 0); enter = -sw; } else if (pi === nx && i < N - 1) { vis = sw; enter = 1 - sw; }
      vis *= 1 - lineK;
      const sp = [.5, .8, 1.2][l], amp = [8, 14, 22][l];
      const y = enter * 260 * (l + 1) / 2 + Math.sin(time * sp + k) * amp - t * 40 * (l + 1);
      const x = Math.cos(time * sp * .7 + k * 1.7) * amp * .8;
      el.style.opacity = String(vis); el.style.transform = `translate(${x}px,${y}px) rotate(${Math.sin(time * sp * .6 + k) * 8 + t * 20 * (l - 1)}deg) scale(${.96 + vis * .04})`;
    });
    // the jar: each product sweeps its label across the front (right panel, front, left panel)
    const w = cw, h = chh; c.setTransform(DPR, 0, 0, DPR, 0, 0); c.clearRect(0, 0, w, h);
    const jw = Math.min(w * .38, h * .68 * 1.21), jh = jw / 1.21, base = h * .78;
    const rotOf = (_tt: number) => hover + drag;   // front → side panel → front
    const jarAlpha = 1 - lineK;
    if (jarAlpha > .01) {
      c.globalAlpha = jarAlpha;
      const lift = Math.sin(Math.PI * Math.min(1, t / .78)) * jh * .04;
      if (i < N - 1 && sw > 0) {
        drawJar(c, arts[i], w / 2 - sw * w * .62, base, jw, jh, rotOf(t), lift);
        drawJar(c, arts[nx], w / 2 + (1 - sw) * w * .62, base, jw, jh, rotOf(0), 0);
      } else drawJar(c, arts[i], w / 2, base, jw, jh, rotOf(Math.min(1, t / .78)), lift);
      c.globalAlpha = 1;
    }
  }
}

// ---------- phone cards ----------
function startCards() {
  const cards = [...sec.querySelectorAll<HTMLCanvasElement>('.p3c-cv')];
  const st = cards.map(() => ({ rot: 0, v: 0, target: null as null | number, vis: false, drag: null as null | { x: number; r: number } }));
  const io = new IntersectionObserver((es) => es.forEach((e) => { const k = cards.indexOf(e.target as HTMLCanvasElement); st[k].vis = e.isIntersecting; if (e.isIntersecting) { ensureArt(k); if (!reduced) st[k].target = 0; } }), { threshold: .35 });
  cards.forEach((cv, k) => {
    io.observe(cv);
    cv.addEventListener('pointerdown', (e) => { st[k].drag = { x: e.clientX, r: st[k].rot }; st[k].target = null; cv.setPointerCapture(e.pointerId); });
    cv.addEventListener('pointermove', (e) => { const s = st[k]; if (!s.drag) return; const nr = s.drag.r - (e.clientX - s.drag.x) / (cv.clientWidth * 2.2); s.v = nr - s.rot; s.rot = nr; });
    const up = () => { st[k].drag = null; }; cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up); cv.addEventListener('pointerleave', up);
  });
  sec.querySelectorAll<HTMLButtonElement>('.p3c-turn').forEach((b) => b.addEventListener('click', () => { const s = st[+b.dataset.i!]; const side = Math.abs(s.rot) < .15 ? .3 : 0; s.target = side; b.textContent = side ? 'Davanti' : 'Gira'; }));
  let last = performance.now();
  const painted = cards.map(() => ({rot: NaN, width: 0, height: 0}));
  const frame = (now: number) => {
    requestAnimationFrame(frame); const dt = Math.min(.05, (now - last) / 1000); last = now;
    cards.forEach((cv, k) => {
      const s = st[k]; if (!s.vis || !arts[k]) return;
      if (!s.drag) {
        if (s.target !== null) { s.rot += (s.target - s.rot) * Math.min(1, dt * 4); if (Math.abs(s.target - s.rot) < .002) s.target = null; }
        else if (Math.abs(s.v) > .0005) { s.rot += s.v; s.v *= .92; }
        else s.v = 0;                                 // 6°/s when idle
      }
      const { w, h } = fitCanvas(cv);
      const prev = painted[k], rotation = reduced ? 0 : s.rot;
      if (Math.abs(prev.rot - rotation) < .0001 && prev.width === cv.width && prev.height === cv.height) return;
      painted[k] = {rot: rotation, width: cv.width, height: cv.height};
      const c = cv.getContext('2d')!; c.imageSmoothingQuality = 'high'; c.setTransform(DPR, 0, 0, DPR, 0, 0); c.clearRect(0, 0, w, h);
      const jh = Math.min(h * .78, (w * .82) / 1.21);               // jar box ratio (opaque part) is ~1.21:1
      drawJar(c, arts[k], w / 2, h / 2 + jh / 2, w * .82, jh, reduced ? 0 : s.rot);
    });
  };
  requestAnimationFrame(frame);
}

// ---------- product sheet ----------
const sheet = document.getElementById('p3s')!; let back: HTMLElement | null = null;
sheet.addEventListener('keydown', (e) => trapTab(e, sheet));
const $ = (id: string) => document.getElementById(id)!;
function openSheet(i: number, from: HTMLElement) {
  const p = P[i]; back = from;
  $('p3s-k').textContent = `${p.ml} · Glamood`; $('p3s-t').textContent = p.full; $('p3s-note').textContent = p.note;
  $('p3s-use').textContent = p.use; $('p3s-ing').textContent = p.ing.join(', ') + ' (elenco completo in arrivo)'; $('p3s-ml').textContent = p.ml;
  ($('p3s-wa') as HTMLAnchorElement).href = p.wa;
  (sheet.querySelector('.p3s-illu') as HTMLImageElement).src = p.illu;
  (sheet.querySelector('.p3s-pat') as HTMLElement).style.backgroundImage = `url(${p.pattern})`;
  sheet.hidden = false; document.documentElement.classList.add("product-sheet-open"); sec.setAttribute("inert", ""); document.querySelector(".site-header")?.setAttribute("inert", ""); lockScroll(true); sheet.focus();
  if (arts[i]) requestAnimationFrame(() => still(sheet.querySelector('.p3s-cv') as HTMLCanvasElement, i));
}
function closeSheet() { if (sheet.hidden) return; sheet.hidden = true; document.documentElement.classList.remove("product-sheet-open"); sec.removeAttribute("inert"); document.querySelector(".site-header")?.removeAttribute("inert"); lockScroll(false); back?.focus({ preventScroll: true }); }
sec.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => { const i = +b.dataset.open!; Promise.all([boot(), ensureArt(i)]).then(() => openSheet(i, b)); }));
sheet.querySelector('.p3s-x')!.addEventListener('click', closeSheet);
addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSheet(); });
</script>
