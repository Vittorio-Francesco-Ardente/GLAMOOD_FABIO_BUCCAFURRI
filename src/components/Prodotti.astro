---
// Kit 11: Brambleroot framed panel with the hero band (two tilted jars on the relief texture),
// TOP 3 slider (Domingo reference: pinned, scroll changes product), "Tutta la linea" catalogue
// (Pepsi reference: GSAP Flip to a spec panel), split panel and three outlined cards "Come si usano".
import Img from './Img.astro';
import { img } from '../data/img';
import { top3, catalog } from '../data/products';
import { wa, waText, business, instagramUrl } from '../data/business';
const arrow = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="${d}"/></svg>`;
const catData = Object.fromEntries(Object.entries(catalog).map(([k, v]) => [k, { ...v, img: img(v.img, 960).src, wa: wa(waText.info(v.n)) }]));
---
<div class="sx-prodotti">
<div class="page-frame">
<section class="panel panel-cream panel-outline" id="prodotti" aria-labelledby="prodotti-t">
  <div class="band"><div class="bgref r-rilievo-swirl"></div>
    <p class="band-k">La linea Glamood · lo stile si porta a casa</p>
    <h2 class="band-t" id="prodotti-t" aria-label="La linea Glamood">Fatti tuoi</h2>
    <div class="jars"><img class="j1" {...img('prodotti/barattolo-cera', 960)} alt="Barattolo Glamood cera" loading="lazy" /><img class="j2" {...img('prodotti/barattolo-pomata', 960)} alt="Barattolo Glamood pomata" loading="lazy" /></div>
    <img class="peel" {...img('sticker/top', 480)} alt="Adesivo TOP" loading="lazy" style="right:clamp(16px,8vw,140px);bottom:22%" />
    <a class="btn-pop" href={wa(waText.info('i prodotti Glamood'))} target="_blank" rel="noopener">Chiedili in salone!</a>
  </div>
  <div class="top3" id="top3" style="--bg:#0F6870" tabindex="0" aria-roledescription="carosello" aria-label="I tre prodotti più usati, scorri in orizzontale">
    <div class="t3-head"><p class="t3-k">I tre che Fabio usa di più</p><div class="t3-dots" role="tablist" aria-label="Prodotti">{top3.map((p, i) => <button role="tab" aria-label={`0${i + 1} ${p.n}`} data-i={i}>0{i + 1}</button>)}</div></div>
    {top3.map((p, i) => (
      <article class="t3" data-i={i} data-bg={p.bg} style={`--tc:${p.tc};--ink:${p.ink}`} aria-label={p.n}>
        <p class="t3-num">0{i + 1}</p>
        <h3 class="t3-title" aria-hidden="true">{p.n}</h3>
        <div class="t3-parts"><img class="pt p1" {...img(p.parts[0], 480)} alt="" loading="lazy" /><img class="pt p2" {...img(p.parts[1], 480)} alt="" loading="lazy" /></div>
        <div class="t3-jw"><img class="t3-jar" {...img(p.img, 960)} alt={`Barattolo Glamood ${p.n}`} loading="lazy" /></div>
        <div class="t3-desc"><span class="dash"></span><h4>{p.n} Glamood</h4><p>{p.desc}</p></div>
        <div class="t3-acc">
          <details><summary>Come si usa<i></i></summary><p>Una noce tra le mani, su capello asciutto, poi dai la forma.</p></details>
          <details><summary>Per chi<i></i></summary><p>Fabio ti dice se è giusta per il tuo taglio, sulla poltrona.</p></details>
          <details><summary>Dove trovarla<i></i></summary><p>In salone, {business.address}.</p></details>
        </div>
      </article>
    ))}
    <div class="t3-nav"><button class="t3-prev" aria-label="Prodotto precedente" set:html={arrow('M15 5l-7 7 7 7')} /><button class="t3-next" aria-label="Prodotto successivo" set:html={arrow('M9 5l7 7-7 7')} /></div>
  </div>
  <div class="cat" id="cat">
    <div class="cat-line" aria-hidden="true"><i id="catLine"></i></div>
    <div class="cat-grid" id="catGrid">
      <div class="cat-head"><p class="t3-k">Tutta la linea</p><h3>Scegli il tuo barattolo</h3></div>
      <div class="cat-row">{Object.entries(catalog).map(([k, v]) => <button class="ci" data-k={k} aria-label={`Apri la scheda: ${v.n}`}><img {...img(v.img, 480)} alt="" loading="lazy" /><span>{v.n}</span></button>)}</div>
      <p class="cat-hint">Tocca un barattolo per la scheda</p>
    </div>
    <div class="cat-detail" id="catDetail" hidden>
      <div class="cd-panel">
        <button class="cd-back" id="cdBack" aria-label="Torna a tutti i prodotti" set:html={arrow('M19 12H5M11 6l-6 6 6 6')} />
        <h3 id="cdName"></h3><p id="cdDesc"></p>
        <a class="btn-pop" id="cdWa" href={wa()} target="_blank" rel="noopener">Chiedi info su WhatsApp</a>
      </div>
      <div class="cd-jar"><img id="cdJar" alt="" width="960" height="960" /></div>
    </div>
  </div>
</section>
<section class="panel panel-cream panel-outline" aria-labelledby="uso-t">
  <div class="checker"></div>
  <div class="split">
    <div class="ph"><img {...img('prodotti/barattolo-crema-styling', 960)} alt="" loading="lazy" /></div>
    <div class="tx"><h2 class="type-pop" id="uso-t">Una noce.<br />Tutto il giorno.</h2>
      <p>Fabio usa questi barattoli ogni giorno sulla poltrona. Ti mostra quanto metterne e come stenderlo, così a casa il taglio resta come appena uscito dal salone.</p>
      <p class="soft">Descrizioni, formati e prezzi li trovi in salone.</p></div>
  </div>
  <div class="how">
    <h2 class="type-pop">Il trucco del barbiere</h2>
    <p class="lead">Tre passaggi, quelli che Fabio ti spiega alla fine del taglio.</p>
    <div class="cards wrap2">
      <div class="c"><Img src="salone/salone-03" alt="" sizes="(min-width:1024px) 30vw, 90vw" style="object-position:50% 40%" /><h3>Capello asciutto</h3><p>Si parte da capelli puliti e asciutti</p></div>
      <div class="c"><Img src="prodotti/barattoli-4-insieme" alt="" sizes="(min-width:1024px) 30vw, 90vw" style="object-fit:contain;background:var(--petrol-pale);padding:14px" /><h3>Una noce</h3><p>Scaldi tra le mani, poca quantità</p></div>
      <div class="c"><Img src="salone/salone-11-titolare" alt="" sizes="(min-width:1024px) 30vw, 90vw" style="object-position:72% 40%" /><h3>Dai la forma</h3><p>Con le dita o con il pettine</p></div>
    </div>
  </div>
</section>
</div>
</div>
<script type="application/json" id="cat-data" set:html={JSON.stringify(catData)}></script>

<style is:global>
.sx-prodotti{display:contents;
.wrap2{max-width:1320px;margin:0 auto}
.band{position:relative;margin:clamp(12px,1.6vw,22px);border-radius:clamp(14px,1.8vw,24px);overflow:hidden;min-height:clamp(420px,48vw,640px);background:var(--petrol)}
.band::after{content:"";position:absolute;inset:0;z-index:1;background:radial-gradient(70% 80% at 50% 55%,transparent,rgb(8 57 62 / .32));pointer-events:none}
.band-k{position:absolute;z-index:3;left:50%;top:7%;transform:translateX(-50%);font:800 13px/1 var(--f-display);letter-spacing:.16em;text-transform:uppercase;color:#F4EFE8;background:rgb(8 57 62 / .55);padding:10px 16px;border-radius:999px;white-space:nowrap}
.band-t{position:absolute;z-index:1;left:50%;top:14%;transform:translateX(-50%);font-family:"Archivo X","Archivo",sans-serif;font-stretch:125%;font-weight:900;font-size:clamp(70px,13vw,230px);line-height:.85;letter-spacing:-.03em;text-transform:uppercase;color:#83C8C2;white-space:nowrap}
.jars{position:absolute;inset:18% 0 12%;z-index:2;display:flex;justify-content:center;align-items:center;gap:0}
.jars img{width:clamp(200px,26vw,400px);height:auto;filter:drop-shadow(18px 34px 26px rgb(0 0 0 / .45))}
.jars .j1{transform:rotate(-14deg) translate(10%,4%)}
.jars .j2{transform:rotate(11deg) translate(-10%,-6%)}
.band .peel{z-index:3;height:auto}
.band .btn-pop{position:absolute;z-index:3;left:50%;bottom:8%;transform:translateX(-50%);min-height:60px;font-size:clamp(16px,1.4vw,22px)}
.band .btn-pop:hover{transform:translate(calc(-50% - 1px),-1px)}
.band .btn-pop:active{transform:translate(calc(-50% + 4px),5px)}
/* TOP 3 */
.top3{position:relative;height:100svh;min-height:600px;background:var(--bg);transition:background-color .9s var(--ease-out);overflow:hidden;color:var(--ink,#F4EFE8)}
.t3-head{position:absolute;z-index:6;left:0;right:0;top:0;display:flex;justify-content:space-between;align-items:center;padding:clamp(18px,2.4vw,34px) clamp(20px,4vw,64px)}
.t3-k{font:800 13px/1 var(--f-display);letter-spacing:.14em;text-transform:uppercase;color:var(--hk,#F4EFE8);transition:color .6s}
.t3-dots{display:flex;gap:8px}
.t3-dots button{width:44px;height:30px;border-radius:999px;border:1.5px solid var(--hk,#F4EFE8);color:var(--hk,#F4EFE8);font:800 12px var(--f-display);opacity:.55;transition:all .4s}
.t3-dots button[aria-selected=true]{opacity:1;background:var(--hk,#F4EFE8);color:var(--bg)}
.t3{position:absolute;inset:0;visibility:hidden;color:var(--ink)}
.t3.on{visibility:visible}
.t3-num{position:absolute;z-index:3;left:clamp(20px,9vw,150px);top:clamp(90px,17svh,170px);font:300 clamp(48px,6vw,96px)/1 var(--f-display);color:var(--ink)}
.t3-title{position:absolute;z-index:1;left:50%;transform:translateX(-50%);width:max-content;top:calc(clamp(90px,17svh,170px) + clamp(40px,4.6vw,76px));text-align:center;font-family:"Archivo X","Archivo",sans-serif;font-stretch:125%;font-weight:900;font-size:clamp(90px,17.5vw,330px);line-height:.8;letter-spacing:-.03em;text-transform:uppercase;color:var(--tc);white-space:nowrap}
.t3-jw{position:absolute;z-index:4;left:0;right:0;top:calc(clamp(90px,17svh,170px) + clamp(40px,4.6vw,76px));bottom:clamp(60px,9svh,100px);display:grid;place-items:center;pointer-events:none}
.t3-jar{width:clamp(240px,30vw,480px);height:auto;max-height:100%;object-fit:contain;filter:drop-shadow(0 40px 40px rgb(0 0 0 / .35));will-change:transform}
.t3-parts .pt{position:absolute;z-index:0;height:auto;filter:drop-shadow(0 18px 18px rgb(0 0 0 / .3));will-change:transform}
.pt.p1{width:clamp(90px,10vw,170px);left:calc(50% + clamp(150px,16vw,290px));top:50%;transform:rotate(18deg)}
.pt.p2{width:clamp(80px,8vw,140px);left:calc(50% - clamp(220px,22vw,380px));top:62%;transform:rotate(-24deg)}
.t3-desc{position:absolute;z-index:6;left:clamp(20px,9vw,150px);bottom:clamp(70px,11svh,120px);max-width:30ch}
.t3-desc .dash{display:block;width:40px;height:2px;background:var(--ink);margin-bottom:18px}
.t3-desc h4{font:900 clamp(16px,1.3vw,20px)/1 var(--f-display);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px}
.t3-desc p{font-size:clamp(14px,1.05vw,16px);line-height:1.5;opacity:.9}
.t3-acc{position:absolute;z-index:6;right:clamp(20px,6vw,110px);bottom:clamp(70px,11svh,120px);width:min(340px,30vw)}
.t3-acc details{border-bottom:1.5px solid color-mix(in srgb,var(--ink) 45%,transparent)}
.t3-acc summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:14px 0;min-height:44px;font:800 14px var(--f-display);text-transform:uppercase;letter-spacing:.04em}
.t3-acc summary::-webkit-details-marker{display:none}
.t3-acc summary i{position:relative;width:14px;height:14px}
.t3-acc summary i::before,.t3-acc summary i::after{content:"";position:absolute;left:0;top:6px;width:14px;height:2px;background:currentColor;transition:transform .3s}
.t3-acc summary i::after{transform:rotate(90deg)}
.t3-acc details[open] summary i::after{transform:rotate(0)}
.t3-acc p{font-size:14px;opacity:.85;padding:0 0 14px}
.t3-nav{position:absolute;z-index:7;left:50%;bottom:clamp(92px,12svh,110px);transform:translateX(-50%);display:flex;gap:10px}
.t3-nav button{width:48px;height:48px;border-radius:50%;background:var(--hk,#F4EFE8);color:var(--bg);display:grid;place-items:center;box-shadow:0 10px 20px -10px rgb(0 0 0 / .5)}
.t3-nav svg{width:20px}
.t3-nav button[hidden]{display:none}
@media (max-width:900px){
 .t3-num{left:20px;top:84px;font-size:44px}
 .t3-title{top:128px;font-size:clamp(70px,20vw,170px)}
 .t3-jw{top:200px;bottom:230px}.t3-jar{width:min(66vw,340px)}
 .pt.p1{left:auto;right:4%;top:30%;width:22vw}.pt.p2{left:4%;top:52%;width:20vw}
 .t3-desc{left:20px;right:20px;bottom:150px;max-width:none}
 .t3-desc .dash{margin-bottom:10px}
 .t3-acc{left:20px;right:20px;width:auto;bottom:150px}
 .t3-desc{bottom:220px}
 .t3-jw{bottom:290px}
 .t3-acc details:not(:first-child){display:none}
}
@media (max-width:900px) and (max-height:760px){.t3-desc p{display:none}}
/* ALL PRODUCTS */
.cat{position:relative;min-height:100svh;background:radial-gradient(120% 90% at 50% 10%,color-mix(in srgb,var(--cbg,#0F6870) 80%,#fff 8%),var(--cbg,#0F6870) 60%,color-mix(in srgb,var(--cbg,#0F6870) 70%,#000));transition:background-color .8s;color:#F4EFE8;overflow:hidden;display:grid}
.cat-social{position:absolute;z-index:5;left:clamp(14px,2.4vw,36px);top:50%;transform:translateY(-50%);list-style:none;display:grid;gap:18px}
.cat-social a{display:grid;place-items:center;width:44px;height:44px;color:#cfe3e1;opacity:.8}.cat-social svg{width:18px}
.cat-line{position:absolute;z-index:5;right:clamp(14px,2.4vw,36px);top:30%;bottom:30%;width:2px;background:rgb(244 239 232 / .2)}
.cat-line i{position:absolute;left:0;top:0;width:100%;height:25%;background:#F4EFE8;transition:top .6s var(--ease-out)}
.cat-grid{padding:clamp(70px,10svh,120px) clamp(60px,8vw,140px) clamp(40px,6svh,70px);display:grid;align-content:center;gap:clamp(24px,4svh,48px)}
.cat-head h3{font:900 clamp(34px,4.4vw,72px)/.95 var(--f-display);text-transform:uppercase;letter-spacing:-.02em;margin-top:10px}
.cat-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(16px,3vw,50px);align-items:end}
.ci{display:grid;justify-items:center;gap:16px;color:#F4EFE8;transition:opacity .4s,transform .5s var(--ease-out)}
.ci img{width:100%;max-width:260px;height:auto;filter:drop-shadow(0 26px 24px rgb(0 0 0 / .4));transition:transform .5s var(--ease-out)}
.ci span{font:800 clamp(13px,1vw,16px) var(--f-display);text-transform:uppercase;letter-spacing:.06em}
@media (hover:hover){.cat-row:hover .ci{opacity:.45}.cat-row .ci:hover{opacity:1}.ci:hover img{transform:translateY(-14px) rotate(-3deg) scale(1.04)}}
.ci:focus-visible img{transform:translateY(-14px) rotate(-3deg) scale(1.04)}
.cat-hint{font:800 12px var(--f-display);letter-spacing:.14em;text-transform:uppercase;color:#cfe3e1;text-align:center}
.cat-detail{position:absolute;inset:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;padding:clamp(70px,10svh,120px) clamp(60px,8vw,140px)}
.cat-detail[hidden]{display:none}
.cd-panel{display:grid;gap:14px;justify-items:start;max-width:520px}
.cd-back{width:46px;height:46px;border-radius:50%;border:1.5px solid rgb(244 239 232 / .6);display:grid;place-items:center;color:#F4EFE8;margin-bottom:10px}.cd-back svg{width:20px}
.cd-panel h3{font:900 clamp(40px,5vw,84px)/.92 var(--f-display);text-transform:uppercase;letter-spacing:-.02em}
.cd-panel p{color:#d9ebe8;max-width:40ch}
.cd-k{font:800 12px var(--f-display)!important;letter-spacing:.16em;text-transform:uppercase;margin-top:10px;color:#F4EFE8!important}
.cd-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;width:100%}
.cd-facts div{background:rgb(244 239 232 / .12);border:1px solid rgb(244 239 232 / .25);border-radius:10px;padding:12px 10px;text-align:center}
.cd-facts small{display:block;font:700 10px var(--f-body);letter-spacing:.12em;text-transform:uppercase;color:#cfe3e1}
.cd-facts b{display:block;font:900 clamp(13px,1.1vw,17px)/1.1 var(--f-display);text-transform:uppercase;margin-top:6px}
.cd-jar{display:grid;place-items:center}
.cd-jar img{width:min(100%,560px);height:auto;filter:drop-shadow(0 40px 40px rgb(0 0 0 / .45))}
@media (max-width:900px){
 .cat-social,.cat-line{display:none}
 .cat-grid{padding:70px 20px 40px}
 .cat-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 16px}
 .cat-detail{grid-template-columns:1fr;grid-template-rows:auto auto;padding:70px 20px 40px;align-content:start;gap:10px}
 .cd-jar{order:-1}.cd-jar img{width:min(70vw,320px)}
 .cd-facts{grid-template-columns:repeat(2,minmax(0,1fr))}
}
/* split + how */
.split{display:grid;grid-template-columns:5fr 7fr}
.split .ph{position:relative;background:var(--petrol) url("/img/pattern/liquido-petrolio.webp") center/600px;min-height:420px;overflow:hidden}
.split .ph img{position:absolute;left:50%;top:54%;width:min(62%,420px);height:auto;transform:translate(-50%,-50%) rotate(-6deg);filter:drop-shadow(0 30px 30px rgb(0 0 0 / .5))}
.split .tx{padding:clamp(36px,5vw,80px)}
.split .tx h2{font-size:clamp(36px,4.4vw,72px)}
.split .tx p{margin-top:22px;max-width:52ch;font-weight:600;text-transform:uppercase;font-size:14px;letter-spacing:.03em;line-height:1.7;color:var(--ink)}
.split .tx p.soft{color:var(--ink-soft);text-transform:none;font-weight:500}
.how{padding:clamp(40px,6vw,90px) var(--gutter);text-align:center;border-top:3px solid var(--petrol)}
.how h2{font-size:clamp(44px,6vw,100px)}
.how .lead{margin:16px auto 0;color:var(--petrol);font-weight:700;text-transform:uppercase;font-size:14px;letter-spacing:.06em;max-width:52ch}
.how .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,2vw,30px);margin-top:44px}
.how .c{border:3px solid var(--petrol);border-radius:18px;overflow:hidden;background:var(--cream);box-shadow:6px 7px 0 var(--petrol);text-align:center}
.how .c img{width:100%;aspect-ratio:16/10;object-fit:cover;border-bottom:3px solid var(--petrol)}
.how .c h3{font:900 clamp(20px,1.7vw,26px)/1 var(--f-display);text-transform:uppercase;color:var(--petrol);padding:20px 16px 6px}
.how .c p{font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);padding:0 18px 22px}
@media (max-width:1023px){.split{grid-template-columns:1fr}.how .cards{grid-template-columns:1fr;max-width:460px;margin-inline:auto}}
@media (max-width:767px){
 .band{min-height:520px}
 .band-t{font-size:12.5vw;top:18%}
 .band-k{font-size:10px;white-space:normal;text-align:center;max-width:86%;line-height:1.3}
 .jars{top:24%;bottom:12%}.jars img{width:44vw}
 .band .peel{display:none}
 /* Phone: genuine document flow, without fixed-height absolute caption blocks. */
 .top3{height:auto;min-height:0;display:flex;flex-direction:column;overflow:hidden;padding-bottom:calc(28px + env(safe-area-inset-bottom))}
 .top3 .t3-head{position:relative;inset:auto;flex:none;align-items:center;padding:20px 18px 12px;gap:10px}
 .top3 .t3-k{font-size:11px;line-height:1.3;max-width:18ch}
 .top3 .t3-dots{gap:5px}.top3 .t3-dots button{width:36px;height:32px;flex:none}
 .top3 .t3{position:relative;inset:auto;display:none;visibility:hidden;padding:0 18px;min-height:0;min-width:0;
  grid-template-columns:minmax(0,1fr);grid-template-areas:"number" "title" "visual" "description" "instructions"}
 .top3 .t3.on{display:grid;visibility:visible}
 .top3 .t3-num{grid-area:number;position:relative;inset:auto;font-size:clamp(37px,11vw,54px);line-height:1;margin:12px 0 4px}
 .top3 .t3-title{grid-area:title;position:relative;inset:auto;width:100%;min-width:0;transform:none;white-space:nowrap;
  font-size:clamp(54px,16vw,94px);line-height:.9;text-align:center;letter-spacing:-.035em;margin:0 0 6px}
 .top3 .t3-parts{grid-area:visual;position:relative;z-index:1;min-height:clamp(235px,34svh,315px);pointer-events:none}
 .top3 .t3-parts .pt{max-width:74px;opacity:.7;pointer-events:none}
 .top3 .pt.p1{left:auto;right:2%;top:13%;width:15vw}
 .top3 .pt.p2{display:none}
 .top3 .t3-jw{grid-area:visual;position:relative;inset:auto;z-index:2;
  min-height:clamp(235px,34svh,315px);height:clamp(235px,34svh,315px);display:grid;place-items:center;pointer-events:none}
 .top3 .t3-jar{width:min(62vw,300px);max-width:100%;max-height:270px;height:auto;object-fit:contain;
  filter:drop-shadow(0 24px 24px rgb(0 0 0 / .25))}
 .top3 .t3-desc{grid-area:description;position:relative;inset:auto;width:100%;max-width:none;min-width:0;z-index:5;margin:12px 0 0}
 .top3 .t3-desc .dash{margin:0 0 12px}
 .top3 .t3-desc h4{font-size:clamp(17px,4.4vw,20px);line-height:1.2;margin:0 0 8px;overflow-wrap:break-word}
 .top3 .t3-desc p{display:block;font-size:14px;line-height:1.5;margin:0}
 .top3 .t3-acc{grid-area:instructions;position:relative;inset:auto;width:100%;max-width:none;min-width:0;z-index:5;margin:18px 0 0}
 .top3 .t3-acc summary{min-height:48px;padding:12px 0;line-height:1.3}
 .top3 .t3-acc p{font-size:14px;line-height:1.5;margin:0;padding-bottom:14px}
 .top3 .t3-nav{position:relative;inset:auto;transform:none;flex:none;margin:24px auto 0;align-self:center;justify-content:center;gap:14px;z-index:8}
 .top3 .t3-nav button{width:48px;height:48px}
}
@media (prefers-reduced-motion:reduce){.top3{height:auto;min-height:0}.t3{position:relative;visibility:visible;min-height:100svh}}
}
</style>

<script>
import { reduced } from '../scripts/core.js';
import { gsap, ScrollTrigger, Flip } from '../scripts/motion.js';
// TOP 3: pinned, the scroll moves through the three products; dots, arrows, keys jump to one
(() => {
  const box = document.getElementById('top3')!, sl = [...box.querySelectorAll<HTMLElement>('.t3')], dots = [...box.querySelectorAll<HTMLButtonElement>('.t3-dots button')];
  let cur = -1;
  function show(i: number, dir = 1) {
    if (i === cur) return; const prev = sl[cur]; cur = i; const s = sl[i];
    box.style.setProperty('--bg', s.dataset.bg!); const light = s.dataset.bg!.toUpperCase() === '#F4EFE8'; box.style.setProperty('--hk', light ? '#0F6870' : '#F4EFE8');
    dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === i)));
    box.querySelector<HTMLElement>('.t3-prev')!.hidden = i === 0; box.querySelector<HTMLElement>('.t3-next')!.hidden = i === sl.length - 1;
    if (matchMedia('(max-width:767px)').matches) {
      sl.forEach(slide => {
        const pieces=slide.querySelectorAll('.t3-title,.t3-jar,.pt,.t3-num,.t3-desc,.t3-acc');
        gsap.killTweensOf(pieces);gsap.set(pieces,{clearProps:'transform,opacity'});
        slide.classList.toggle('on',slide===s);
      });
      return;
    }
    if (prev) {
      gsap.to(prev.querySelector('.t3-title'), { yPercent: -60 * dir, opacity: 0, duration: 0.6, ease: 'power3.in' });
      gsap.to(prev.querySelector('.t3-jar'), { xPercent: -90 * dir, rotate: -14 * dir, opacity: 0, duration: 0.6, ease: 'power3.in' });
      gsap.to(prev.querySelectorAll('.pt'), { y: -120 * dir, opacity: 0, duration: 0.5, stagger: 0.04, ease: 'power2.in' });
      gsap.to(prev.querySelectorAll('.t3-num,.t3-desc,.t3-acc'), { opacity: 0, duration: 0.35, onComplete: () => prev.classList.remove('on') });
    }
    s.classList.add('on');
    gsap.fromTo(s.querySelector('.t3-title'), { yPercent: 60 * dir, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 1, delay: 0.25, ease: 'expo.out' });
    gsap.fromTo(s.querySelector('.t3-jar'), { xPercent: 90 * dir, rotate: 14 * dir, opacity: 0 }, { xPercent: 0, rotate: 0, opacity: 1, duration: 1.2, delay: 0.3, ease: 'expo.out' });
    gsap.fromTo(s.querySelectorAll('.pt'), { y: 140 * dir, opacity: 0 }, { y: 0, opacity: 1, duration: 1.2, delay: 0.45, stagger: 0.08, ease: 'expo.out' });
    gsap.fromTo(s.querySelectorAll('.t3-num,.t3-desc,.t3-acc'), { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, delay: 0.5, stagger: 0.06, ease: 'expo.out' });
  }
  // fit each giant name to the width so it is never cut
  const fit = () => sl.forEach((s) => { const t = s.querySelector<HTMLElement>('.t3-title')!; t.style.fontSize = ''; const max = box.clientWidth * 0.94; const w = t.scrollWidth; if (w > max) t.style.fontSize = (parseFloat(getComputedStyle(t).fontSize) * max) / w + 'px'; });
  fit(); addEventListener('resize', fit); document.fonts.ready.then(fit);
  if (reduced) { sl.forEach((s) => s.classList.add('on')); box.querySelector<HTMLElement>('.t3-nav')!.hidden = true; box.querySelector<HTMLElement>('.t3-dots')!.hidden = true; return; }
  if (!matchMedia('(max-width:767px)').matches)
    sl.forEach((s) => s.querySelectorAll('.pt').forEach((p, k) => gsap.to(p, { yPercent: k % 2 ? 12 : -12, rotation: '+=8', duration: 2.6 + k * 0.5, repeat: -1, yoyo: true, ease: 'sine.inOut' })));
  show(0);
  // horizontal carousel: arrows, dots, keys and swipe change the product (no scroll hijack)
  const go = (i: number) => { i = Math.max(0, Math.min(sl.length - 1, i)); if (i !== cur) show(i, i > cur ? 1 : -1); };
  let sx = 0, sy = 0, sw = false;
  box.addEventListener('pointerdown', (e) => { if ((e.target as Element).closest('button,a,summary')) return; sx = e.clientX; sy = e.clientY; sw = true; });
  box.addEventListener('pointerup', (e) => { if (!sw) return; sw = false; const dx = e.clientX - sx, dy = e.clientY - sy; if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(cur + (dx < 0 ? 1 : -1)); });
  box.addEventListener('pointercancel', () => (sw = false));
  box.style.touchAction = 'pan-y';
  dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
  box.querySelector('.t3-prev')!.addEventListener('click', () => go(cur - 1)); box.querySelector('.t3-next')!.addEventListener('click', () => go(cur + 1));
  box.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(cur + 1); if (e.key === 'ArrowLeft') go(cur - 1); });
})();

// ALL PRODUCTS: FLIP from grid to detail and back
(() => {
  const D = JSON.parse(document.getElementById('cat-data')!.textContent!);
  const cat = document.getElementById('cat')!, grid = document.getElementById('catGrid')!, det = document.getElementById('catDetail')!, jar = document.getElementById('cdJar') as HTMLImageElement, line = document.getElementById('catLine')!;
  let open: { k: string; btn: HTMLElement } | null = null;
  function openP(k: string, btn: HTMLElement) {
    const d = D[k]; open = { k, btn }; const src = btn.querySelector('img')!;
    document.getElementById('cdName')!.textContent = d.n; document.getElementById('cdDesc')!.textContent = d.d;
    (document.getElementById('cdWa') as HTMLAnchorElement).href = d.wa;
    jar.src = d.img; jar.alt = 'Barattolo Glamood ' + d.n;
    const state = Flip.getState(src); det.hidden = false; src.style.visibility = 'hidden';
    Flip.from(state, { targets: jar, duration: reduced ? 0 : 1, ease: 'expo.inOut', scale: true });
    cat.style.setProperty('--cbg', d.bg); line.style.top = Object.keys(D).indexOf(k) * 25 + '%';
    gsap.to(grid, { opacity: 0, duration: 0.4, onComplete: () => { grid.style.visibility = 'hidden'; } });
    gsap.fromTo(cat.querySelectorAll('.cd-panel>*'), { x: -40, opacity: 0 }, { x: 0, opacity: 1, duration: reduced ? 0 : 0.8, delay: reduced ? 0 : 0.35, stagger: 0.05, ease: 'expo.out' });
    document.getElementById('cdBack')!.focus({ preventScroll: true });
  }
  function closeP() {
    if (!open) return; const src = open.btn.querySelector('img')!; grid.style.visibility = 'visible';
    const state = Flip.getState(jar); src.style.visibility = 'visible';
    Flip.from(state, { targets: src, duration: reduced ? 0 : 0.9, ease: 'expo.inOut', scale: true });
    gsap.to(grid, { opacity: 1, duration: 0.5, delay: 0.2 }); det.hidden = true; cat.style.removeProperty('--cbg'); open.btn.focus({ preventScroll: true }); open = null;
  }
  cat.querySelectorAll<HTMLElement>('.ci').forEach((b) => b.addEventListener('click', () => openP(b.dataset.k!, b)));
  document.getElementById('cdBack')!.addEventListener('click', closeP);
  addEventListener('keydown', (e) => { if (e.key === 'Escape') closeP(); });
})();

if (!reduced) {
  gsap.to('#prodotti .jars', { scrollTrigger: { trigger: '#prodotti .band', start: 'top bottom', end: 'bottom top', scrub: true }, yPercent: -8 });
}
</script>
