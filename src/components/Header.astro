---
// Navigation modelled on Vittorio's site: top header (logo, social, Prenota, menu) that fades up after 70 px,
// then a bottom bar slides in with a sliding highlight. Full-screen menu (link-tree style on phones).
import { business, wa, tel, instagramUrl } from '../data/business';
const items: [string, string][] = [['salone', 'Salone'], ['tagli', 'Tagli'], ['listino', 'Listino'], ['prodotti', 'Prodotti'], ['dove', 'Dove siamo']];
const baseLen = import.meta.env.BASE_URL.replace(/\/$/, '').length;
const here = Astro.url.pathname.slice(baseLen).replace(/\.html$/, '').replace(/^\/|\/$/g, '');
const cur = (id: string) => (here === id ? 'page' : undefined);
const ico: Record<string, string> = {
  '': '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-5h4v5"/>',
  salone: '<path d="M7 21v-7"/><path d="M17 21v-7"/><rect x="4" y="9" width="16" height="5" rx="2"/><path d="M8 9V5a4 4 0 0 1 8 0v4"/>',
  tagli: '<circle cx="6" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M8.2 16 20 4M8.2 8 20 20"/>',
  listino: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2Z"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  prodotti: '<rect x="5" y="9" width="14" height="12" rx="3"/><path d="M7 9V6h10v3"/><path d="M9 14h6"/>',
  dove: '<path d="M12 22s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12Z"/><circle cx="12" cy="10" r="2.6"/>',
};
const tabs: [string, string][] = [['', 'Home'], ['salone', 'Salone'], ['tagli', 'Tagli'], ['listino', 'Listino'], ['prodotti', 'Prodotti'], ['dove', 'Dove']];
const phone = tel();
const ig = business.instagram ? instagramUrl() : null;
const sc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="6" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M8.2 16 20 4M8.2 8 20 20"/></svg>';
---
<div class="sx-header">
<header class="testa" id="testa">
  <a class="mark" href="/" aria-label="Glamood, home"><img src="/img/brand/wordmark-petrolio-trasparente-480.webp" alt="GLAMOOD" width="480" height="81" /></a>
  <div class="soc">
    {ig && <a class="icon" href={ig} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>}
    <a class="icon" href={business.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5H16l.4-3h-2.9V8.7c0-.9.3-1.5 1.5-1.5h1.5V4.5c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.3H8v3h2.6V21z"/></svg></a>
    <a class="icon" href={wa()} target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7Z"/></svg></a>
    <a class="btn-pre" href={wa()} target="_blank" rel="noopener">Prenota</a>
    <button class="burger" id="burger" aria-label="Apri il menu" aria-expanded="false" aria-controls="menu"><span></span></button>
  </div>
</header>
<nav class="barra" id="barra" aria-label="Pagine">
  <span class="cursore" aria-hidden="true"></span>
  {tabs.map(([id, t]) => <a class="voce" href={`/${id}`} data-voce={id} aria-current={cur(id)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ico[id]} /><span>{t}</span></a>)}
  <button class="voce menu-btn" id="burger2" type="button" aria-controls="menu" aria-label="Apri il menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M5 8h14M5 16h14"/></svg><span>Menu</span></button>
</nav>
<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" inert>
  <div class="top"><span class="lab">Menu, Glamood</span><button class="x" id="menu-close" aria-label="Chiudi il menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
  <ul id="mlist">{[['', 'Home'] as [string, string], ...items].map(([id, t], i) => <li><a href={`/${id}`} aria-current={cur(id)}><span style={`transition-delay:${120 + i * 70}ms`}>{t}</span><Fragment set:html={sc} /></a></li>)}</ul>
  <div class="pills">
    <a href={wa()} target="_blank" rel="noopener" class="wide">Prenota su WhatsApp</a>
    {phone && <a href={phone}>Chiama</a>}
    <a href="/dove" data-maps>Portami da Glamood</a>
    {ig && <a href={ig} target="_blank" rel="noopener">Instagram</a>}
    <a href={business.facebook} target="_blank" rel="noopener">Facebook</a>
    <a href={business.linktree} target="_blank" rel="noopener">Tutti i link</a>
  </div>
</div>
</div>

<style is:global>
.sx-header{display:contents;
/* ---------- top header (pattern from Vittorio's site): visible at the top, fades up after 70 px ---------- */
.testa{position:fixed;z-index:var(--z-header);top:max(12px,env(safe-area-inset-top));left:clamp(14px,2vw,28px);right:clamp(14px,2vw,28px);display:flex;justify-content:space-between;align-items:center;pointer-events:none;transition:opacity .4s var(--ease-out),transform .5s var(--ease-out)}
.testa>*{pointer-events:auto}
&.scorre .testa{opacity:0;transform:translateY(-24px)}
&.scorre .testa>*{pointer-events:none}
.mark{display:grid;place-items:center;height:48px;padding:0 20px;border-radius:16px;background:var(--cream) url("/img/texture/carta-grana.webp") 0 0/256px;background-blend-mode:multiply;box-shadow:inset 0 1px #ffffffb3,0 14px 26px -14px rgb(6 40 44 / .6)}
.mark img{height:20px;width:auto}
.soc{display:flex;align-items:center;gap:8px;color:#fff}
.icon{width:48px;height:48px;display:none;place-items:center;border-radius:16px;color:var(--petrol);background:var(--cream) url("/img/texture/carta-grana.webp") 0 0/256px;background-blend-mode:multiply;box-shadow:inset 0 1px #ffffffb3,0 14px 26px -14px rgb(6 40 44 / .6);transition:transform .2s var(--ease-out)}
.icon:hover{transform:translateY(-2px)}
.icon svg{width:18px;height:18px}
.btn-pre{display:inline-flex;align-items:center;height:48px;padding:0 20px;border-radius:16px;background:var(--petrol);border:2px solid var(--cream);color:var(--cream);font:800 14px/1 var(--f-display);letter-spacing:.04em;text-transform:uppercase;text-decoration:none;box-shadow:inset 0 1px #ffffff40,0 12px 22px -10px rgb(6 40 44 / .7)}
.btn-pre:active,.burger:active{transform:scale(.95)}
.burger{width:48px;height:48px;border-radius:16px;background:var(--cream) url("/img/texture/carta-grana.webp") 0 0/256px;background-blend-mode:multiply;display:grid;place-items:center;box-shadow:inset 0 1px #ffffffb3,0 14px 26px -14px rgb(6 40 44 / .6)}
.burger span{display:block;width:18px;height:2px;background:var(--petrol);border-radius:2px;box-shadow:0 -6px 0 var(--petrol),0 6px 0 var(--petrol)}
@media (min-width:768px){.icon{display:grid}}
/* ---------- bottom bar: slides up from below after 70 px, sliding highlight, labels open on the active item ---------- */
.barra{position:fixed;z-index:calc(var(--z-header) + 1);left:50%;bottom:max(16px,env(safe-area-inset-bottom));display:flex;align-items:center;gap:2px;padding:7px;max-width:calc(100% - 24px);border-radius:24px;background:var(--cream) url("/img/texture/carta-grana.webp") 0 0/256px;background-blend-mode:multiply;
 box-shadow:inset 0 1px #ffffffbf,inset 0 -1px #0000000f,0 24px 40px -16px rgb(6 40 44 / .55),0 6px 14px -6px rgb(6 40 44 / .3);
 opacity:0;pointer-events:none;transform:translate(-50%,calc(100% + 40px));transition:transform .6s cubic-bezier(.2,.9,.25,1.05),opacity .4s}
&.scorre .barra{opacity:1;pointer-events:auto;transform:translate(-50%,0)}
.barra .cursore{position:absolute;z-index:0;top:7px;left:0;width:0;height:calc(100% - 14px);border-radius:17px;background:var(--petrol) url("/img/texture/carta-grana.webp") 0 0/256px;background-blend-mode:overlay;box-shadow:inset 0 1px #ffffff40,0 10px 18px -8px rgb(6 40 44 / .6);transition:transform .16s linear,width .16s linear;will-change:transform,width}
.barra .voce{position:relative;z-index:1;display:inline-flex;align-items:center;height:48px;padding:0 15px;border-radius:17px;color:var(--petrol);text-decoration:none;font:800 14px/1 var(--f-display);text-transform:uppercase;letter-spacing:.02em;transition:color .3s}
.barra .voce svg{width:21px;height:21px;flex:none}
.barra .voce span{white-space:nowrap;opacity:0;max-width:0;overflow:hidden;transition:max-width .5s cubic-bezier(.22,1,.36,1),opacity .35s cubic-bezier(.22,1,.36,1),margin .5s cubic-bezier(.22,1,.36,1)}
.barra .voce.on{color:var(--cream)}
.barra .voce.on span,.barra .voce:focus-visible span{opacity:1;max-width:140px;margin-left:8px}
@media (hover:hover){.barra .voce:hover span{opacity:1;max-width:140px;margin-left:8px}}
@media (max-width:767px){.barra{bottom:max(12px,env(safe-area-inset-bottom));gap:0;padding:6px}.barra .voce{padding:0 11px;height:46px}.barra .voce.on span{max-width:0;margin:0;opacity:0}.barra .menu-btn{display:none}}
@media (max-width:360px){.barra .voce{padding:0 9px}}
@media (prefers-reduced-motion:reduce){.testa,.barra,.barra .cursore{transition:none}}
/* ---------- full-screen menu ---------- */
.menu{position:fixed;inset:0;z-index:var(--z-menu);color:#fff;background:radial-gradient(120% 80% at 80% 0%,#12757E 0%,transparent 55%),radial-gradient(90% 70% at 0% 100%,#0C5A61 0%,transparent 60%),var(--petrol-darker);display:grid;grid-template-rows:auto 1fr auto;padding:max(22px,env(safe-area-inset-top)) var(--gutter) max(22px,env(safe-area-inset-bottom));visibility:hidden;clip-path:circle(0% at calc(100% - 46px) 44px);transition:clip-path .7s var(--ease-io),visibility 0s .7s;overflow:hidden}
.menu.open{visibility:visible;clip-path:circle(150% at calc(100% - 46px) 44px);transition:clip-path .8s var(--ease-io)}
.menu .top{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center}
.menu .lab{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;opacity:.75}
.menu .x{width:52px;height:52px;border-radius:16px;background:#fff;color:var(--petrol);display:grid;place-items:center}
.menu .x svg{width:22px;height:22px}
.menu ul{position:relative;z-index:2;list-style:none;align-self:center;justify-self:center;text-align:center}
.menu li a{display:inline-flex;align-items:center;gap:.25em;font-family:var(--f-display);font-weight:900;text-transform:uppercase;letter-spacing:-.03em;text-decoration:none;font-size:clamp(40px,8.4vw,104px);line-height:1.02;overflow:hidden}
.menu li a span{display:inline-block;transform:translateY(110%);transition:transform .8s var(--ease-out)}
.menu.open li a span{transform:none}
.menu li a:hover span,.menu li a:focus-visible span{color:var(--petrol-pale)}
.menu li a svg{width:.42em;height:.42em;opacity:0;transform:translateX(-40%) rotate(-90deg);transition:.4s var(--ease-out)}
.menu li a:hover svg,.menu li a:focus-visible svg{opacity:1;transform:none}
.menu .pills{position:relative;z-index:2;display:flex;flex-wrap:wrap;gap:10px}
.menu .pills a{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border:1px solid rgb(255 255 255 / .35);border-radius:999px;font-weight:600;font-size:15px;text-decoration:none}
.menu .pills a:hover{background:#fff;color:var(--petrol)}
@media (max-width:767px){
 .menu ul{align-self:start;justify-self:stretch;margin-top:5vh;text-align:left;display:grid;gap:10px}
 .menu li a{width:100%;justify-content:space-between;font-size:clamp(26px,8vw,34px);padding:14px 20px;border-radius:20px;background:rgb(255 255 255 / .1);border:1px solid rgb(255 255 255 / .18)}
 .menu li a svg{opacity:1;transform:none}
 .menu .pills{display:grid;grid-template-columns:1fr 1fr}
 .menu .pills a{justify-content:center;background:#fff;color:var(--petrol);border:0}
 .menu .pills a.wide{grid-column:1/-1}
}
@media (prefers-reduced-motion:reduce){.menu{transition:none}.menu li a span{transform:none}}
}
</style>

<script>
import { reduced, trapTab, lockScroll, wireMaps } from '../scripts/core.js';
const root = document.querySelector('.sx-header')!;
const menu = document.getElementById('menu')!, burger = document.getElementById('burger')!, burger2 = document.getElementById('burger2')!;
const barra = document.getElementById('barra')!;
wireMaps(menu);
// as soon as the page scrolls the top header fades up and the bottom bar slides in (same threshold as Vittorio's site)
const onScroll = () => root.classList.toggle('scorre', scrollY > 4);
onScroll(); addEventListener('scroll', onScroll, { passive: true });
// sliding highlight: rests on the current page, follows the pointer/focus, returns on leave
const cur = barra.querySelector('.cursore') as HTMLElement;
const voci = [...barra.querySelectorAll<HTMLElement>('.voce:not(.menu-btn)')];
const home = voci.find((v) => v.getAttribute('aria-current') === 'page') || voci[0];
let target = home, until = 0, raf = 0, t: any;
const paint = () => { cur.style.width = target.offsetWidth + 'px'; cur.style.transform = `translateX(${target.offsetLeft}px)`; if (performance.now() < until) raf = requestAnimationFrame(paint); };
const go = (v: HTMLElement) => { clearTimeout(t); target = v; voci.forEach((x) => x.classList.toggle('on', x === v)); until = performance.now() + 520; cancelAnimationFrame(raf); raf = requestAnimationFrame(paint); };
voci.forEach((v) => { v.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') go(v); }); v.addEventListener('focus', () => go(v)); });
barra.addEventListener('pointerleave', () => { t = setTimeout(() => go(home), 120); });
barra.addEventListener('focusout', (e) => { if (!barra.contains(e.relatedTarget as Node)) go(home); });
go(home); addEventListener('resize', () => go(target));
document.fonts.ready.then(() => go(target));
// menu
const open = (v: boolean) => {
  if (menu.classList.contains('open') === v) return;
  menu.classList.toggle('open', v); [burger, burger2].forEach((b) => b.setAttribute('aria-expanded', String(v))); menu.toggleAttribute('inert', !v);
  lockScroll(v);
  if (v) setTimeout(() => (menu.querySelector('a') as HTMLElement).focus(), reduced ? 0 : 300);
  else (root.classList.contains('scorre') ? burger2 : burger).focus();
};
burger.addEventListener('click', () => open(true)); burger2.addEventListener('click', () => open(true));
document.getElementById('menu-close')!.addEventListener('click', () => open(false));
menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) open(false); });
addEventListener('keydown', (e) => { if (!menu.classList.contains('open')) return; if (e.key === 'Escape') open(false); trapTab(e, menu); });
</script>
