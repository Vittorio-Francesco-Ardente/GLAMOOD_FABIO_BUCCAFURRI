---
// Navigation modelled on Vittorio's site: top header (logo, social, Prenota, menu) that fades up after 70 px,
// then a bottom bar slides in with a sliding highlight. Full-screen menu (link-tree style on phones).
import { business, wa, tel, instagramUrl } from '../data/business';
interface Props { tone?: 'light' | 'dark' }
const { tone = 'dark' } = Astro.props;
const items: [string, string][] = [['salone', 'Salone'], ['tagli', 'Tagli'], ['listino', 'Listino'], ['prodotti', 'Prodotti'], ['dove', 'Dove siamo']];
const baseLen = import.meta.env.BASE_URL.replace(/\/$/, '').length;
const here = Astro.url.pathname.slice(baseLen).replace(/\.html$/, '').replace(/^\/|\/$/g, '');
const cur = (id: string) => (here === id || (id && here.startsWith(id + '/')) ? 'page' : undefined);
const ico: Record<string, string> = {
  '': '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .71-1.53l7-6a2 2 0 0 1 2.58 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  salone: '<path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"/><path d="M3 16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V11a2 2 0 0 0-4 0z"/><path d="M5 18v2M19 18v2"/>',
  tagli: '<circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/>',
  listino: '<path d="M5 2.5v19l2-1.2 2 1.2 2-1.2 2 1.2 2-1.2 2 1.2 2-1.2v-19l-2 1.2-2-1.2-2 1.2-2-1.2-2 1.2-2-1.2-2 1.2Z" transform="translate(-1 0)"/><path d="M8 8h7M8 12h7M8 16h4"/>',
  prodotti: '<rect x="7" y="2.5" width="10" height="3.5" rx="1"/><path d="M6 6h12v13a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z"/><path d="M6 11.5h12"/>',
  dove: '<path d="M20 10c0 5-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 15 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
};
const tabs: [string, string][] = [['', 'Home'], ['salone', 'Salone'], ['tagli', 'Tagli'], ['listino', 'Listino'], ['prodotti', 'Prodotti'], ['dove', 'Dove']];
const phone = tel();
const ig = business.instagram ? instagramUrl() : null;
const sc = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="6" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M8.2 16 20 4M8.2 8 20 20"/></svg>';
---
<div class="sx-header" data-tone={tone}>
<header class="testa" id="testa">
  <a class="mark" href="/" aria-label="Glamood, home"><img src="/img/brand/wordmark-petrolio-trasparente-480.webp" alt="GLAMOOD" width="480" height="81" /></a>
  <nav class="links" aria-label="Pagine">{items.map(([id, t]) => <a href={`/${id}`} data-mobile-target={id === "salone" ? "salone" : undefined} aria-current={cur(id)}>{t}</a>)}</nav>
  <div class="soc">
    {ig && <a class="icon" href={ig} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>}
    <a class="icon" href={business.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5H16l.4-3h-2.9V8.7c0-.9.3-1.5 1.5-1.5h1.5V4.5c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.3H8v3h2.6V21z"/></svg></a>
    <a class="icon" href={wa()} target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7Z"/></svg></a>
    <a class="btn-pre" href={wa()} target="_blank" rel="noopener">Prenota</a>
    <button class="burger" id="burger" aria-label="Apri il menu" aria-expanded="false" aria-controls="menu"><span></span></button>
  </div>
</header>
<nav class="barra" id="barra" aria-label="Pagine">
  <span class="cursore" aria-hidden="true"></span>
  {tabs.map(([id, t]) => <a class="voce" href={`/${id}`} data-voce={id} data-mobile-target={id === "salone" ? "salone" : undefined} aria-current={cur(id)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ico[id]} /><span>{t}</span></a>)}
  <button class="voce menu-btn" id="burger2" type="button" aria-controls="menu" aria-label="Apri il menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span>Menu</span></button>
</nav>
<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" inert>
  <div class="top"><span class="lab">Menu, Glamood</span><button class="x" id="menu-close" aria-label="Chiudi il menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
  <ul id="mlist">{[['', 'Home'] as [string, string], ...items].map(([id, t], i) => <li class={id === "salone" ? "phone-salone-item" : undefined}><a href={`/${id}`} data-mobile-target={id === "salone" ? "salone" : undefined} aria-current={cur(id)}><span style={`transition-delay:${120 + i * 70}ms`}>{t}</span></a></li>)}</ul>
  <div class="pills">
    <a href={wa()} target="_blank" rel="noopener" class="wide">Prenota su WhatsApp</a>
    {phone && <a href={phone}>Chiama</a>}
    <a href="/dove" data-maps>Portami da Glamood</a>
    {ig && <a href={ig} target="_blank" rel="noopener">Instagram</a>}
    <a href={business.facebook} target="_blank" rel="noopener">Facebook</a>
    <a href={business.linktree} target="_blank" rel="noopener">Tutti i link</a>
  </div>
</div>
</div>

<style is:global>
.sx-header{display:contents;
/* ---------- top header (pattern from Vittorio's site): visible at the top, fades up after 70 px ---------- */
.testa{position:fixed;z-index:var(--z-header);top:max(14px,env(safe-area-inset-top));left:var(--gutter);right:var(--gutter);display:flex;align-items:center;gap:24px;pointer-events:none;--hc:#F4EFE8;transition:opacity .22s ease,transform .32s var(--ease-out),visibility 0s linear .32s}
&[data-tone="light"] .testa{--hc:var(--petrol)}
/* the header sits on a soft panel of its own tone, never floating over random content */
.testa{padding:8px 12px;border-radius:24px;background:rgb(8 57 62 / .42);-webkit-backdrop-filter:blur(12px) saturate(1.2);backdrop-filter:blur(12px) saturate(1.2);box-shadow:0 10px 30px -18px rgb(0 0 0 / .45)}
&[data-tone="light"] .testa{background:rgb(244 239 232 / .78)}
.testa>*{pointer-events:auto}
/* Fade the floating header immediately after the first scroll; keep the bottom
   dock's separate 120px phone threshold. Do not leave invisible buttons tappable. */
&.header-hidden .testa{opacity:0;transform:translate3d(0,-110%,0);visibility:hidden;pointer-events:none}
&.header-hidden .testa>*{pointer-events:none}
.mark{display:block;flex:none;padding:6px 0}
.mark img{height:24px;width:auto;filter:var(--hf, brightness(0) invert(1))}
&[data-tone="light"] .mark img{--hf:none}
.links{display:none;margin-inline:auto;gap:clamp(18px,2.4vw,40px)}
.links a{position:relative;color:var(--hc);text-decoration:none;font:800 15px/1 var(--f-display);letter-spacing:.06em;text-transform:uppercase;padding:10px 0;text-shadow:0 2px 12px rgb(0 0 0 / .18)}
&[data-tone="light"] .links a{text-shadow:none}
.links a::after{content:"";position:absolute;left:0;right:0;bottom:2px;height:2px;border-radius:2px;background:var(--brass);transform:scaleX(0);transform-origin:left;transition:transform .45s var(--ease-out)}
.links a:hover::after,.links a[aria-current]::after,.links a:focus-visible::after{transform:none}
.soc{display:flex;align-items:center;gap:6px;margin-left:auto;color:var(--hc)}
/* Balanced grid: the page links use the true horizontal center, independently
   of the unequal width of the logo and the right-hand action buttons. */
@media (min-width:1024px){
 .testa{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);column-gap:clamp(10px,1.5vw,22px)}
 .mark{grid-column:1;justify-self:start}
 .links{grid-column:2;display:flex;justify-self:center;margin-inline:0}
 .soc{grid-column:3;justify-self:end;margin-left:0}
}
@media (min-width:1024px) and (max-width:1279px){
 .links{gap:clamp(10px,1.2vw,16px)}
 .links a{font-size:clamp(11px,1.12vw,14px);letter-spacing:.03em}
 .soc{gap:3px}
 .btn-pre{padding-inline:14px}
}
.icon{width:44px;height:44px;display:none;place-items:center;border-radius:50%;color:var(--hc);transition:background .2s,transform .2s var(--ease-out)}
.icon:hover{background:color-mix(in srgb,var(--hc) 16%,transparent)}
.icon svg{width:19px;height:19px}
.btn-pre{display:inline-flex;align-items:center;height:44px;padding:0 20px;border-radius:999px;border:2px solid var(--hc);color:var(--hc);font:800 13px/1 var(--f-display);letter-spacing:.06em;text-transform:uppercase;text-decoration:none;transition:background .2s,color .2s}
.btn-pre:hover{background:var(--hc);color:var(--petrol)}
&[data-tone="light"] .btn-pre:hover{color:var(--cream)}
.btn-pre:active,.burger:active{transform:scale(.95)}
.burger{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;transition:background .2s}
.burger:hover{background:color-mix(in srgb,var(--hc) 16%,transparent)}
.burger span{display:block;width:20px;height:2px;background:var(--hc);border-radius:2px;box-shadow:0 -6px 0 var(--hc),0 6px 0 var(--hc)}
@media (min-width:768px){.icon{display:grid}}
/* ---------- bottom bar: slides up from below after 70 px, sliding highlight, labels open on the active item ---------- */
.barra{position:fixed;z-index:calc(var(--z-header) + 1);left:50%;bottom:max(16px,env(safe-area-inset-bottom));display:flex;align-items:center;gap:2px;padding:7px;max-width:calc(100% - 24px);border-radius:24px;background:var(--cream) url("/img/texture/carta-grana.webp") 0 0/256px;background-blend-mode:multiply;
 box-shadow:inset 0 1px #ffffffbf,inset 0 -1px #0000000f,0 24px 40px -16px rgb(6 40 44 / .55),0 6px 14px -6px rgb(6 40 44 / .3);
 opacity:0;pointer-events:none;transform:translate(-50%,calc(100% + 40px));transition:transform .6s cubic-bezier(.2,.9,.25,1.05),opacity .4s}
&.scorre .barra{opacity:1;pointer-events:auto;transform:translate(-50%,0)}
.barra .cursore{position:absolute;z-index:0;top:7px;left:0;width:0;height:calc(100% - 14px);border-radius:17px;background:var(--petrol);box-shadow:inset 0 1px #ffffff40,0 10px 18px -8px rgb(6 40 44 / .6);transition:transform .16s linear,width .16s linear;will-change:transform,width}
.barra .voce{position:relative;z-index:1;display:inline-flex;align-items:center;height:48px;padding:0 15px;border-radius:17px;color:var(--petrol);text-decoration:none;font:800 14px/1 var(--f-display);text-transform:uppercase;letter-spacing:.02em;transition:color .3s}
.barra .voce svg{width:21px;height:21px;flex:none}
.barra .voce span{white-space:nowrap;opacity:0;max-width:0;overflow:hidden;transition:max-width .5s cubic-bezier(.22,1,.36,1),opacity .35s cubic-bezier(.22,1,.36,1),margin .5s cubic-bezier(.22,1,.36,1)}
.barra .voce.on{color:var(--cream)}
.barra .voce.on span,.barra .voce:focus-visible span{opacity:1;max-width:140px;margin-left:8px}
@media (hover:hover){.barra .voce:hover span{opacity:1;max-width:140px;margin-left:8px}}
@media (max-width:767px){.barra{bottom:max(12px,env(safe-area-inset-bottom));gap:0;padding:6px}.barra .voce{padding:0 11px;height:46px}.barra .voce.on span{max-width:0;margin:0;opacity:0}.barra .menu-btn{display:none}}
@media (max-width:360px){.barra .voce{padding:0 9px}}
@media (prefers-reduced-motion:reduce){.testa,.barra,.barra .cursore{transition:none}}
/* ---------- full-screen menu ---------- */
.menu{position:fixed;inset:0;z-index:var(--z-menu);color:#fff;background:radial-gradient(120% 80% at 80% 0%,#12757E 0%,transparent 55%),radial-gradient(90% 70% at 0% 100%,#0C5A61 0%,transparent 60%),var(--petrol-darker);display:grid;grid-template-rows:auto 1fr auto;padding:max(22px,env(safe-area-inset-top)) var(--gutter) max(22px,env(safe-area-inset-bottom));visibility:hidden;clip-path:circle(0% at var(--mx,calc(100% - 46px)) var(--my,44px));transition:clip-path .7s var(--ease-io),visibility 0s .7s;overflow:hidden}
.menu.open{visibility:visible;clip-path:circle(150% at var(--mx,calc(100% - 46px)) var(--my,44px));transition:clip-path .8s var(--ease-io)}
.menu::before{content:"";position:absolute;inset:-8%;z-index:0;background:url("/img/svg/pattern-liquido-tono.svg") center/cover;opacity:.9;animation:refdrift 28s ease-in-out infinite alternate;pointer-events:none}
@media (prefers-reduced-motion:reduce){.menu::before{animation:none}}
.menu .top{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center}
.menu .lab{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;opacity:.75}
.menu .x{width:52px;height:52px;border-radius:16px;background:#fff;color:var(--petrol);display:grid;place-items:center}
.menu .x svg{width:22px;height:22px}
.menu ul{position:relative;z-index:2;list-style:none;align-self:center;justify-self:center;text-align:center}
.menu li a{display:inline-flex;align-items:center;gap:.25em;font-family:var(--f-display);font-weight:900;text-transform:uppercase;letter-spacing:-.03em;text-decoration:none;font-size:clamp(40px,8.4vw,104px);line-height:1.02;overflow:hidden}
.menu li a span{display:inline-block;transform:translateY(110%);transition:transform .8s var(--ease-out)}
.menu.open li a span{transform:none}
.menu li a:hover span,.menu li a:focus-visible span,.menu li a[aria-current] span{color:var(--petrol-pale)}
.menu li a:focus{outline:none}.menu li a:focus-visible span{text-decoration:underline;text-decoration-color:var(--brass);text-underline-offset:.12em;text-decoration-thickness:.06em}
.menu li a svg{width:.42em;height:.42em;opacity:0;transform:translateX(-40%) rotate(-90deg);transition:.4s var(--ease-out)}
.menu li a:hover svg,.menu li a:focus-visible svg{opacity:1;transform:none}
.menu .pills{position:relative;z-index:2;display:flex;flex-wrap:wrap;gap:10px}
.menu .pills a{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border:1px solid rgb(255 255 255 / .35);border-radius:999px;font-weight:600;font-size:15px;text-decoration:none}
.menu .pills a:hover{background:#fff;color:var(--petrol)}
@media (max-width:767px){
 /* Same typographic menu as desktop: centered text, no boxed navigation or bottom CTA row. */
 .menu{
   height:100dvh;max-height:100dvh;min-height:0;
   display:flex;flex-direction:column;gap:0;
   padding:calc(14px + env(safe-area-inset-top)) max(16px,var(--gutter))
     calc(22px + env(safe-area-inset-bottom));
   overflow-x:hidden;overflow-y:auto;
   -webkit-overflow-scrolling:touch;overscroll-behavior:contain;
 }
 .menu .top{
   position:relative;top:auto;flex:none;z-index:5;
   min-height:66px;margin:0;padding:8px 10px 8px 18px;
   border-radius:22px;
   background:rgb(5 51 55 / .88);border:1px solid rgb(255 255 255 / .12);
 }
 .menu .x{width:50px;height:50px;border-radius:17px;flex:none}
 .menu ul{
   flex:1 0 auto;align-self:stretch;justify-self:stretch;
   display:flex;flex-direction:column;align-items:center;justify-content:center;
   width:100%;min-height:min-content;margin:0;
   padding:clamp(14px,3svh,28px) 0;gap:clamp(8px,2.5svh,22px);
   list-style:none;text-align:center;
 }
 .menu li{width:100%;text-align:center}
 .menu li a{
   display:inline-flex;align-items:center;justify-content:center;
   width:auto;max-width:100%;min-height:44px;
   padding:0;border:0;border-radius:0;background:transparent;
   font-size:clamp(34px,9.5vw,48px);line-height:1.05;
   letter-spacing:-.03em;overflow:visible;
 }
 .menu li a svg{display:none}
 .menu .pills{display:none}
}
/* Phone-only navigation: do not cover cards/footer; keep the entire menu scrollable. */
@media (max-width:767px){
 /* The phone dock starts hidden and appears once, predictably, after the
    first 120px of scroll. It does not vanish with scroll direction. */
 .barra{
   bottom:max(10px,env(safe-area-inset-bottom));
   opacity:0;pointer-events:none;
   transform:translate(-50%,calc(100% + 28px));
   transition:opacity .2s ease,transform .32s ease;
 }
 &.scorre .barra{opacity:1;pointer-events:auto;transform:translate(-50%,0)}
 /* Never allow a dock to intercept the full-screen menu. */
 &.menu-is-open .barra,&.scorre.menu-is-open .barra{
   opacity:0;pointer-events:none;transform:translate(-50%,calc(100% + 28px))
 }
}
/* Mobile dock: five equal touch targets. Salone is in the phone Home,\n   so that redundant link is hidden in both menus without changing desktop.
   Reduced visual footprint without changing its scroll/menu behaviour. */
@media (max-width:767px){
 .barra{
   width:min(396px,calc(100vw - 28px));max-width:calc(100vw - 28px);
   display:grid;grid-template-columns:repeat(5,minmax(0,1fr));
   gap:0;padding:4px;bottom:max(12px,env(safe-area-inset-bottom));
   border-radius:21px;border:1px solid rgb(15 104 112 / .15);
   background-color:#F4EFE8;
   box-shadow:0 12px 28px rgb(3 38 42 / .3),inset 0 1px rgb(255 255 255 / .85);
 }
 .barra .cursore{top:4px;height:calc(100% - 8px);border-radius:15px;box-shadow:0 3px 9px rgb(3 38 42 / .22)}
 .barra .voce{
   display:flex;min-width:0;min-height:52px;height:52px;
   flex-direction:column;justify-content:center;align-items:center;
   padding:4px 1px;gap:3px;border-radius:15px;
   font-size:clamp(8px,2.15vw,9px);font-weight:800;line-height:1.15;
   letter-spacing:-.03em;text-align:center;white-space:nowrap;overflow:hidden;
 }
 .barra .voce svg{width:20px;height:20px;stroke-width:2;flex:none}
 .barra .voce span,.barra .voce.on span,.barra .voce:focus-visible span{
   display:block;opacity:1;max-width:100%;width:100%;min-width:0;
   margin:0!important;line-height:1.15;white-space:nowrap;
   overflow:hidden;text-overflow:clip;transition:none;
 }
 .barra .voce.on{color:#fff}
 .barra .voce[data-voce="salone"]{display:none}
 .menu .phone-salone-item{display:none}
 .barra .menu-btn{display:none}
}
@media (prefers-reduced-motion:reduce){.menu{transition:none}.menu li a span{transform:none}}
}
</style>

<script>
import { reduced, trapTab, lockScroll, wireMaps } from '../scripts/core.js';
const root = document.querySelector<HTMLElement>('.sx-header')!;
const menu = document.getElementById('menu')!, burger = document.getElementById('burger')!, burger2 = document.getElementById('burger2')!;
const barra = document.getElementById('barra')!;
wireMaps(menu);
// Show the mobile dock only after a meaningful scroll, then keep it stable.
// Desktop/tablet retain their original four-pixel threshold.
const phoneViewport = matchMedia('(max-width:767px)');
// On phones, Salone is an actual section of the Home. The home logo already
// has the correct GitHub Pages base path after build, so reuse that URL for
// links in the dock and the full-screen menu. Desktop/tablet keep /salone.
const homeHref = (root.querySelector<HTMLAnchorElement>('.mark')!).href;
const homeSaloneHref = new URL('#salone', homeHref).href;
const saloneLinks = [...root.querySelectorAll<HTMLAnchorElement>('a[data-mobile-target="salone"]')];
saloneLinks.forEach((link) => { link.dataset.standaloneHref = link.href; });
const syncSaloneLinks = () => {
  saloneLinks.forEach((link) => { link.href = phoneViewport.matches ? homeSaloneHref : link.dataset.standaloneHref!; });
};
syncSaloneLinks();
addEventListener('resize', syncSaloneLinks, { passive:true });
const onScroll = () => {
  const y = window.scrollY || document.documentElement.scrollTop;
  const immersive = document.querySelector<HTMLElement>('.p3');
  const rect = immersive?.getBoundingClientRect();
  const active = !!rect && rect.top < innerHeight * .65 && rect.bottom > 80;
  document.documentElement.classList.toggle('product-immersive', active);
  root.classList.remove('header-hidden');
  root.classList.toggle('scorre', !active && y > 140);
};
onScroll(); addEventListener('scroll', onScroll, { passive: true });
// link colour follows what is really under the header (light page, photo, petrol hero…)
const lum = (c: string) => { const m = c.match(/[\d.]+/g); if (!m) return null; const [r, g, b, a = '1'] = m.map(Number) as any; if (+a < .5) return null; return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255; };
const shell = root.closest<HTMLElement>('.site-header');
const opaqueBg = (el: HTMLElement | null) => { while (el && el !== document.documentElement) { if (el.tagName !== 'IMG' && el.tagName !== 'CANVAS') { const c = getComputedStyle(el).backgroundColor; if (lum(c) !== null) return c; } el = el.parentElement; } return null; };
// The header band takes the colour of the first section under it, so header and page read as one piece.
const matchBand = () => {
  if (!shell || shell.classList.contains('site-header-products')) return;
  const b = shell.getBoundingClientRect(); if (b.bottom < 0) return;
  const el = document.elementFromPoint(innerWidth / 2, b.bottom + 6) as HTMLElement | null;
  const c = el && !shell.contains(el) ? opaqueBg(el) : null; if (c) shell.style.setProperty('--hdr-bg', c);
};
// Header palettes, one per family of backgrounds used on the site (see product-polish.css, [data-hdr]).
const themeOf = (c: string) => {
