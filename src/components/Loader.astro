---
/* One-time progressive wordmark reveal. No reflection, sheen, blur or image-load wait. */
import art from './loader-art.txt?raw';
---
<script is:inline>
(function () {
  var html=document.documentElement, seen=false;
  try { seen=sessionStorage.getItem('glamood-intro')==='1'; } catch(e) {}
  if(seen || matchMedia('(prefers-reduced-motion: reduce)').matches) {
    html.classList.add('no-loader');
    return;
  }
  html.classList.add('loading');
  // Fail-safe is independent of the hero, CSS assets, and deferred JS bundles.
  window.setTimeout(function(){
    if(html.classList.contains('loading')){
      html.classList.remove('loading');
      html.classList.add('no-loader');
      document.getElementById('intro')?.remove();
    }
  }, 2200);
})();
</script>
<div class="gl-intro" id="intro" aria-hidden="true"><Fragment set:html={art} /></div>
<style is:global>
.gl-intro{
  --bg:#FFFFFF;--w1:#0C5A61;--w2:#0F6870;--w3:#12757E;
  position:fixed;inset:0;z-index:var(--z-loader);display:grid;
  place-items:center;overflow:hidden;cursor:pointer;background:#fff;
  opacity:1;transition:opacity .24s ease-out;
}
.no-loader .gl-intro{display:none}
.gl-intro.via{opacity:0;pointer-events:none}
.gl-intro .sfondo{position:absolute;inset:0;z-index:0;pointer-events:none}
.gl-intro .sfondo svg{width:100%;height:100%;display:block}
.gl-intro .sfondo .b{animation:none!important;transform:none!important}
.gl-intro .intro-logo{
  position:relative;z-index:1;width:min(84vw,980px);display:flex;
  flex-direction:column;align-items:center;
}
.gl-intro .ld-mask{display:block;width:100%}
.gl-intro .intro-wm{
  display:block;width:100%;height:auto;overflow:visible;
  color:#0F6870;opacity:0;
  clip-path:inset(0 100% 0 0);
  transform:translate3d(0,8px,0);
  filter:none!important;mask:none!important;-webkit-mask:none!important;
}
.gl-intro.gioca .intro-wm{animation:ld-reveal 1.22s cubic-bezier(.65,0,.35,1) .08s both}
@keyframes ld-reveal{
  from{opacity:1;clip-path:inset(0 100% 0 0);transform:translate3d(0,8px,0)}
  to{opacity:1;clip-path:inset(0 0 0 0);transform:none}
}
@media(max-width:767px){.gl-intro .intro-logo{width:88vw}}
@media(prefers-reduced-motion:reduce){.gl-intro{display:none}}
</style>
<script is:inline>
(function(){
  var intro=document.getElementById('intro');
  var html=document.documentElement;
  if(!intro || !html.classList.contains('loading')) { intro?.remove(); return; }
  var finished=false;
  var finish=function(){
    if(finished) return;
    finished=true;
    intro.classList.add('via');
    html.classList.remove('loading');
    try{sessionStorage.setItem('glamood-intro','1')}catch(e){}
    window.setTimeout(function(){intro.remove()},320);
    window.removeEventListener('keydown',skip);
  };
  var skip=function(e){if(['Escape','Enter',' '].includes(e.key))finish()};
  intro.addEventListener('click',finish,{once:true});
  window.addEventListener('keydown',skip);
  // Starts immediately after the markup is parsed. Never wait for window.load.
  requestAnimationFrame(function(){intro.classList.add('gioca')});
  window.setTimeout(finish,1520);
})();
</script>