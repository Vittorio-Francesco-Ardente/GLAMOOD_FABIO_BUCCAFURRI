---
// Kit 04: the link tree intro. The GLAMOOD wordmark rises whole from a mask, a light sweep crosses it,
// then the curtain lifts and the site enters. About 2.6 s, once per session, click/Enter/Esc skips.
// The hero renders underneath from the first paint (the loader never delays the LCP image download).
import art from './loader-art.txt?raw';
---
<script is:inline>
  (function(){var d=document.documentElement,seen=false;
    try{seen=sessionStorage.getItem('glamood-intro')==='1'}catch(e){}
    if(seen||matchMedia('(prefers-reduced-motion: reduce)').matches)d.classList.add('no-loader');else d.classList.add('loading');})();
</script>
<div class="gl-intro" id="intro" aria-hidden="true">
  <Fragment set:html={art} />
</div>
<style is:global>
.gl-intro{--bg:#FFFFFF;--w1:#0C5A61;--w2:#0F6870;--w3:#12757E;position:fixed;inset:0;z-index:var(--z-loader);display:grid;place-items:center;cursor:pointer;transform:translate3d(0,0,0);transition:transform 1.1s cubic-bezier(.76,0,.24,1);will-change:transform;overflow:hidden}
.no-loader .gl-intro{display:none}
.gl-intro.via{transform:translate3d(0,-100%,0);pointer-events:none}
.gl-intro .intro-logo{transition:transform 1.1s cubic-bezier(.76,0,.24,1),opacity .6s}
.gl-intro.via .intro-logo{transform:translate3d(0,40vh,0);opacity:0}
.gl-intro .sfondo{position:absolute;inset:0;z-index:-1}.gl-intro .sfondo svg{width:100%;height:100%;display:block}.gl-intro .sfondo .b{transform-box:view-box}
@media (prefers-reduced-motion:no-preference){.gl-intro .b1{animation:ld-a 18s ease-in-out infinite alternate}.gl-intro .b2{animation:ld-b 22s ease-in-out infinite alternate}.gl-intro .b3{animation:ld-a 26s ease-in-out infinite alternate-reverse}.gl-intro .b4{animation:ld-b 20s ease-in-out infinite alternate}.gl-intro .b5{animation:ld-a 16s ease-in-out infinite alternate-reverse}.gl-intro .b6{animation:ld-c 19s ease-in-out infinite alternate}}
@keyframes ld-a{from{transform:translate(-30px,6px)}to{transform:translate(30px,-10px)}}
@keyframes ld-b{from{transform:translate(26px,-8px)}to{transform:translate(-26px,10px)}}
@keyframes ld-c{from{transform:translate(0,-18px)}to{transform:translate(8px,18px)}}
.intro-logo{width:min(82vw,640px);display:flex;flex-direction:column;align-items:center;gap:clamp(10px,2vw,18px)}
.ld-mask{display:block;overflow:hidden;padding:2% 0}
.intro-wm{display:block;width:100%;height:auto;overflow:visible;color:#0F6870;transform:translateY(115%);will-change:transform}
.gioca .intro-wm{animation:ld-rise 1.15s cubic-bezier(.16,1,.3,1) .15s both}
@keyframes ld-rise{0%{transform:translateY(115%) rotate(2.5deg)}100%{transform:none}}
.ld-sheen{transform:skewX(-18deg);opacity:0}
.gioca .ld-sheen{animation:ld-sheen 1.05s cubic-bezier(.65,0,.35,1) 1.15s both}
@keyframes ld-sheen{0%{opacity:1;transform:skewX(-18deg) translateX(0)}100%{opacity:1;transform:skewX(-18deg) translateX(4600px)}}
@media (prefers-reduced-motion:reduce){.gl-intro{display:none}}
</style>
<script>
const intro = document.getElementById('intro');
const html = document.documentElement;
if (intro && html.classList.contains('loading')) {
  let t = 0;
  const fine = () => {
    if (intro.classList.contains('via')) return; clearTimeout(t);
    intro.classList.add('via'); html.classList.remove('loading');
    try { sessionStorage.setItem('glamood-intro', '1'); } catch (e) {}
    setTimeout(() => intro.remove(), 1200);
    removeEventListener('keydown', onKey);
  };
  const onKey = (e: KeyboardEvent) => { if (['Escape', 'Enter', ' '].includes(e.key)) fine(); };
  intro.addEventListener('click', fine); addEventListener('keydown', onKey);
  let started = false;
  const go = () => { if (started) return; started = true; requestAnimationFrame(() => requestAnimationFrame(() => { intro.classList.add('gioca'); t = window.setTimeout(fine, 2450); })); };
  if (document.readyState === 'complete') go(); else addEventListener('load', go, { once: true });
  setTimeout(go, 1200);
} else intro?.remove();
</script>
