---
// Page-to-page transition (link tree feel): a petrol curtain with the G and the site pattern rises, the next page loads underneath,
// then the curtain lifts. Clicking the logo (or Home) while already on the home page eases back to the top:
// it accelerates, then slows down just before arriving.
import { img } from '../data/img';
---
<script is:inline>
  (function(){try{if(sessionStorage.getItem('glamood-pt')==='1'){document.documentElement.classList.add('pt-arrive');sessionStorage.removeItem('glamood-pt');}}catch(e){}})();
</script>
<div class="pt-cover" id="pt-cover" aria-hidden="true"><img class="pt-g" {...img('brand/G-rasoio-crema-trasparente', 480)} alt="" decoding="async" /></div>
<style is:global>
.pt-cover{position:fixed;inset:0;z-index:calc(var(--z-loader) + 10);display:grid;place-items:center;pointer-events:none;background:var(--petrol-darker) url("/img/svg/pattern-liquido-tono.svg") center/cover;transform:translate3d(0,100%,0);will-change:transform;backface-visibility:hidden}
/* The G sits directly on the pattern: no disc, ring or spinner around it. */
.pt-g{width:clamp(76px,9vw,124px);height:auto;opacity:0;will-change:transform,opacity}
.pt-cover.in .pt-g{animation:ptG .3s .08s cubic-bezier(.16,1,.3,1) both}
.pt-arrive .pt-cover .pt-g{opacity:1}
.pt-cover.out .pt-g{animation:ptGout .25s ease-in both}
@keyframes ptG{from{opacity:0;transform:translateY(18px) scale(.92)}to{opacity:1;transform:none}}
@keyframes ptGout{from{opacity:1}to{opacity:0;transform:translateY(-16px)}}
.pt-cover.in{transform:translate3d(0,0,0);transition:transform .42s cubic-bezier(.76,0,.24,1);pointer-events:auto}
.pt-arrive .pt-cover{transform:translate3d(0,0,0)}
.pt-cover.out{transform:translate3d(0,-100%,0)!important;transition:transform .5s cubic-bezier(.76,0,.24,1)}
@media (prefers-reduced-motion:reduce){.pt-cover{display:none}}
</style>
<script>
const cover = document.getElementById('pt-cover')!;
const html = document.documentElement;
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
// Arrival starts only after one painted frame, with a bounded fail-safe.
const resetCover = () => { html.classList.remove('pt-arrive'); cover.classList.remove('in', 'out', 'runs'); };
if (html.classList.contains('pt-arrive')) {
  requestAnimationFrame(() => requestAnimationFrame(() => {
    cover.classList.add('out'); window.setTimeout(resetCover, 560);
  }));
  window.setTimeout(resetCover, 1600);
}
let navigating = false;
const easeInOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
function toTop() {
  const y0 = scrollY; if (y0 <= 0) return;
  const dur = Math.min(1.9, Math.max(0.9, y0 / 2600));
  const lenis = (window as any).lenis;
  if (lenis) { lenis.scrollTo(0, { duration: dur, easing: easeInOut }); return; }
  if (reduced) { scrollTo(0, 0); return; }
  const t0 = performance.now();
  const step = (t: number) => { const k = Math.min(1, (t - t0) / (dur * 1000)); scrollTo(0, y0 * (1 - easeInOut(k))); if (k < 1) requestAnimationFrame(step); };
  requestAnimationFrame(step);
}
const norm = (p: string) => p.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
document.addEventListener('click', (e) => {
  if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
  const a = (e.target as Element).closest('a') as HTMLAnchorElement | null;
  if (!a || a.target === '_blank' || a.hasAttribute('download') || a.hasAttribute('data-maps')) return;
  const url = new URL(a.href, location.href);
  if (url.origin !== location.origin) return;
  if (norm(url.pathname) === norm(location.pathname)) {
    if (url.hash) return; // in-page anchors are handled by the motion engine
    e.preventDefault(); toTop(); return;
  }
  if (reduced) return;
  e.preventDefault();
  cover.classList.remove('out'); cover.classList.add('in');
  if (navigating) return;
  navigating = true;
  try { sessionStorage.setItem('glamood-pt', '1'); sessionStorage.setItem('glamood-intro', '1'); } catch (err) {}
  setTimeout(() => { location.assign(url.href); }, 440);

});
// back/forward cache: never come back to a covered page
addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) { resetCover(); navigating = false; } });
</script>
