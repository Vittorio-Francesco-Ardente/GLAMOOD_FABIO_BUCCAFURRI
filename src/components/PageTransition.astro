---
// Page-to-page transition (link tree feel): a petrol curtain with the G rises, the next page loads underneath,
// then the curtain lifts. Clicking the logo (or Home) while already on the home page eases back to the top:
// it accelerates, then slows down just before arriving.
import { img } from '../data/img';
---
<script is:inline>
  (function(){try{if(sessionStorage.getItem('glamood-pt')==='1'){document.documentElement.classList.add('pt-arrive');sessionStorage.removeItem('glamood-pt');}}catch(e){}})();
</script>
<div class="pt-cover" id="pt-cover" aria-hidden="true"><img {...img('brand/G-rasoio-crema-trasparente', 480)} alt="" /></div>
<style is:global>
.pt-cover{position:fixed;inset:0;z-index:calc(var(--z-loader) - 1);display:grid;place-items:center;pointer-events:none;background:var(--petrol-darker) url("/img/svg/pattern-liquido-tono.svg") center/cover;clip-path:inset(100% 0 0 0)}
.pt-cover img{width:clamp(72px,9vw,120px);height:auto;opacity:0;transform:translateY(20px) scale(.9);transition:opacity .35s,transform .5s cubic-bezier(.16,1,.3,1)}
.pt-cover.in{clip-path:inset(0 0 0 0);transition:clip-path .6s cubic-bezier(.76,0,.24,1);pointer-events:auto}
.pt-cover.in img{opacity:1;transform:none;transition-delay:.25s}
.pt-arrive .pt-cover{clip-path:inset(0 0 0 0)}
.pt-arrive .pt-cover img{opacity:1;transform:none}
.pt-cover.out{clip-path:inset(0 0 100% 0)!important;transition:clip-path .75s cubic-bezier(.76,0,.24,1) .05s}
.pt-cover.out img{opacity:0;transform:translateY(-20px);transition:opacity .3s,transform .5s}
@media (prefers-reduced-motion:reduce){.pt-cover{display:none}}
</style>
<script>
const cover = document.getElementById('pt-cover')!;
const html = document.documentElement;
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
// arrival: lift the curtain
if (html.classList.contains('pt-arrive')) {
  requestAnimationFrame(() => requestAnimationFrame(() => { cover.classList.add('out'); setTimeout(() => { html.classList.remove('pt-arrive'); cover.classList.remove('out'); }, 900); }));
}
const easeInOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
function toTop() {
  const y0 = scrollY; if (y0 <= 0) return;
  const dur = Math.min(1.9, Math.max(0.9, y0 / 2600));
  const lenis = (window as any).lenis;
  if (lenis) { lenis.scrollTo(0, { duration: dur, easing: easeInOut }); return; }
  if (reduced) { scrollTo(0, 0); return; }
  const t0 = performance.now();
  const step = (t: number) => { const k = Math.min(1, (t - t0) / (dur * 1000)); scrollTo(0, y0 * (1 - easeInOut(k))); if (k < 1) requestAnimationFrame(step); };
  requestAnimationFrame(step);
}
const norm = (p: string) => p.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
document.addEventListener('click', (e) => {
  if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
  const a = (e.target as Element).closest('a') as HTMLAnchorElement | null;
  if (!a || a.target === '_blank' || a.hasAttribute('download') || a.hasAttribute('data-maps')) return;
  const url = new URL(a.href, location.href);
  if (url.origin !== location.origin) return;
  if (norm(url.pathname) === norm(location.pathname)) {
    if (url.hash) return; // in-page anchors are handled by the motion engine
    e.preventDefault(); toTop(); return;
  }
  if (reduced) return;
  e.preventDefault();
  cover.classList.remove('out'); cover.classList.add('in');
  try { sessionStorage.setItem('glamood-pt', '1'); } catch (err) {}
  setTimeout(() => { location.href = url.href; }, 620);
});
// back/forward cache: never come back to a covered page
addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) { cover.classList.remove('in', 'out'); html.classList.remove('pt-arrive'); } });
</script>
