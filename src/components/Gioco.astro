---
import Personaggio from './Personaggio.astro';
// Glamood Run: the playable game (engine and art from the GIOCO-E-MOBILE kit, public/gioco/).
// Lazy: nothing of the game is downloaded until the section is 300 px from the viewport.
import { wa, waText } from '../data/business';
const ico = {
  tap: '<path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V11"/><path d="M12 10.5V9a1.5 1.5 0 0 1 3 0v2"/><path d="M15 10.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7L3.6 15a1.5 1.5 0 0 1 2.5-1.7L9 16"/>',
  down: '<path d="M12 4v14"/><path d="M6 13l6 6 6-6"/>',
  drop: '<path d="M12 3c1.6 5 7 8 7 13a7 7 0 0 1-14 0c0-5 5.4-8 7-13Z"/>',
};
const luoghi: [string, string][] = [['01', 'Il salone'], ['02', 'Lungomare Falcomatà'], ['03', 'Centro e Castello'], ['04', 'Museo Archeologico'], ['05', 'Scilla'], ['06', 'Pentedattilo'], ['07', 'Bergamotteto']];
---
<div class="sx-gioco">
<section class="gioco has-bgref" id="gioco" data-lv="0" aria-labelledby="gioco-t"><div class="bgref lvbg lv0 r-macchie-tono"></div><div class="bgref lvbg lv1 r-liquido-tono"></div><div class="bgref lvbg lv2 r-geometrico"></div><div class="bgref lvbg lv3 r-swirl-teal"></div><div class="bgref lvbg lv4 r-strati"></div><div class="bgref lvbg lv5 r-rilievo"></div><div class="bgref lvbg lv6 r-agrumi-tono"></div>
  <div class="in">
    <p class="marker">Il gioco</p>
    <div class="top">
      <h2 id="gioco-t">Glamood <span>Run</span></h2>
      <p>Gioca adesso, anche dal telefono mentre aspetti il tuo turno: dal salone al Lungomare, fino a Scilla, Pentedattilo e al bergamotteto.</p>
    </div>
    <div id="run-wrap">
<div class="run" id="run" tabindex="0" role="application" aria-label="Glamood Run, gioco. Spazio o tocco per saltare, freccia in giù o tocco prolungato in basso per abbassarsi.">
    <div class="run-stage"><canvas aria-hidden="true"></canvas></div>
    <div class="hud" aria-hidden="true">
     <div class="hud-l"><svg viewBox="0 0 20 28" fill="none"><path d="M10 1c1.6 5.2 8.6 9.2 8.6 15.4a8.6 8.6 0 0 1-17.2 0C1.4 10.2 8.4 6.2 10 1Z" fill="#ECC46C" stroke="#051B1E" stroke-width="1.6"/></svg><b data-drops>0</b></div>
     <div class="hud-c" data-level></div>
     <div class="hud-r"><b class="sc" data-score>00000</b><small>Record <b data-best>00000</b></small></div>
    </div>
    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <div class="pop" data-pop><img data-pop-img alt=""><div><b data-pop-t></b><span data-pop-s></span></div></div>
    <div class="tut" data-tut hidden aria-live="polite"><b data-tut-t></b><span data-tut-s></span></div>
    <button class="tut-skip" type="button" data-tut-skip>Vai alla partita</button>
    <div class="zone" aria-hidden="true"><span>Tieni premuto: scivola</span><span>Tocca: salta</span></div>
    <div class="ov ov-start" data-ov="start">
     <Personaggio pose="corre" id="pg-corre" />
     <div class="ov-card">
      <p class="kick">Glamood · Reggio Calabria</p>
      <h3 class="title">Glamood<span>Run</span></h3>
      <button class="go" type="button" data-start><span class="when-idle">Corri</span><span class="when-pause">Riprendi</span></button>
      <button class="train" type="button" data-train>Allenamento</button>
      <button class="fs-go" type="button" data-fs><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>Gioca a schermo intero</button>
      <p class="how"><span class="k-desk">Spazio o clic: salta · freccia in giù: abbassati</span><span class="k-touch">Schermo intero in orizzontale · destra: salta · sinistra: scivola</span></p>
     </div>
    </div>
    <div class="ov ov-end" data-ov="end" hidden>
     <div class="panel">
      <p class="kick" data-end-kicker>Peccato! Riprova</p>
      <p class="big" data-end-score>00000</p>
      <p class="line"><span data-end-level></span><br><b data-end-drops>0</b> <span data-end-dl>gocce d'oro</span> · record <b data-end-best>00000</b></p>
      <div class="acts"><button class="again" type="button" data-again>Riprova</button><button class="menu-b" type="button" data-menu>Menu</button></div>
     </div>
    </div>
    <div class="load">Carico il salone…</div>
    <div class="rot" data-rot hidden><div class="rot-in">
      <div class="rot-stage" aria-hidden="true"><i class="rot-phone"><i class="rot-spk"></i></i></div>
      <b>Ruota il telefono</b><span>Si gioca in orizzontale: la corsa parte appena lo giri.</span>
    </div></div>
    <div class="cd" data-cd hidden><div><span class="cd-k">Si parte tra</span><b class="cd-n" data-cd-n>10</b><button class="cd-go" type="button" data-cd-go>Parti ora</button></div></div>
    <button class="fs-x" type="button" data-fs-x aria-label="Esci dallo schermo intero"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
   </div>
    </div>
    <div class="info">
      <div class="blk how2">
        <h3>Come si gioca</h3>
        <ul class="steps">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ico.tap} /><span><b>Salta</b>Tocca o Spazio, tieni premuto per saltare più in alto</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ico.down} /><span><b>Scivola</b>Tieni premuto in basso o freccia giù</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ico.drop} /><span><b>+10</b>ogni goccia d'oro</span></li>
        </ul>
        <p class="pw">Potenziamenti: peperoncino, profumo, asciugamano, forbici d'oro, moneta, pettine d'oro.</p>
      </div>
      <details class="blk board" open>
        <summary><h3>Classifica</h3><i aria-hidden="true"></i></summary>
        <ol id="run-board"><li class="empty">Ancora nessuna corsa: inizia tu.</li></ol>
        <p class="note">Per ora su questo dispositivo.</p>
      </details>
      <div class="blk places">
        <h3>I 7 luoghi</h3>
        <ol>{luoghi.map(([n, t]) => <li><b>{n}</b>{t}</li>)}</ol>
        <p class="note">Si cambia luogo ogni 1000 punti.</p>
      </div>
    </div>
  </div>
</section>
</div>

<style is:global>
.sx-gioco{display:contents;
.gioco{padding:clamp(56px,7vw,110px) var(--gutter);background:var(--petrol);color:var(--cream)}
.lvbg{opacity:0;transition:opacity 1.2s var(--ease-out)}
.gioco[data-lv="0"] .lv0,.gioco[data-lv="1"] .lv1,.gioco[data-lv="2"] .lv2,.gioco[data-lv="3"] .lv3,.gioco[data-lv="4"] .lv4,.gioco[data-lv="5"] .lv5,.gioco[data-lv="6"] .lv6{opacity:1}
.lv3{opacity:0}.gioco[data-lv="3"] .lv3{opacity:.55}
.in{max-width:1320px;margin:0 auto}
.marker{color:#cfe3e1}
.top{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:clamp(20px,4vw,60px);align-items:end;margin:clamp(20px,3vw,34px) 0 clamp(26px,3vw,40px)}
.top h2{font:900 clamp(48px,7vw,120px)/.86 var(--f-display);text-transform:uppercase;letter-spacing:-.035em;color:var(--cream);text-shadow:0 .05em 0 #08393E;margin:0}
.top h2 span{color:#ECC46C}
.top p{color:#d9ebe8;max-width:46ch;margin:0}
#run-wrap{position:relative}
.info{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:clamp(14px,2vw,24px);margin-top:clamp(20px,2.4vw,32px)}
.blk{background:rgb(8 57 62 / .55);border:1.5px solid rgb(244 239 232 / .18);border-radius:20px;padding:clamp(18px,2vw,26px)}
.blk h3{font:900 clamp(18px,1.5vw,22px)/1 var(--f-display);text-transform:uppercase;letter-spacing:.02em;margin:0 0 14px;color:var(--cream)}
.steps{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.steps li{display:flex;gap:12px;align-items:flex-start;font-size:14.5px;color:#d9ebe8}
.steps svg{width:26px;height:26px;flex:none;color:#ECC46C}
.steps b{display:block;color:var(--cream);font:800 14px/1.2 var(--f-display);text-transform:uppercase;letter-spacing:.04em}
.pw{font-size:13.5px;color:#cfe3e1;margin:14px 0 0}
.board summary{list-style:none;display:flex;justify-content:space-between;align-items:center;cursor:pointer;min-height:44px}
.board summary::-webkit-details-marker{display:none}
.board summary h3{margin:0}
.board summary i{position:relative;width:14px;height:14px}
.board summary i::before,.board summary i::after{content:"";position:absolute;left:0;top:6px;width:14px;height:2px;background:currentColor;transition:transform .3s}
.board summary i::after{transform:rotate(90deg)}
.board[open] summary i::after{transform:rotate(0)}
.board ol{margin:10px 0 0;padding:0;list-style:none;counter-reset:r;display:grid;gap:6px}
.board li{counter-increment:r;display:flex;justify-content:space-between;gap:10px;padding:8px 12px;border-radius:12px;background:rgb(244 239 232 / .08);font:700 15px/1.2 var(--f-display);font-variant-numeric:tabular-nums}
.board li::before{content:counter(r);color:#ECC46C;width:1.4em}
.board li span{flex:1}
.board li.empty{background:none;padding:0;font:500 14px var(--f-body);color:#cfe3e1}
.board li.empty::before{display:none}
.note{font-size:12.5px;color:#a9c9c6;margin:10px 0 0}
.places ol{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.places li{display:flex;gap:12px;align-items:center;font:700 15px/1.2 var(--f-display);text-transform:uppercase;letter-spacing:.02em}
.places li b{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--cream);color:var(--petrol);font:900 12px/1 var(--f-display);flex:none}
@media (max-width:1023px){.info{grid-template-columns:1fr 1fr}.how2{grid-column:1/-1}}
#run-wrap .ov-end .acts{grid-template-columns:1fr 1fr!important;gap:10px!important}
#run-wrap .ov-end .menu-b{min-height:48px;border-radius:999px;border:2px solid #0A4A50;background:transparent;color:#0A4A50;font:900 15px/1 var(--f-display);text-transform:uppercase;letter-spacing:.08em;cursor:pointer}
/* drops counter: bigger, in a readable pill */
#run-wrap .hud-l{gap:8px!important;padding:6px 14px 6px 10px;border-radius:999px;background:rgb(8 57 62 / .78);border:1.5px solid rgb(244 239 232 / .35);font-size:clamp(18px,2vw,26px)!important;text-shadow:none!important}
#run-wrap .hud-l svg{width:1em!important;height:1.3em!important}
#run-wrap .hud-r .sc{background:rgb(8 57 62 / .78);border:1.5px solid rgb(244 239 232 / .35);border-radius:999px;padding:6px 14px;text-shadow:none}
/* level name: bubble lettering, readable on every background */
#run-wrap .hud-c{top:clamp(8px,1.4vw,16px)!important;font:400 clamp(18px,2.4vw,30px)/1 "Glamood Bubble",var(--f-display)!important;letter-spacing:0!important;text-transform:uppercase!important;opacity:1!important;color:#F4EFE8;-webkit-text-stroke:.14em #08393E;paint-order:stroke fill;text-shadow:0 .12em 0 #08393E,0 .2em .5em rgb(0 0 0 / .45)!important}
#run-wrap .pop{background:rgb(8 57 62 / .82)!important;border:2px solid rgb(244 239 232 / .35)}
#run-wrap .pop b{font:400 clamp(24px,3.6vw,44px)/.95 "Glamood Bubble",var(--f-display)!important;text-transform:uppercase!important;letter-spacing:0;color:#F4EFE8;-webkit-text-stroke:.12em #08393E;paint-order:stroke fill;text-shadow:0 .1em 0 #08393E}
#run-wrap .pop span{color:#ECC46C!important;opacity:1!important;font-weight:700!important}
/* warm-up run */
#run-wrap .tut{position:absolute;z-index:5;left:50%;top:22%;transform:translateX(-50%);display:grid;justify-items:center;gap:6px;text-align:center;pointer-events:none;width:max-content;max-width:90%}
#run-wrap .tut[hidden]{display:none}
#run-wrap .tut b{font:400 clamp(30px,5.4vw,54px)/.95 "Glamood Bubble",var(--f-display);text-transform:uppercase;color:#F4EFE8;-webkit-text-stroke:.12em #08393E;paint-order:stroke fill;text-shadow:0 .1em 0 #08393E}
#run-wrap .tut[data-ok="1"] b{color:#ECC46C}
#run-wrap .tut span{padding:7px 14px;border-radius:999px;background:rgb(8 57 62 / .84);color:#F4EFE8;font:700 clamp(13px,1.3vw,16px)/1.2 var(--f-body)}
#run-wrap .tut span:empty{display:none}
#run-wrap .tut.tut-in{animation:tutPop .45s cubic-bezier(.2,1.3,.4,1) both}
#run-wrap .tut-skip{display:none;position:absolute;z-index:6;left:max(14px,env(safe-area-inset-left));bottom:max(14px,env(safe-area-inset-bottom));min-height:40px;padding:0 16px;border-radius:999px;border:2px solid rgb(244 239 232 / .55);background:rgb(8 57 62 / .78);color:#F4EFE8;font:800 12px/1 var(--f-display);letter-spacing:.1em;text-transform:uppercase;cursor:pointer}
#run-wrap .run:has(.tut:not([hidden])) .tut-skip{display:block}
#run-wrap .train{display:block;margin:10px auto 0;min-height:40px;padding:0 16px;border:0;background:none;color:#F4EFE8;font:800 13px/1 var(--f-display);letter-spacing:.1em;text-transform:uppercase;text-decoration:underline;text-underline-offset:4px;cursor:pointer}
#run-wrap .ov-start[data-mode="pause"] .train{display:none}
/* touch zones: left half slides, right half jumps; no browser gestures inside the game while full screen */
#run-wrap .run.fs,#run-wrap .run.fs *{touch-action:none;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
#run-wrap .run.fs button{touch-action:manipulation}
#run-wrap .zone{inset:auto 0 0 0!important;top:0!important;left:0!important;right:0!important;bottom:0!important;width:auto!important;height:auto!important;display:none;grid-template-columns:1fr 1fr!important;align-items:end!important;padding:0 0 calc(12px + env(safe-area-inset-bottom))!important;background:none!important;border:0!important;pointer-events:none}
#run-wrap .zone span{justify-self:center;padding:8px 14px;border-radius:999px;background:rgb(8 57 62 / .78);color:#F4EFE8;font:800 12px/1 var(--f-display);letter-spacing:.1em;text-transform:uppercase}
#run-wrap .zone span:first-child{box-shadow:inset 0 0 0 2px rgb(244 239 232 / .25)}
@media (pointer:coarse){#run-wrap .run.run-playing:not(.zone-off) .zone{display:grid!important}}
#run-wrap .zone::before{content:"";position:absolute;left:50%;top:18%;bottom:18%;border-left:2px dashed rgb(244 239 232 / .35)}
/* full-screen landscape mode (phones) */
#run-wrap .fs-go{display:none;margin-top:10px;align-items:center;gap:8px;min-height:46px;padding:0 18px;border-radius:999px;border:2px solid rgb(244 239 232 / .6);background:transparent;color:#F4EFE8;font:800 14px/1 var(--f-display);text-transform:uppercase;letter-spacing:.04em;cursor:pointer}
#run-wrap .fs-go svg{width:18px;height:18px}

#run-wrap .fs-x{display:none}
#run-wrap .run.fs{position:fixed!important;inset:0!important;z-index:10000;width:100vw!important;height:100vh!important;height:100dvh!important;max-height:none!important;aspect-ratio:auto!important;border:0!important;border-radius:0!important;box-shadow:none!important}
#run-wrap .run.fs .fs-go{display:none!important}
#run-wrap .run.fs .fs-x{display:grid;place-items:center;position:absolute;z-index:8;right:max(12px,env(safe-area-inset-right));bottom:max(12px,env(safe-area-inset-bottom));width:44px;height:44px;border-radius:50%;border:0;background:rgb(8 57 62 / .82);color:#F4EFE8}
#run-wrap .run.fs .fs-x svg{width:20px;height:20px}
#run-wrap .run.fs .hud{padding-left:max(16px,env(safe-area-inset-left));padding-right:max(16px,env(safe-area-inset-right))}
#run-wrap .cd{position:absolute;inset:0;z-index:7;display:grid;place-items:center;text-align:center;background:rgb(6 44 48 / .86);color:#F4EFE8}
#run-wrap .cd[hidden]{display:none}
#run-wrap .run:has(.cd:not([hidden])) .ov-start,#run-wrap .run:has(.cd:not([hidden])) .hud{visibility:hidden}
#run-wrap .cd-k{display:block;font:800 13px/1 var(--f-display);letter-spacing:.18em;text-transform:uppercase;color:#d9ebe8}
#run-wrap .cd-n{display:block;margin:10px 0 18px;font:400 clamp(72px,22vh,120px)/.9 "Glamood Bubble",var(--f-display);color:#F4EFE8;-webkit-text-stroke:.06em #08393E;paint-order:stroke fill;font-variant-numeric:tabular-nums}
#run-wrap .cd-n.tick{animation:cdTick .5s cubic-bezier(.2,.9,.25,1)}
#run-wrap .cd-go{min-height:48px;padding:0 26px;border-radius:999px;border:0;background:#F4EFE8;color:#0A4A50;font:900 15px/1 var(--f-display);text-transform:uppercase;letter-spacing:.06em;box-shadow:0 6px 0 -1px #052a2e;cursor:pointer}
#run-wrap .rot{position:absolute;inset:0;z-index:7;display:grid;place-items:center;text-align:center;padding:24px;background:#08393E;color:#F4EFE8}
#run-wrap .rot[hidden]{display:none}
#run-wrap .rot b{display:block;margin-top:14px;font:400 30px/1 "Glamood Bubble",var(--f-display);text-transform:uppercase}
#run-wrap .rot span{display:block;margin-top:10px;max-width:26ch;font-size:16px;line-height:1.4;color:#d9ebe8}
#run-wrap .rot{background:radial-gradient(120% 90% at 50% 38%,#0F5A60 0%,#08393E 62%,#062C30 100%)}
#run-wrap .rot-in{display:grid;justify-items:center;animation:rotIn .6s cubic-bezier(.2,.9,.25,1) both}
#run-wrap .rot-stage{display:grid;place-items:center;width:150px;height:150px}
#run-wrap .rot-phone{position:relative;display:block;width:56px;height:100px;border-radius:15px;border:3px solid #F4EFE8;background:linear-gradient(160deg,rgb(244 239 232 / .14),rgb(244 239 232 / .02) 60%);box-shadow:0 18px 30px -14px rgb(0 0 0 / .55),inset 0 0 0 4px rgb(8 57 62 / .6);animation:rotPhone 3s infinite}
#run-wrap .rot-spk{position:absolute;left:50%;top:7px;width:16px;height:3px;margin-left:-8px;border-radius:2px;background:#F4EFE8;opacity:.6}
#run-wrap .rot b{margin-top:4px}

/* rest, a quarter turn with a soft overshoot, hold, ease back */

@media (prefers-reduced-motion:reduce){#run-wrap .rot-phone{animation:none;transform:rotate(-90deg)}}
html.run-fs,html.run-fs body{overflow:hidden!important;overscroll-behavior:none}
/* phones: the level name sits under the counters, the postcard stacks so long names never clip */
@media (max-width:760px){
 #run-wrap .hud-c{top:56px!important;font-size:19px!important}
 #run-wrap .pop{top:50%!important;flex-direction:column;align-items:center;text-align:center;width:max-content;max-width:86%;padding:12px 16px 14px!important;gap:10px}
 #run-wrap .pop img{height:min(92px,13svh)}
 #run-wrap .pop b{font-size:26px!important}
}
#run-wrap .ov-end .again{width:100%!important}
@media (max-width:760px){
 .top{grid-template-columns:1fr;gap:12px}
 .top h2{font-size:clamp(44px,13vw,64px)}
 .info{grid-template-columns:1fr}
 .steps{grid-template-columns:repeat(3,1fr);gap:10px}
 .steps li{flex-direction:column;align-items:center;text-align:center;font-size:12px}
 .steps li span{display:block}
 .board:not([open]) ol,.board:not([open]) .note{display:none}
}
}
@keyframes rotIn{from{opacity:0;transform:translateY(14px) scale(.96)}}
@keyframes rotPhone{
 0%,18%{transform:rotate(0);animation-timing-function:cubic-bezier(.55,0,.25,1)}
 44%{transform:rotate(-98deg);animation-timing-function:cubic-bezier(.3,0,.4,1)}
 54%,80%{transform:rotate(-90deg);animation-timing-function:cubic-bezier(.6,0,.35,1)}
 100%{transform:rotate(0)}}
@keyframes cdTick{from{transform:scale(1.35);opacity:.3}}
@keyframes tutPop{from{opacity:0;transform:translateX(-50%) scale(.7)}}
</style>

<script>
const wrap = document.getElementById('run-wrap')!, root = document.getElementById('run')!, boardEl = document.getElementById('run-board')!;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const esc = (s: string) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
function renderBoard(list: any[]) {
  if (!Array.isArray(list) || !list.length) { boardEl.innerHTML = '<li class="empty">Ancora nessuna corsa: inizia tu.</li>'; return; }
  boardEl.innerHTML = list.slice(0, 5).map((e) => `<li><span>${esc(e.n || 'Tu')}</span><b>${String(e.s ?? e.score ?? 0).padStart(5, '0')}</b></li>`).join('');
}
let booted = false;
new IntersectionObserver(async (es, o) => {
  if (!es[0].isIntersecting || booted) return; booted = true; o.disconnect();
  const link = document.createElement('link'); link.rel = 'stylesheet'; link.href = BASE + '/gioco/glamood-run.css'; document.head.append(link);
  const [{ createGame }, { ASSETS, HAIR }] = await Promise.all([
    import(/* @vite-ignore */ BASE + '/gioco/glamood-run.js'),
    import(/* @vite-ignore */ BASE + '/gioco/glamood-run-assets.js'),
  ]);
  (window as any).__glamoodRun = createGame(root, { assets: ASSETS, hair: HAIR, onEvent: (type: string, data: any) => {
    if (type === 'state') document.documentElement.classList.toggle('game-on', data === 'play');
    if (type === 'board') renderBoard(data);
    if (type === 'level' && data) (document.getElementById('gioco') as HTMLElement).dataset.lv = String(Math.max(0, Math.min(6, Number(data.index) || 0)));
    if (type === 'start') (document.getElementById('gioco') as HTMLElement).dataset.lv = '0';
    if (type === 'start' && matchMedia('(max-width:760px)').matches) root.scrollIntoView({ block: 'center', behavior: 'smooth' });
  } });
  setupFullscreen((window as any).__glamoodRun);
}, { rootMargin: '300px' }).observe(wrap);

/* Full-screen landscape play on phones: start only once the phone is sideways, pause if it is turned back. */
function setupFullscreen(game: any) {
  const run = (document.getElementById('run') as HTMLElement), rot = root.querySelector<HTMLElement>('[data-rot]')!;
  const land = matchMedia('(orientation: landscape)');
  let fs = false, pending = false, autoPaused = false;
  const cd = root.querySelector<HTMLElement>('[data-cd]')!, cdN = root.querySelector<HTMLElement>('[data-cd-n]')!;
  let cdT = 0, cdDone: (() => void) | null = null;
  const stopCd = () => { clearInterval(cdT); cdT = 0; cdDone = null; cd.hidden = true; };
  const countdown = (secs: number, done: () => void) => {
    stopCd(); let n = secs; cdDone = done; cd.hidden = false; cdN.textContent = String(n);
    cdT = window.setInterval(() => { n--; if (n <= 0) { const d = cdDone; stopCd(); d?.(); return; }
      cdN.textContent = String(n); cdN.classList.remove('tick'); void cdN.offsetWidth; cdN.classList.add('tick'); }, 1000);
  };
  root.querySelector('[data-cd-go]')!.addEventListener('click', (e) => { e.stopPropagation(); const d = cdDone; stopCd(); d?.(); });
  ['pointerdown', 'touchstart'].forEach((t) => root.querySelector('[data-cd-go]')!.addEventListener(t, (e) => e.stopPropagation()));
  // a fixed layer inside transformed ancestors is not truly full screen on iOS: move the game under <body> while playing
  const home = document.createComment('run-wrap'); const portal = document.createElement('div'); portal.className = 'sx-gioco run-portal';
  const toBody = () => { wrap.before(home); portal.append(wrap); document.body.append(portal); };
  const back = () => { if (home.parentNode) { home.replaceWith(wrap); portal.remove(); } };
  const state = () => game?.debug?.state ?? run.dataset.state;
  const check = () => {
    if (!fs) return;
    if (land.matches) {
      rot.hidden = true;
      if (cdT) return;
      if (pending) countdown(10, () => { pending = false; game.start(); });
      else if (autoPaused && state() === 'pause') countdown(3, () => { autoPaused = false; game.resume(); });
    } else {
      rot.hidden = false; stopCd();
      if (state() === 'play') { game.pause(); autoPaused = true; }
    }
  };
  const enter = async () => {
    fs = true; pending = true; autoPaused = false;
    toBody(); run.classList.add('fs'); document.documentElement.classList.add('run-fs'); (window as any).lenis?.stop?.();
    try { await (run.requestFullscreen?.({ navigationUI: 'hide' }) ?? (run as any).webkitRequestFullscreen?.()); } catch { /* iOS: stays as a fixed full-viewport layer */ }
    try { await (screen.orientation as any)?.lock?.('landscape'); } catch { /* not supported: we wait for the user to turn the phone */ }
    check();
  };
  const exit = () => {
    if (!fs) return; fs = false; pending = false; autoPaused = false; rot.hidden = true; stopCd();
    if (state() === 'play') game.pause();
    run.classList.remove('fs'); back(); document.documentElement.classList.remove('run-fs'); (window as any).lenis?.start?.();
    try { (screen.orientation as any)?.unlock?.(); } catch { /* ignore */ }
    if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
  };
  root.querySelector('[data-fs]')!.addEventListener('click', (e) => { e.stopPropagation(); enter(); });
  // on touch screens the game is played only in full screen: any tap on the idle game opens it, the page never gets stuck
  const coarse = matchMedia('(pointer: coarse)');
  const gate = (e: Event) => {
    if (fs || !coarse.matches) return;
    const t = e.target as HTMLElement; if (t.closest('[data-fs-x]')) return;
    e.stopImmediatePropagation();
    if (e.type === 'click') { e.preventDefault(); enter(); }
  };
  ['pointerdown', 'touchstart', 'click'].forEach((t) => run.addEventListener(t, gate, { capture: true, passive: false } as any));
  root.querySelector('[data-fs-x]')!.addEventListener('click', (e) => { e.stopPropagation(); exit(); });
  ['pointerdown', 'touchstart', 'click'].forEach((t) => root.querySelector('[data-fs-x]')!.addEventListener(t, (e) => e.stopPropagation()));
  land.addEventListener('change', check); addEventListener('resize', check);
  document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement && fs && run.requestFullscreen) exit(); });
  (window as any).__glamoodFs = { enter, exit };
}
</script>
