---
// /prodotti index (aggiornamento 12): the whole line by category, each product opens /prodotti/<slug>.
// Each category is its own band on a liquid vector background. A filter bar shows one category at a time
// (Tutti = the whole line); the choice is kept in the URL hash (#cat-barba) so it can be shared.
import { img, productImg } from '../data/img';
import { CATS, PRODUCTS, imgOf } from '../data/catalogo';
const LIQ: Record<string, string> = { styling: 'crema-tono', barba: 'salvia', capelli: 'petrolio-tono', dopobarba: 'abisso' };
const count = (k: string) => PRODUCTS.filter((p) => p.cat === k).length;
---
<div class="sx-cat">
<section class="ct" id="catalogo" aria-labelledby="ct-t">
  <div class="ct-head"><p class="ct-k">Tutta la linea</p><h2 id="ct-t" tabindex="-1">Scegli il tuo</h2><p class="ct-lead">Scegli una categoria: vedi solo i prodotti che ti servono, poi apri la scheda per sapere come si usano.</p></div>
  <div class="ct-filter-wrap"><div class="ct-filter" role="group" aria-label="Filtra per categoria">
    <button type="button" data-f="all" aria-pressed="true">Tutti <span>{PRODUCTS.length}</span></button>
    {CATS.map((c) => <button type="button" data-f={c.k} aria-pressed="false" aria-controls={`cat-${c.k}`}>{c.n} <span>{count(c.k)}</span></button>)}
  </div><p class="ct-status" id="ct-status" aria-live="polite">Tutta la linea: {PRODUCTS.length} prodotti</p></div>
  {CATS.map((c) => (
    <div class={`ct-band has-bgref`} id={`cat-${c.k}`} data-cat={c.k} data-n={c.n} data-count={count(c.k)} style={`--bg:${c.bg};--ink:${c.ink};--ac:${c.accent};--liq:url('/img/svg/liquido-${LIQ[c.k]}.svg')`}>
      <div class="ct-band-in">
        <div class="ct-intro ct-rise"><h3>{c.n}</h3><p>{c.d}</p></div>
        <ul class="ct-grid">{PRODUCTS.filter((p) => p.cat === c.k).map((p, i) => (
          <li class="ct-rise" style={`--d:${i * 70}ms`}>
            <a class="ct-card" href={`/prodotti/${p.slug}`} style={`--cb:${p.bg};--ci:${p.ink};--card-pattern:url('/img/svg/product-${p.jar === "cera" ? "alveare" : p.cat === "barba" || p.cat === "dopobarba" ? "agrumi" : p.jar === "crema" || p.cat === "capelli" ? "botanico" : "onde"}.svg')`}>
              <span class="ct-ph"><img {...productImg(imgOf(p), '(max-width:767px) 82vw, (max-width:1023px) 42vw, 27vw')} alt={`${p.n} Glamood`} loading="lazy" decoding="async" /></span>
              <span class="ct-tx"><b>{p.n}</b><span>{p.sub} · {p.ml}</span><span class="ct-description">{p.desc}</span><span class="ct-detail">Scopri il prodotto</span></span>
              <span class="ct-go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </a>
          </li>
        ))}</ul>
      </div>
    </div>
  ))}
</section>
</div>

<style is:global>
.sx-cat{display:contents;
.ct{background:#F4EFE8}
.ct-head{padding:clamp(64px,8vw,120px) var(--gutter) clamp(28px,4vw,48px);max-width:1360px;margin:0 auto}
.ct-k{font:800 12px/1 var(--f-display);letter-spacing:.18em;text-transform:uppercase;color:var(--brass)}
.ct-head h2{margin-top:12px;font:900 clamp(48px,9vw,140px)/.85 var(--f-display);text-transform:uppercase;letter-spacing:-.04em;color:var(--petrol)}
.ct-nav{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
.ct-nav a{min-height:44px;display:inline-flex;align-items:center;padding:0 18px;border-radius:999px;border:2px solid var(--petrol);color:var(--petrol);font:800 14px/1 var(--f-display);text-transform:uppercase;letter-spacing:.06em;text-decoration:none}
.ct-nav a:hover{background:var(--petrol);color:#F4EFE8}
.ct-band{position:relative;background:var(--bg) var(--liq) center/cover no-repeat;color:var(--ink);scroll-margin-top:96px}
.ct-band[hidden]{display:none}
.ct-band.ct-in{animation:ctIn .55s var(--ease-out) both}
@keyframes ctIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
.ct-filter-wrap{position:sticky;top:0;z-index:5;padding:12px var(--gutter);background:rgb(244 239 232 / .92);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-block:1px solid rgb(15 104 112 / .12)}
.ct-filter{max-width:1360px;margin:0 auto;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.ct-filter::-webkit-scrollbar{display:none}
.ct-filter button{flex:none;display:inline-flex;align-items:center;gap:10px;min-height:46px;padding:0 8px 0 18px;border-radius:999px;border:2px solid var(--petrol);background:#fff;color:var(--petrol);font:800 14px/1 var(--f-display);text-transform:uppercase;letter-spacing:.05em;cursor:pointer;transition:background .25s,color .25s,transform .2s var(--ease-out)}
.ct-filter button span{display:grid;place-items:center;min-width:30px;height:30px;padding:0 8px;border-radius:999px;background:#E3ECE8;font-size:13px;letter-spacing:0}
.ct-filter button:hover{background:#E3ECE8}
.ct-filter button[aria-pressed="true"]{background:var(--petrol);color:#F4EFE8}
.ct-filter button[aria-pressed="true"] span{background:#F4EFE8;color:var(--petrol)}
.ct-filter button:active{transform:scale(.97)}
.ct-status{max-width:1360px;margin:8px auto 0;font-size:13px;color:#456366}
.ct-intro{padding:20px 24px!important;border-radius:22px;background:color-mix(in srgb,var(--bg) 88%,transparent);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-bottom:0!important}
.ct-band-in{position:relative;z-index:1;max-width:1360px;margin:0 auto;padding:clamp(56px,7vw,110px) var(--gutter);display:grid;gap:clamp(24px,3vw,40px)}
.ct-intro h3{font:900 clamp(40px,6vw,96px)/.85 var(--f-display);text-transform:uppercase;letter-spacing:-.03em}
.ct-intro p{margin-top:12px;max-width:46ch;font-size:17px;line-height:1.5;opacity:.9}
.ct-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,280px),1fr));gap:clamp(14px,2vw,24px)}
.ct-card{position:relative;display:grid;grid-template-rows:auto auto;height:100%;border-radius:26px;background:var(--cb);color:var(--ci);text-decoration:none;overflow:hidden;box-shadow:0 24px 40px -30px rgb(0 0 0 / .5);transition:transform .45s var(--ease-out),box-shadow .45s var(--ease-out)}
.ct-card:hover{transform:translateY(-6px);box-shadow:0 34px 50px -30px rgb(0 0 0 / .55)}
.ct-ph{display:grid;place-items:center;aspect-ratio:1;padding:8%}
.ct-ph img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 18px 18px rgb(0 0 0 / .2));transition:transform .6s var(--ease-out)}
.ct-card:hover .ct-ph img{transform:scale(1.04) rotate(-2deg)}
.ct-tx{display:grid;gap:6px;padding:0 22px 22px}
.ct-tx b{font:900 24px/1 var(--f-display);text-transform:uppercase;letter-spacing:-.01em}
.ct-tx span{font-size:15px;opacity:.85}
.ct-go{position:absolute;right:16px;bottom:16px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--ci);color:var(--cb)}
.ct-go svg{width:20px;height:20px}
.ct-rise{opacity:0;transform:translateY(28px);transition:opacity .7s var(--ease-out),transform .7s var(--ease-out);transition-delay:var(--d,0ms)}
.ct-rise.ct-on{opacity:1;transform:none}
@media (min-width:1024px){.ct-band-in{grid-template-columns:minmax(0,1fr) minmax(0,2.2fr);align-items:start}.ct-intro{position:sticky;top:110px}}
@media (prefers-reduced-motion:reduce){.ct-rise{opacity:1;transform:none;transition:none}}
}
</style>
<script>
const bands = [...document.querySelectorAll<HTMLElement>('.ct-band')];
const btns = [...document.querySelectorAll<HTMLButtonElement>('.ct-filter button')];
const status = document.getElementById('ct-status')!;
const total = btns[0].querySelector('span')!.textContent;
function show(f: string, scroll: boolean) {
  if (f !== 'all' && !bands.some((b) => b.dataset.cat === f)) f = 'all';
  btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === f)));
  bands.forEach((b) => { const on = f === 'all' || b.dataset.cat === f; b.hidden = !on; b.classList.remove('ct-in'); if (on) { void b.offsetWidth; b.classList.add('ct-in'); b.querySelectorAll('.ct-rise').forEach((el) => el.classList.add('ct-on')); } });
  const cur = bands.find((b) => b.dataset.cat === f);
  status.textContent = cur ? `${cur.dataset.n}: ${cur.dataset.count} prodotti` : `Tutta la linea: ${total} prodotti`;
  history.replaceState(null, '', f === 'all' ? location.pathname + location.search : `#cat-${f}`);
  dispatchEvent(new Event('resize'));
  if (scroll) { const head = document.querySelector('.ct-filter-wrap') as HTMLElement; const y = head.getBoundingClientRect().top + scrollY; if (Math.abs(head.getBoundingClientRect().top) > 4) { const l = (window as any).lenis; l ? l.scrollTo(y, { duration: .7 }) : scrollTo({ top: y, behavior: 'smooth' }); } }
}
btns.forEach((b) => b.addEventListener('click', () => show(b.dataset.f!, true)));
const fromHash = location.hash.match(/^#cat-([a-z]+)$/);
if (fromHash) show(fromHash[1], false);
addEventListener('hashchange', () => { const m = location.hash.match(/^#cat-([a-z]+)$/); if (m) show(m[1], false); });
const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('ct-on'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
document.querySelectorAll('.ct-rise').forEach((el) => io.observe(el));
</script>
