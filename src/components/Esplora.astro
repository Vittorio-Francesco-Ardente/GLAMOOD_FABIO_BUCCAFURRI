---
// Home: one card per page (salone, tagli, listino, prodotti, dove siamo), in the cream "ticket" style.
import Img from './Img.astro';
import { img } from '../data/img';
const icons = ['<path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"/><path d="M3 16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V11a2 2 0 0 0-4 0z"/>','<circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/>','<path d="M4 2.5v19l2-1.2 2 1.2 2-1.2 2 1.2 2-1.2 2 1.2 2-1.2v-19l-2 1.2-2-1.2-2 1.2-2-1.2-2 1.2-2-1.2-2 1.2Z"/><path d="M8 8h7M8 12h7M8 16h4"/>','<rect x="7" y="2.5" width="10" height="3.5" rx="1"/><path d="M6 6h12v13a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z"/><path d="M6 11.5h12"/>','<path d="M20 10c0 5-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 15 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>'];
const cards: [href: string, k: string, t: string, src: string, alt: string][] = [
  ['/salone', 'Via Sbarre Centrali', 'Il salone', 'salone/salone-05', 'Le postazioni del salone Glamood'],
  ['/tagli', 'Scegli il tuo', 'I tagli', 'tagli/sfumato-basso-foto', 'Uno sfumato basso fatto da Glamood'],
  ['/listino', 'Senza sorprese', 'Listino', 'salone/salone-11-titolare', 'Fabio al lavoro in salone'],
  ['/prodotti', 'Da portare a casa', 'Prodotti', 'prodotti/barattoli-3-insieme', 'I barattoli Glamood'],
  ['/dove', 'Ci trovi qui', 'Dove siamo', 'salone/salone-12-facciata', "L'ingresso del salone Glamood"],
];
---
<div class="sx-esplora">
<section class="esplora has-bgref" aria-labelledby="esplora-t"><div class="bgref r-corallo-tono"></div><picture><source media="(max-width:767px)" srcset={img('v2/sfondi/luci-ombre/ombre-foglie-palma-mob', 960).src} /><img class="deco-ov leaves" {...img('v2/sfondi/luci-ombre/ombre-foglie-palma-desk', 1600)} alt="" loading="lazy" decoding="async" /></picture>
  <div class="in">
    <p class="marker">Esplora</p>
    <h2 class="type-pop on-petrol" id="esplora-t">Accomodati</h2>
    <div class="grid">
      {cards.map(([href, k, t, src, alt], i) => (
        <a class={`c c${i}`} href={href}><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} /></span><div class="ph">{i === 1 ? (
          <div class="fan" role="img" aria-label="Tre cassette dei tagli Glamood: side part, pompadour, buzz cut">
            {([['side-part', 'Side part', 3.9, 11.8, 89.8, 6.7], ['pompadour', 'Pompadour', 5.4, 11.4, 89.1, 7.3], ['buzz-cut', 'Buzz cut', 5.9, 11.5, 88.9, 6.8]] as const).map(([n, l, t, th, b, bh]) => (
              <span class="cas"><Img src={`tagli/${n}-front`} alt="" sizes="(min-width:1024px) 12vw, 32vw" /><b style={`top:${t}%;height:${th}%`}>{l}</b><i style={`top:${b}%;height:${bh}%`}>Glamood</i></span>
            ))}
          </div>
        ) : <Img src={src} alt={alt} sizes="(min-width:1024px) 30vw, 90vw" />}</div><span class="k">{k}</span><b>{t}</b><span class="go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
      ))}
    </div>
  </div>
</section>
</div>
<style is:global>
.sx-esplora{display:contents;
.esplora{position:relative;background:var(--petrol-darker);padding:clamp(60px,8vw,120px) var(--gutter);color:var(--cream)}
.in{max-width:1320px;margin:0 auto}
.marker{color:#cfe3e1}
h2{font-size:clamp(48px,8vw,130px)}
.grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:clamp(14px,2vw,26px);margin-top:clamp(30px,4vw,56px)}
.c{grid-column:span 2;position:relative;display:grid;gap:4px;background:var(--cream);color:var(--ink);border-radius:22px;padding:12px 12px 18px;text-decoration:none;box-shadow:0 30px 60px -30px rgb(0 0 0 / .6);transition:transform .5s var(--ease-out)}
.c0,.c1{grid-column:span 3}
.c:hover{transform:translateY(-6px) rotate(-.6deg)}
.ph{border-radius:14px;overflow:hidden;aspect-ratio:4/3;margin-bottom:10px;background:var(--petrol-pale)}
.c0 .ph,.c1 .ph{aspect-ratio:5/4}
.c1 .ph{background:var(--petrol) url("/img/pattern/organico-tono-su-tono.webp") center/420px;display:grid;place-items:center}
.fan{position:relative;width:100%;height:100%}
.cas{position:absolute;top:50%;left:50%;width:27%;aspect-ratio:.557;transform:translate(-50%,-50%) rotate(var(--r)) translateX(var(--x));border-radius:10px;overflow:hidden;box-shadow:0 22px 34px -16px rgb(0 0 0 / .65);transition:transform .6s var(--ease-out)}
.cas:nth-child(1){--r:-7deg;--x:-118%}.cas:nth-child(2){--r:0deg;--x:0%;z-index:2;width:30%}.cas:nth-child(3){--r:7deg;--x:146%}
.cas:nth-child(3){aspect-ratio:.44;width:22%}
.cas img{width:100%;height:100%;object-fit:cover;display:block}
.cas b,.cas i{position:absolute;left:5.5%;right:5.5%;display:grid;place-items:center;font:900 clamp(9px,1vw,15px)/1 var(--f-display);text-transform:uppercase;letter-spacing:.01em;color:var(--petrol);white-space:nowrap}
.cas i{font-style:normal;font-size:clamp(7px,.7vw,11px);letter-spacing:.14em}
.c:hover .cas:nth-child(1){transform:translate(-50%,-50%) rotate(-9deg) translateX(-124%)}.c:hover .cas:nth-child(3){transform:translate(-50%,-50%) rotate(9deg) translateX(154%)}
.c1:hover .ph img,.c1 .cas img{transform:none!important}
.ph img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease-out)}
.c3 .ph img{object-fit:contain;padding:10px}
.c:hover .ph img{transform:scale(1.06)}
.k{font:600 11px/1 var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);padding:0 6px}
b{font:900 clamp(26px,2.6vw,40px)/.95 var(--f-display);text-transform:uppercase;color:var(--petrol);padding:0 6px}
.go{position:absolute;right:16px;bottom:16px;width:44px;height:44px;border-radius:50%;background:var(--petrol);color:var(--cream);display:grid;place-items:center}
.go svg{width:20px}
@media (max-width:900px){.grid{grid-template-columns:1fr 1fr}.c,.c0,.c1{grid-column:span 1}.c0{grid-column:span 2}}
@media (max-width:560px){.grid{grid-template-columns:1fr}.c,.c0{grid-column:span 1}}
}
</style>
