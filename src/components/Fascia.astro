---
// Bottom-of-section composition (aggiornamento 07): glued to the bottom edge, full width on desktop,
// the -mob file on phones. The files are transparent above the objects, so the box only shows the
// painted part (no leaf or tool is ever cut) and it rises 30px into place when it enters the screen.
import { img } from '../data/img';
interface Props { name: 'salone' | 'tagli' | 'listino' | 'footer'; bg?: string; pattern?: string }
const { name, bg = 'transparent', pattern } = Astro.props;
// first painted row of each file (fraction of its height), measured on the assets
const TOP: Record<string, [number, number]> = { salone: [0.4002, 0.55], tagli: [0.4002, 0.55], listino: [0.4002, 0.577], footer: [0.4002, 0.612] };
const [td, tm] = TOP[name];
const desk = img(`v2/fasce-decorazioni/fasce/fascia-${name}-desk`);
const mob = img(`v2/fasce-decorazioni/fasce/fascia-${name}-mob`, 960);
const hd = ((desk.height / desk.width) * (1 - td) * 100).toFixed(2), hm = ((mob.height / mob.width) * (1 - tm) * 100).toFixed(2);
---
<div class={`fascia fascia-${name}`} style={`--bg:${bg};--hd:${hd}vw;--hm:${hm}vw`} aria-hidden="true">
  {pattern && <div class={`bgref ${pattern}`}></div>}
  <picture>
    <source media="(max-width:767px)" srcset={mob.src} width={mob.width} height={mob.height} />
    <img src={desk.src} width={desk.width} height={desk.height} alt="" loading="lazy" decoding="async" />
  </picture>
</div>

<style is:global>
.fascia{position:relative;z-index:1;height:var(--hd);background:var(--bg);overflow:hidden;isolation:isolate;pointer-events:none}
.fascia img{position:absolute;left:0;bottom:0;width:100%;height:auto;transform:translateY(30px);opacity:0;transition:transform 1s var(--ease-out),opacity .8s var(--ease-out)}
.fascia.in img{transform:none;opacity:1}
@media (max-width:767px){.fascia{height:var(--hm)}}
@media (prefers-reduced-motion:reduce){.fascia img{transform:none;opacity:1;transition:none}}
</style>

<script>
const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
document.querySelectorAll('.fascia').forEach((f) => io.observe(f));
</script>
