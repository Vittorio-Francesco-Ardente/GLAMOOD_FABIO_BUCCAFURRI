---
import { img } from '../data/img';
---
<div class="loader-emblem"><img {...img('brand/faccia-petrolio-trasparente', 480)} alt="" loading="eager" decoding="sync" /></div>
<style is:global>
.loader-emblem{width:clamp(128px,25vw,210px);aspect-ratio:1;display:grid;place-items:center;position:relative}
.loader-emblem img{width:70%;height:85%;object-fit:contain;animation:emblem-breathe 1.4s ease-in-out infinite}
.loader-emblem::after{content:"";position:absolute;inset:-14px;border:2px solid rgb(15 104 112 / .16);border-top-color:#0F6870;border-radius:50%;animation:emblem-turn 1.4s linear infinite}
@keyframes emblem-breathe{50%{transform:scale(.96)}}
@keyframes emblem-turn{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.loader-emblem img,.loader-emblem::after{animation:none}}
</style>
