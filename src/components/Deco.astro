---
// Shared motion for the decorations of the update (07/02): every [data-par] element drifts gently with the
// scroll (translate, tiny rotation and scale), one rAF-throttled loop, only while it is on screen.
// Reduced motion: everything stays in its final place.
---
<style is:global>
.deco{position:absolute;pointer-events:none;height:auto;object-fit:contain;will-change:transform}
.deco-ov{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none;z-index:0}
.deco-ov.leaves{inset:0 auto auto 0;width:min(70vw,1100px);height:auto;object-fit:contain;mix-blend-mode:multiply;opacity:.55}
.deco-ov.light{mix-blend-mode:screen;opacity:.5}
.deco.rise{opacity:0;translate:0 24px;transition:opacity .8s var(--ease-out),translate .8s var(--ease-out)}
.deco.rise.in{opacity:1;translate:0 0}
@media (prefers-reduced-motion:reduce){.deco.rise{opacity:1;translate:0 0;transition:none}}
</style>
<script>
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
const els = [...document.querySelectorAll<HTMLElement>('[data-par]')];
const vis = new Set<HTMLElement>();
const io = new IntersectionObserver((es) => es.forEach((e) => {
  const el = e.target as HTMLElement;
  if (e.isIntersecting) { vis.add(el); el.classList.add('in'); } else vis.delete(el);
}), { rootMargin: '10% 0px' });
els.forEach((el) => io.observe(el));
let raf = 0;
const tick = () => {
  raf = 0;
  const h = innerHeight;
  vis.forEach((el) => {
    const r = el.getBoundingClientRect(), k = +el.dataset.par! || 0.1, rot = +(el.dataset.rot || 0);
    const p = ((r.top + r.height / 2) / h - 0.5) * 2;           // -1 (top) … 1 (bottom)
    el.style.transform = `translateY(${(-p * k * r.height).toFixed(1)}px) rotate(${(p * rot).toFixed(2)}deg) scale(${(1 + Math.abs(p) * -0.03).toFixed(3)})`;
  });
};
if (!reduced && els.length) { const req = () => { if (!raf) raf = requestAnimationFrame(tick); }; addEventListener('scroll', req, { passive: true }); req(); }
</script>
