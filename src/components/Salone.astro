---
// Kit 08: deep petrol with the coral texture (tone on tone). Desktop pins and pans horizontally through
// salon photos in pattern frames (arch, wide pill, circle, tall, blob) with a dashed brass line;
// tablet and phone use native swipe with snap.
import Img from './Img.astro';
import { img } from '../data/img';
import { business } from '../data/business';
const cards: [shape: string, src: string, alt: string, cap: string, pos?: string][] = [
  ['arch', 'salone/salone-12-facciata', "La facciata del salone Glamood con l'insegna", 'si entra da qui'],
  ['wide', 'salone/salone-05', 'Le postazioni con specchi in legno e poltrone nere e oro', 'le postazioni'],
  ['circle', 'salone/salone-01', 'Una poltrona da barbiere nera con dettagli in ottone', 'la poltrona'],
  ['tall', 'salone/salone-03', 'Specchio con cornice in rovere e luce led', 'luce giusta'],
  ['blob', 'salone/salone-04', 'Vista del salone con piante e lampade a sospensione', 'ogni dettaglio pensato'],
  ['arch', 'salone/salone-11-titolare', 'Fabio al lavoro nel salone', 'Fabio al lavoro', '72% 50%'],
];
---
<div class="sx-salone">
<section class="salone" id="salone" aria-labelledby="salone-t"><div class="bgref r-corallo-tono"></div>
  <img class="hang" {...img('piante/13_pothos_variegato')} alt="" loading="lazy" style="width:clamp(90px,9vw,160px);right:1.5%" />
  <div class="head"><p class="kicker" style="color:#cfe3e1">{business.address}</p><h2 class="giant-title" id="salone-t">Il salone</h2><p>Pareti petrolio, rovere, ottone e poltrone vintage: un posto che si fa guardare.</p></div>
  <div class="track-wrap" id="tw"><div class="track" id="track" tabindex="0" aria-label="Foto del salone, scorri in orizzontale">
    {cards.map(([shape, src, alt, cap, pos]) => (
      <figure class={`card ${shape}`}><div class="fr"><div class="ph"><Img src={src} alt={alt} sizes="(min-width:1200px) 40vw, 82vw" style={pos ? `object-position:${pos}` : undefined} /></div></div><figcaption>{cap}</figcaption></figure>
    ))}
  </div>
  <svg class="line" id="ln" aria-hidden="true"><path id="lp" /></svg></div>
  <p class="credit">{business.architect ? `Progetto degli interni: ${business.architect}.` : "Progetto degli interni: nome dell'architetto da confermare."}</p>
  <div class="bottom-edge"></div>
</section>
</div>

<style is:global>
.sx-salone{display:contents;
.salone{position:relative;background:var(--petrol-darker);color:var(--cream);overflow:hidden;isolation:isolate}
.salone .bgref{z-index:-1}
.salone::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgb(10 74 80 / .35),rgb(10 74 80 / .1) 40%,rgb(10 74 80 / .55))}
.head{position:relative;z-index:2;padding:clamp(70px,10vw,130px) var(--gutter) 10px}
.head .giant-title{font-size:clamp(64px,15vw,260px);color:var(--cream);text-shadow:0 .05em 0 #08393E}
.head p{max-width:34ch;color:#d6e8e6;margin-top:14px}
.track-wrap{position:relative;z-index:2}
.track{display:flex;gap:clamp(24px,3.4vw,64px);align-items:center;padding:30px var(--gutter) clamp(70px,9vw,120px)}
.card{position:relative;flex:none;margin:0;display:flex;flex-direction:column;align-items:center;gap:14px}
.card .fr{padding:clamp(12px,1.1vw,18px);background:#12757E url("/img/pattern/ref/agrumi.webp") center/240px;box-shadow:0 0 0 5px #F4EFE8,0 30px 60px -28px rgb(0 0 0 / .7);animation:pan 30s linear infinite;--pan-x:240px;--pan-y:-240px}
.card:nth-child(even) .fr{background-image:url("/img/pattern/ref/onde-strati.webp");background-size:200px;--pan-x:200px;--pan-y:-443px}
.card .ph{overflow:hidden;background:#082f33;box-shadow:0 0 0 4px #F4EFE8}
.card .ph img{width:100%;height:100%;object-fit:cover;transform:scale(1.12);will-change:transform}
.card figcaption{position:static!important;font:800 clamp(12px,.95vw,14px)/1 var(--f-display)!important;letter-spacing:.12em;text-transform:uppercase;color:var(--petrol);background:var(--cream);padding:9px 14px;border-radius:999px;white-space:nowrap;box-shadow:0 8px 16px -10px rgb(0 0 0 / .5)}
.arch .ph{width:clamp(240px,26vw,420px);aspect-ratio:3/4.3}.arch .fr,.arch .ph{border-radius:999px 999px 24px 24px}
.blob .ph{width:clamp(280px,34vw,560px);aspect-ratio:4/3}.blob .fr,.blob .ph{border-radius:46% 54% 40% 60% / 55% 40% 60% 45%}
.circle .ph{width:clamp(220px,22vw,360px);aspect-ratio:1}.circle .fr,.circle .ph{border-radius:50%}
.tall .ph{width:clamp(220px,22vw,340px);aspect-ratio:3/4.6}.tall .fr{border-radius:30px}.tall .ph{border-radius:20px}
.wide .ph{width:clamp(300px,40vw,640px);aspect-ratio:16/10}.wide .fr,.wide .ph{border-radius:999px}
.credit{position:relative;z-index:2;padding:0 var(--gutter) 40px;font-size:14px;color:#cfe3e1}
.line{position:absolute;z-index:1;left:0;top:0;width:100%;height:100%;pointer-events:none}
.line path{fill:none;stroke:var(--brass);stroke-width:2;stroke-dasharray:6 8;opacity:.8}
.hang{position:absolute;z-index:3;pointer-events:none;top:-10px;height:auto}
@media (max-width:1199px){.hang{display:none}}
.bottom-edge{position:relative;z-index:2;height:clamp(46px,6vw,90px);background:url("/img/svg/onde-bande-striscia.svg") center/cover}
@media (min-width:1200px){
 .salone{height:100svh;display:flex;flex-direction:column}
 .head{padding:clamp(40px,6vh,80px) var(--gutter) 0;display:flex;align-items:flex-end;gap:40px}
 .head .giant-title{font-size:clamp(70px,11vh,170px)}
 .head p{margin:0 0 .6em}
 .track-wrap{flex:1;min-height:0;display:flex;align-items:center}
 .track{padding-top:40px;padding-bottom:40px}
 .arch .ph{width:auto;height:min(46svh,500px)}.tall .ph{width:auto;height:min(44svh,480px)}
 .blob .ph{width:auto;height:min(40svh,420px)}.circle .ph{width:auto;height:min(36svh,360px)}.wide .ph{width:auto;height:min(34svh,380px)}
 .credit{padding-bottom:16px}
}
@media (max-width:1199px){
 .track{overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:60px}
 .track::-webkit-scrollbar{display:none}
 .card{scroll-snap-align:center}
 .line{display:none}
 .card .ph img{transform:scale(1.04)}
 .arch .ph,.tall .ph{width:min(68vw,340px)}.blob .ph,.wide .ph{width:min(82vw,520px)}.circle .ph{width:min(64vw,320px)}
}
@media (min-width:1200px) and (prefers-reduced-motion:reduce){
 .salone{height:auto}.track{overflow-x:auto;scroll-snap-type:x mandatory}.line{display:none}
}
}
</style>

<script>
import { gsap } from '../scripts/motion.js';
const track = document.getElementById('track')!, tw = document.getElementById('tw')!, ln = document.getElementById('ln')!, lp = document.getElementById('lp')!;
const mm = gsap.matchMedia();
mm.add('(min-width:1200px) and (prefers-reduced-motion:no-preference)', () => {
  const dist = () => track.scrollWidth - innerWidth;
  const tween = gsap.to(track, { x: () => -dist(), ease: 'none', scrollTrigger: { trigger: '#salone', start: 'top top', end: () => '+=' + dist(), pin: true, scrub: 1, invalidateOnRefresh: true } });
  track.querySelectorAll<HTMLElement>('.card .ph img').forEach((im) => gsap.fromTo(im, { xPercent: -6 }, { xPercent: 6, ease: 'none', scrollTrigger: { trigger: im.closest('.card')!, containerAnimation: tween, start: 'left right', end: 'right left', scrub: true } }));
  const draw = () => {
    const r = tw.getBoundingClientRect(); const x0 = +gsap.getProperty(track, 'x');
    const pts = [...track.querySelectorAll('.ph')].map((p) => { const b = p.getBoundingClientRect(); return [b.left - r.left + b.width / 2 - x0, b.top - r.top + b.height / 2]; });
    ln.setAttribute('width', String(track.scrollWidth)); ln.style.width = track.scrollWidth + 'px';
    lp.setAttribute('d', pts.map((p, i) => (i ? `S ${p[0] - 80} ${p[1] + (i % 2 ? 90 : -90)} ${p[0]} ${p[1]}` : `M ${p[0]} ${p[1]}`)).join(' '));
  };
  draw(); addEventListener('resize', draw);
  tween.eventCallback('onUpdate', () => gsap.set(ln, { x: gsap.getProperty(track, 'x') }));
  return () => { removeEventListener('resize', draw); gsap.set(track, { clearProps: 'all' }); };
});
mm.add('(prefers-reduced-motion:no-preference)', () => {
  gsap.from('#salone .head .giant-title', { scrollTrigger: { trigger: '#salone', start: 'top 80%' }, yPercent: 40, opacity: 0, duration: 1.2, ease: 'expo.out' });
});
</script>
